@page "/mines"
@page "/mines/new"
@layout DashboardLayout
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using OMM.Public.Data
@using OMM.Public.Services
@inject DatabaseMineService MineService
@inject NavigationManager Navigation
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IMinerProfileService ProfileService

<PageTitle>My Mines - OhMyMine</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 animate-fade-up">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">My Mines</h1>
        <p class="text-muted small mb-0">
            @FilteredMines.Count mines · @TotalFilteredValueDisplay total value
        </p>
    </div>
    <button class="btn btn-primary align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="OpenAddModal">
        <i class="ti ti-plus fs-5"></i>
        <span>Add Mine</span>
    </button>
</div>

<!-- Search & Category Filters -->
<div class="d-flex flex-column flex-md-row gap-3 mb-2 animate-fade-up">
    <div class="position-relative flex-grow-1 mines-search-container">
        <i class="ti ti-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
        <input type="text"
               class="form-control ps-5 bg-white border-light-subtle rounded-3 py-2 shadow-xs"
               placeholder="Search mines, types..."
               @bind="searchQuery"
               @bind:event="oninput" />
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <button class="btn btn-sm btn-link position-absolute top-50 end-0 translate-middle-y me-2 text-muted p-0 text-decoration-none"
                    @onclick="() => searchQuery = string.Empty">
                <i class="ti ti-x"></i>
            </button>
        }
    </div>


</div>
<div class="d-flex flex-column flex-md-row gap-3 mb-2">
    <!-- Category Pill Filters -->
    <div class="d-flex flex-wrap gap-1 align-items-center">
        <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(selectedCategory == null ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
                @onclick="() => selectedCategory = null">
            All
        </button>
        @foreach (var cat in Enum.GetValues<MineCategory>())
        {
            var isSelected = selectedCategory == cat;
            <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(isSelected ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
                    @onclick="() => selectedCategory = cat">
                @FormatHelper.CategoryLabel(cat)
            </button>
        }
    </div>
</div>
<!-- Mines Grid -->
@if (FilteredMines.Count > 0)
{
    <div class="row g-3">
        @foreach (var mine in FilteredMines)
        {
            var growthPositive = mine.Growth >= 0;
            <div class="col-12 col-md-6 col-xl-4 position-relative">

                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer"
                     @onclick="() => NavigateToDetail(mine.Id)">

                    <!-- Header: Icon, Name & Category (wraps, no truncation, full width) -->
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="rounded-3 bg-dark-subtle text-dark d-flex align-items-center justify-content-center p-2 flex-shrink-0 mine-category-icon">
                            <i class="ti @FormatHelper.CategoryToIcon(mine.Category) fs-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="h6 fw-bold mb-0 text-dark font-display mine-name">
                                @mine.Name
                            </h3>
                            <small class="text-muted d-block mine-meta">
                                @FormatHelper.CategoryLabel(mine.Category) · @FormatHelper.MineTypeLabel(mine.Type)
                            </small>
                        </div>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="row g-2 pt-2 border-top border-light-subtle text-center text-sm-start">
                        <div class="col-4 min-w-0">
                            <span class="text-uppercase text-muted fw-semibold d-block mine-metric-label">Current</span>
                            <div class="fw-bold text-dark mine-metric-value" title="@FormatHelper.FormatCurrency(mine.CurrentValue, mine.Currency)">
                                @FormatHelper.FormatCurrencyCompact(mine.CurrentValue, mine.Currency)
                            </div>
                        </div>
                        <div class="col-4 min-w-0">
                            <span class="text-uppercase text-muted fw-semibold d-block mine-metric-label">Growth</span>
                            <div class="fw-bold d-flex align-items-center justify-content-center justify-content-sm-start gap-1 mine-growth @(growthPositive ? "text-success" : "text-danger")">
                                <i class="ti @(growthPositive ? "ti-trending-up" : "ti-trending-down") mine-growth-icon"></i>
                                <span>@FormatHelper.FormatPercent(mine.GrowthPct)</span>
                            </div>
                        </div>
                        <div class="col-4 min-w-0">
                            <span class="text-uppercase text-muted fw-semibold d-block mine-metric-label">Income/mo</span>
                            <div class="fw-bold text-dark mine-metric-value" title="@(mine.MonthlyIncome > 0 ? FormatHelper.FormatCurrency(mine.MonthlyIncome, mine.Currency) : "—")">
                                @(mine.MonthlyIncome > 0 ? FormatHelper.FormatCurrencyCompact(mine.MonthlyIncome, mine.Currency) : "—")
                            </div>
                        </div>
                    </div>

                    <!-- Sub-mines Footer if any -->
                    @if (mine.SubMines != null && mine.SubMines.Count > 0)
                    {
                        <div class="mt-3 pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted small">
                            <span class="d-inline-flex align-items-center gap-1">
                                <i class="ti ti-layers-intersect fs-6"></i>
                                @mine.SubMines.Count sub-placements
                            </span>
                            <i class="ti ti-chevron-right fs-6"></i>
                        </div>
                    }
                </div>

                <!-- Status Badge — overlaid on top right corner, inside card -->
                <div class="position-absolute top-0 end-0 mine-status-overlay">
                    <StatusBadge Status="@mine.Status" Compact="true" />
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 my-4">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3 mine-empty-icon">
            <i class="ti ti-pick fs-2 text-muted"></i>
        </div>
        <h3 class="h5 fw-bold text-dark mb-1">No mines found</h3>
        <p class="text-muted small mb-3">No mines match your filter criteria or search query.</p>
        <div>
            <button class="btn btn-outline-dark btn-sm rounded-3 px-3" @onclick="ResetFilters">Clear Filters</button>
        </div>
    </div>
}

<!-- Add Mine Modal -->
@if (showAddModal)
{
    <div class="modal fade show d-block mine-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="add-mine-title">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-pick text-gold fs-4"></i>
                        <h2 id="add-mine-title" class="h5 modal-title fw-bold font-display mb-0">Add New Mine</h2>
                    </div>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseAddModal"></button>
                </div>

                <div class="modal-body p-4 bg-light">
                    @if (!string.IsNullOrEmpty(inputError))
                    {
                        <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="ti ti-alert-triangle"></i>
                            <small>@inputError</small>
                        </div>
                    }

                    <!-- 1. Mine details -->
                    <div class="card border-0 rounded-4">
                        <div class="card-header bg-dark">
                            <div class="dc-section-title text-gold"><i class="ti ti-blocks text-gold"></i> Mine Details</div>
                        </div>
                        <div class="card-body">
                            <div class="omm-form-section">
                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="mine-name">Mine Name <span class="text-danger">*</span></label>
                                    <input id="mine-name" type="text" class="form-control rounded-3" maxlength="200"
                                           placeholder="e.g. EPF / KWSP, Maybank Shares" @bind="newMine.Name" />
                                </div>

                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="mine-institution">Institution / Issuer</label>
                                    <select id="mine-institution" class="form-select rounded-3" @bind="newMine.Institution">
                                        <option value="">Select an institution</option>
                                        @foreach (var institution in institutions)
                                        {
                                            <option value="@institution.InstitutionName_EN">@institution.InstitutionCode - @institution.InstitutionName_EN</option>
                                        }
                                    </select>
                                </div>

                                <div class="omm-form-grid">
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="mine-category">Category <span class="text-danger">*</span></label>
                                        <select id="mine-category" class="form-select rounded-3" @bind="newMine.Category">
                                            @foreach (var cat in Enum.GetValues<MineCategory>())
                                            {
                                                <option value="@cat">@FormatHelper.CategoryLabel(cat)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="mine-type">Asset Type <span class="text-danger">*</span></label>
                                        <select id="mine-type" class="form-select rounded-3" @bind="newMine.Type">
                                            @foreach (var typ in Enum.GetValues<MineType>())
                                            {
                                                <option value="@typ">@FormatHelper.MineTypeLabel(typ)</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Value & income -->
                    <div class="card border-0 rounded-4 mt-3">
                        <div class="card-header bg-dark">
                            <div class="dc-section-title text-gold"><i class="ti ti-pig-money text-gold"></i> Value &amp; Income</div>
                        </div>
                        <div class="card-body">
                            <div class="omm-form-section">
                                <div class="omm-form-grid">
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="mine-current-value">Current Market Value <span class="text-danger">*</span></label>
                                        <div class="dc-currency-group">
                                            <span class="dc-currency-addon">@currencySymbol</span>
                                            <input id="mine-current-value" type="number" class="form-control" min="0" step="0.01"
                                                   placeholder="0.00" @bind="newMine.CurrentValue" @bind:event="oninput" />
                                        </div>
                                    </div>
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="mine-purchase-cost">Purchase Price</label>
                                        <div class="dc-currency-group">
                                            <span class="dc-currency-addon">@currencySymbol</span>
                                            <input id="mine-purchase-cost" type="number" class="form-control" min="0" step="0.01"
                                                   placeholder="0.00" @bind="newMine.PurchaseCost" @bind:event="oninput" />
                                        </div>
                                    </div>
                                </div>

                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="mine-monthly-income">Est. Monthly Passive Income</label>
                                    <div class="dc-currency-group">
                                        <span class="dc-currency-addon">@currencySymbol</span>
                                        <input id="mine-monthly-income" type="number" class="form-control" min="0" step="0.01"
                                               placeholder="0.00" @bind="newMine.MonthlyIncome" @bind:event="oninput" />
                                        <span class="dc-currency-suffix">/ mo</span>
                                    </div>
                                    <div class="omm-form-help">Dividends, rent, or interest this mine produces. Counts toward your Freedom Ratio.</div>
                                </div>

                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="mine-holdings">Holdings / Details</label>
                                    <input id="mine-holdings" type="text" class="form-control rounded-3" maxlength="200"
                                           placeholder="e.g. 1,000 shares, 50 grams" @bind="newMine.Holdings" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn-omm-secondary" @onclick="CloseAddModal">Cancel</button>
                    <button type="button" class="btn-omm-accent" @onclick="SaveMine">
                        <i class="ti ti-device-floppy"></i> Save Mine
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Mine> allMines = [];
    private List<OMM.Shared.Models.MasterData.Institution> institutions = [];
    private string searchQuery = string.Empty;
    private MineCategory? selectedCategory;
    private bool showAddModal = false;
    private Mine newMine = new();
    private string? inputError;
    private string currencySymbol = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetCurrentAsync();
        if (!string.IsNullOrWhiteSpace(profile?.CurrencyCode))
        {
            currencySymbol = FormatHelper.GetCurrencySymbol(profile.CurrencyCode);
        }

        await LoadInstitutions();
        await LoadMines();
        if (Navigation.Uri.TrimEnd('/').EndsWith("/mines/new", StringComparison.OrdinalIgnoreCase))
        {
            OpenAddModal();
        }
    }

    private async Task LoadInstitutions()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        institutions = await db.Institutions
            .AsNoTracking()
            .Where(i => i.IsActive)
            .OrderBy(i => i.InstitutionName_EN)
            .ToListAsync();
    }

    private async Task LoadMines()
    {
        allMines = await MineService.GetMinesAsync();
    }

    private List<Mine> FilteredMines => allMines
        .Where(m => selectedCategory == null || m.Category == selectedCategory.Value)
        .Where(m => string.IsNullOrWhiteSpace(searchQuery) ||
                    m.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (m.Institution != null && m.Institution.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    FormatHelper.MineTypeLabel(m.Type).Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string TotalFilteredValueDisplay
    {
        get
        {
            var currencies = FilteredMines
                .Select(mine => mine.Currency)
                .Where(currency => !string.IsNullOrWhiteSpace(currency))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            return currencies.Count == 1
                ? FormatHelper.FormatCurrency(FilteredMines.Sum(mine => mine.CurrentValue), currencies[0])
                : currencies.Count == 0 ? "—" : "Multiple currencies";
        }
    }

    private void NavigateToDetail(string mineId)
    {
        Navigation.NavigateTo($"/mines/{mineId}");
    }

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedCategory = null;
    }

    private void OpenAddModal()
    {
        inputError = null;
        newMine = new Mine
        {
            Category = MineCategory.Investments,
            Type = MineType.Stocks,
            Currency = string.Empty,
            Status = "active"
        };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        inputError = null;
        showAddModal = false;
    }

    private async Task SaveMine()
    {
        inputError = PublicInputValidator.GetDisplayTextError("Mine name", newMine.Name)
            ?? PublicInputValidator.GetDisplayTextError("Holdings / details", newMine.Holdings, optional: true);
        if (inputError is not null)
            return;

        if (newMine.PurchaseCost > 0)
        {
            newMine.Growth = newMine.CurrentValue - newMine.PurchaseCost;
            newMine.GrowthPct = Math.Round((newMine.Growth / newMine.PurchaseCost) * 100m, 1);
        }
        else
        {
            newMine.PurchaseCost = newMine.CurrentValue;
            newMine.Growth = 0;
            newMine.GrowthPct = 0;
        }

        // Validate numeric inputs
        if (newMine.CurrentValue <= 0)
        {
            inputError = "Enter a current market value greater than zero.";
            return;
        }
        if (newMine.PurchaseCost < 0 || newMine.MonthlyIncome < 0)
        {
            inputError = "Purchase price and monthly income cannot be negative.";
            return;
        }

        try
        {
            await MineService.AddMineAsync(newMine);
            showAddModal = false;
            await LoadMines();
        }
        catch (ArgumentException exception)
        {
            inputError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            inputError = exception.Message;
        }



    }
}
