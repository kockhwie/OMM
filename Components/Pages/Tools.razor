@page "/tools"
@layout DashboardLayout
@inject IMineService MineService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Financial Tools &amp; Calculators - OhMyMine</PageTitle>

@if (activeTool == null)
{
    <div class="mb-4 animate-fade-up">
        <h1 class="h3 fw-bold text-dark font-display mb-1">Financial Tools &amp; Simulators</h1>
        <p class="text-muted small mb-0">Practical calculators calibrated for Malaysian financial instruments and mining strategy</p>
    </div>

    <!-- Tools Catalog Grid -->
    <div class="row g-4">
        <!-- 1. Fixed Deposit & Cash Yield Calculator -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white"
                 @onclick='() => activeTool = "fd"'>
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 bg-dark text-warning p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="ti ti-calculator fs-4"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Planning</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">Fixed Deposit &amp; Cash Yield</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    Calculate maturity value, compounded returns, and monthly passive equivalent for MYR fixed deposits and digital cash placements.
                </p>
                <div class="d-flex align-items-center gap-1 fw-semibold text-primary small pt-2 border-top border-light-subtle">
                    <span>Open Calculator</span>
                    <i class="ti ti-arrow-right fs-6"></i>
                </div>
            </div>
        </div>

        <!-- 2. Freedom Ratio Simulator -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white"
                 @onclick='() => activeTool = "freedom"'>
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="ti ti-bolt fs-4"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Income</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">Freedom Ratio Simulator</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    Simulate how increasing monthly mine contributions accelerates your journey to 100% passive expense coverage.
                </p>
                <div class="d-flex align-items-center gap-1 fw-semibold text-success small pt-2 border-top border-light-subtle">
                    <span>Simulate Freedom</span>
                    <i class="ti ti-arrow-right fs-6"></i>
                </div>
            </div>
        </div>

        <!-- 3. Emergency Fund Safety Planner -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white"
                 @onclick='() => activeTool = "emergency"'>
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="ti ti-shield-check fs-4"></i>
                    </div>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Safety</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">Emergency Fund Safety Gauge</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    Benchmark your liquid buffer (3 to 12 months) against actual recurring liabilities and net debt service obligations.
                </p>
                <div class="d-flex align-items-center gap-1 fw-semibold text-warning small pt-2 border-top border-light-subtle">
                    <span>Check Safety Buffer</span>
                    <i class="ti ti-arrow-right fs-6"></i>
                </div>
            </div>
        </div>

        <!-- 4. Debt Payoff & Mortgage Accelerator -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white"
                 @onclick='() => activeTool = "debt"'>
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="ti ti-trending-down fs-4"></i>
                    </div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Burden</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">Debt Payoff Accelerator</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    See how lump-sum or extra monthly principal repayments reduce overall interest charges and years off your mortgage.
                </p>
                <div class="d-flex align-items-center gap-1 fw-semibold text-danger small pt-2 border-top border-light-subtle">
                    <span>Model Payoff</span>
                    <i class="ti ti-arrow-right fs-6"></i>
                </div>
            </div>
        </div>

        <!-- 5. Compound Growth Mine Simulator -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white"
                 @onclick='() => activeTool = "compound"'>
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="ti ti-chart-line fs-4"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Growth</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">Compound Growth Simulator</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    Project long-term wealth accumulation for EPF, unit trusts, and equity portfolios with dividend reinvestment.
                </p>
                <div class="d-flex align-items-center gap-1 fw-semibold text-primary small pt-2 border-top border-light-subtle">
                    <span>Simulate Growth</span>
                    <i class="ti ti-arrow-right fs-6"></i>
                </div>
            </div>
        </div>

        <!-- 6. Stock & Share Dividend Calculator -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white"
                 @onclick='() => activeTool = "dividend"'>
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #ede9fe; color: #7c3aed;">
                        <i class="ti ti-chart-bar fs-4"></i>
                    </div>
                    <span class="badge" style="background: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe;">Dividend</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">Stock &amp; Share Dividend Calculator</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    Instantly calculate dividend income with fixed or variable payouts, then model DRIP and long-term portfolio growth.
                </p>
                <div class="d-flex align-items-center gap-1 fw-semibold small pt-2 border-top border-light-subtle" style="color: #7c3aed;">
                    <span>Calculate Dividends</span>
                    <i class="ti ti-arrow-right fs-6"></i>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Back to Tools Header -->
    <div class="mb-3 animate-fade-up">
        <button class="btn btn-link text-muted p-0 small text-decoration-none d-inline-flex align-items-center gap-1"
                @onclick="HandleBackToTools">
            <i class="ti ti-arrow-left"></i>
            <span>Back to all tools</span>
        </button>
    </div>

    @if (activeTool == "fd")
    {
        <!-- Fixed Deposit Calculator -->
        <div class="mb-4 animate-fade-up">
            <h1 class="h3 fw-bold text-dark font-display mb-1">Fixed Deposit &amp; Cash Yield Calculator</h1>
            <p class="text-muted small mb-0">Estimate total maturity proceeds and annualized cashflow</p>
        </div>

        <div class="row g-4 animate-fade-up">
            <!-- Inputs -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h6 fw-bold text-dark font-display mb-4">Placement Parameters</h3>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Principal Amount</label>
                        <div class="dc-currency-group">
                            <span class="dc-currency-addon">@dcCurrencySymbol</span>
                            <input type="number" class="form-control" step="1000" @bind="fdPrincipal" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Interest Rate (% p.a.)</label>
                        <div class="dc-currency-group">
                            <input type="number" class="form-control" step="0.05" @bind="fdRate" @bind:event="oninput" />
                            <span class="dc-currency-suffix">%</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold text-dark mb-0">Tenure: <span class="text-primary fw-bold">@fdTenureMonths months</span></label>
                            <span class="text-muted small">(@(fdTenureMonths >= 12 ? $"{fdTenureMonths / 12} yr {(fdTenureMonths % 12 > 0 ? $"{fdTenureMonths % 12} mo" : "")}" : $"{fdTenureMonths} mo"))</span>
                        </div>
                        <input type="range" class="form-range" min="1" max="60" @bind="fdTenureMonths" @bind:event="oninput" />
                        <div class="d-flex justify-content-between small text-muted">
                            <span>1 mo</span>
                            <span>12 mo (1 yr)</span>
                            <span>36 mo (3 yr)</span>
                            <span>60 mo (5 yr)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h6 fw-bold text-dark font-display mb-4">Maturity Yield Breakdown</h3>

                    <div class="p-4 rounded-4 bg-dark text-white text-center mb-3">
                        <span class="text-uppercase text-white-50 fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Maturity Proceeds</span>
                        <div class="fs-2 fw-bold text-warning font-display my-1">
                            @FormatHelper.FormatCurrency(FdMaturityValue, userCurrency)
                        </div>
                        <small class="text-white-50">Principal + Total Interest Earned</small>
                    </div>

                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                            <span class="text-muted">Initial Principal</span>
                            <span class="fw-semibold text-dark">@FormatHelper.FormatCurrency(fdPrincipal, userCurrency)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                            <span class="text-muted">Total Interest Profit</span>
                            <span class="fw-bold text-success">@FormatHelper.FormatCurrency(FdTotalInterest, userCurrency)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                            <span class="text-muted">Effective Monthly Passive Equivalent</span>
                            <span class="fw-bold text-dark">@FormatHelper.FormatCurrency(FdMonthlyEquivalent, userCurrency) / month</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">Effective Annualized Return</span>
                            <span class="fw-semibold text-dark">@fdRate.ToString("F2")% p.a.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTool == "freedom")
    {
        <!-- Freedom Ratio Simulator -->
        <div class="mb-4 animate-fade-up">
            <h1 class="h3 fw-bold text-dark font-display mb-1">Freedom Ratio Simulator</h1>
            <p class="text-muted small mb-0">Model your passive income coverage and time to financial freedom</p>
        </div>

        <div class="row g-4 animate-fade-up">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h6 fw-bold text-dark font-display mb-4">Cashflow Assumptions</h3>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Monthly Recurring Living Expenses</label>
                        <div class="dc-currency-group">
                            <span class="dc-currency-addon">@dcCurrencySymbol</span>
                            <input type="number" class="form-control" step="250" @bind="simExpenses" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Current Monthly Passive Income</label>
                        <div class="dc-currency-group">
                            <span class="dc-currency-addon">@dcCurrencySymbol</span>
                            <input type="number" class="form-control" step="100" @bind="simPassive" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Monthly Savings Invested into Mines</label>
                        <div class="dc-currency-group">
                            <span class="dc-currency-addon">@dcCurrencySymbol</span>
                            <input type="number" class="form-control" step="250" @bind="simMonthlySaving" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Assumed Average Mine Yield (% p.a.)</label>
                        <div class="dc-currency-group">
                            <input type="number" class="form-control" step="0.5" @bind="simYield" @bind:event="oninput" />
                            <span class="dc-currency-suffix">%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h6 fw-bold text-dark font-display mb-4">Projected Milestones</h3>

                    @{
                        var currentRatio = simExpenses > 0 ? (simPassive / simExpenses) * 100m : 0;
                        var targetPassiveNeeded = simExpenses - simPassive;
                        var additionalCapitalNeeded = simYield > 0 && targetPassiveNeeded > 0 ? (targetPassiveNeeded * 12m) / (simYield / 100m) : 0;
                        var monthsToFreedom = simMonthlySaving > 0 && additionalCapitalNeeded > 0 ? (int)Math.Ceiling(additionalCapitalNeeded / simMonthlySaving) : 0;
                    }

                    <div class="p-4 rounded-4 bg-success-subtle border border-success-subtle text-center mb-3">
                        <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem;">Current Freedom Score</span>
                        <div class="fs-1 fw-bold text-success font-display my-1">
                            @Math.Round(currentRatio, 1)%
                        </div>
                        <ProgressBar Percentage="@currentRatio" Variant="mine" Height="10px" />
                    </div>

                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                            <span class="text-muted">Passive Gap to 100% Freedom</span>
                            <span class="fw-bold text-danger">@(targetPassiveNeeded > 0 ? FormatHelper.FormatCurrency(targetPassiveNeeded, userCurrency) : $"{dcCurrencySymbol}0") / mo</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                            <span class="text-muted">Capital Required at @simYield% yield</span>
                            <span class="fw-bold text-dark">@FormatHelper.FormatCurrency(additionalCapitalNeeded, userCurrency)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">Estimated Time to 100% Freedom</span>
                            <span class="fw-bold text-dark">
                                @(monthsToFreedom > 0 ? $"{monthsToFreedom / 12} years {monthsToFreedom % 12} months" : "Achieved / Instant")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTool == "emergency")
    {
        <!-- Emergency Fund Planner -->
        <div class="mb-4 animate-fade-up">
            <h1 class="h3 fw-bold text-dark font-display mb-1">Emergency Fund Safety Gauge</h1>
            <p class="text-muted small mb-0">Assess your financial runway and liquidity reserves</p>
        </div>

        <div class="row g-4 animate-fade-up">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h6 fw-bold text-dark font-display mb-4">Living Outflows</h3>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Monthly Essential Living Expenses</label>
                        <div class="dc-currency-group">
                            <span class="dc-currency-addon">@dcCurrencySymbol</span>
                            <input type="number" class="form-control" step="200" @bind="efMonthlyExpense" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Current Liquid Cash &amp; Deposits</label>
                        <div class="dc-currency-group">
                            <span class="dc-currency-addon">@dcCurrencySymbol</span>
                            <input type="number" class="form-control" step="1000" @bind="efCurrentCash" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Target Runway Coverage</label>
                        <select class="form-select rounded-3" @bind="efTargetMonths">
                            <option value="3">3 Months (Standard Employee)</option>
                            <option value="6">6 Months (Recommended Balanced Buffer)</option>
                            <option value="9">9 Months (Single Income / Family)</option>
                            <option value="12">12 Months (Business Owner / Freelancer)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h6 fw-bold text-dark font-display mb-4">Runway Status</h3>

                    @{
                        var efTargetFund = efMonthlyExpense * efTargetMonths;
                        var efMonthsCurrent = efMonthlyExpense > 0 ? Math.Round(efCurrentCash / efMonthlyExpense, 1) : 0;
                        var efProgress = efTargetFund > 0 ? (int)Math.Clamp((efCurrentCash / efTargetFund) * 100m, 0, 100) : 0;
                        var efShortfall = efTargetFund - efCurrentCash;
                    }

                    <div class="p-4 rounded-4 bg-light border border-light-subtle text-center mb-3">
                        <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem;">Current Runway</span>
                        <div class="fs-1 fw-bold text-dark font-display my-1">
                            @efMonthsCurrent Months
                        </div>
                        <ProgressBar Percentage="@efProgress" Variant="gold" Height="8px" />
                        <small class="text-muted mt-2 d-block">Target: @efTargetMonths Months (@FormatHelper.FormatCurrency(efTargetFund, userCurrency))</small>
                    </div>

                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between py-2 border-bottom border-light-subtle">
                            <span class="text-muted">Target Buffer Amount</span>
                            <span class="fw-semibold text-dark">@FormatHelper.FormatCurrency(efTargetFund, userCurrency)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">Buffer Shortfall</span>
                            <span class="fw-bold @(efShortfall > 0 ? "text-danger" : "text-success")">
                                @(efShortfall > 0 ? FormatHelper.FormatCurrency(efShortfall, userCurrency) : "Buffer fully funded! 🎉")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTool == "dividend")
    {
        <!-- ═══════════════════════════════════════════════════════════════════
             STOCK & SHARE DIVIDEND CALCULATOR
        ════════════════════════════════════════════════════════════════════ -->
        <div class="mb-4 animate-fade-up">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-2">
                <div>
                    <h1 class="h3 fw-bold font-display mb-1" style="color: var(--omm-ink-900);">Stock &amp; Share Dividend Calculator</h1>
                    <p class="text-muted small mb-0">Professional financial calculation engine. Configured to your active currency (@userCurrency).</p>
                </div>
                @if (savedNotification)
                {
                    <div class="alert alert-success py-2 px-3 mb-0 d-flex align-items-center gap-2 small rounded-3 animate-fade-up">
                        <i class="ti ti-check fs-5"></i>
                        <span>Stock successfully added to your <strong>Mines</strong> portfolio!</span>
                    </div>
                }
            </div>

            <!-- Mode Switcher -->
            <div class="dc-mode-switcher mt-3">
                <button id="btn-mode-quick" class="dc-mode-btn @(dcMode == "quick" ? "active" : "")"
                        @onclick='() => SwitchMode("quick")'>
                    <i class="ti ti-zap me-1"></i> Quick Calculate
                </button>
                <button id="btn-mode-simulator" class="dc-mode-btn @(dcMode == "simulator" ? "active" : "")"
                        @onclick='() => SwitchMode("simulator")'>
                    <i class="ti ti-chart-dots me-1"></i> Investment Simulator
                </button>
            </div>
            <p class="text-muted mt-2 mb-0" style="font-size: 0.78rem;">
                @if (dcMode == "quick")
                {
                    <span>Quick dividend, yield and income calculations with fixed or variable quarterly/monthly payouts.</span>
                }
                else
                {
                    <span>Model dividend growth, DRIP reinvestment, recurring investments and long-term multi-year scenarios.</span>
                }
            </p>
        </div>

        @if (dcMode == "quick")
        {
            <!-- ──────────────────────────────────────────────────────────────
                 QUICK CALCULATE MODE
            ─────────────────────────────────────────────────────────────── -->
            <div class="row g-4 dc-animate">
                <!-- LEFT: Inputs Form -->
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column gap-3">
                        
                        <!-- 1. Stock / Asset Identifier -->
                        <div class="row g-2">
                            <div class="col-5">
                                <label class="form-label small fw-semibold text-muted mb-1" for="qc-symbol">
                                    Stock Code <span class="dc-subtle-optional">(Optional)</span>
                                </label>
                                <input id="qc-symbol" type="text" class="form-control rounded-3"
                                       placeholder="e.g. 1155.KL"
                                       @bind="qcStockSymbol" @bind:event="oninput" />
                            </div>
                            <div class="col-7">
                                <label class="form-label small fw-semibold text-muted mb-1" for="qc-name">
                                    Company Name <span class="dc-subtle-optional">(Optional)</span>
                                </label>
                                <input id="qc-name" type="text" class="form-control rounded-3"
                                       placeholder="e.g. Maybank"
                                       @bind="qcStockName" @bind:event="oninput" />
                            </div>
                        </div>

                        <!-- 2. Core Shareholding Inputs -->
                        <div class="pt-2 border-top border-light-subtle">
                            <h3 class="h6 fw-bold font-display mb-3" style="color: var(--omm-ink-900);">Shareholding &amp; Payouts</h3>

                            <!-- Shares Owned -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="qc-shares">Shares Owned</label>
                                <input id="qc-shares" type="number" class="form-control rounded-3" min="0" step="100"
                                       placeholder="e.g. 1000"
                                       @bind="qcShares" @bind:event="oninput" />
                            </div>

                            <!-- Payment Frequency & Payout Mode -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-semibold mb-0" style="color: var(--omm-ink-700);" for="qc-freq">Dividend Frequency</label>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-sm py-0 px-2 @(qcPayoutType == "uniform" ? "btn-dark" : "btn-outline-secondary")"
                                                style="font-size: 0.72rem;"
                                                @onclick='() => ChangePayoutType("uniform")'>
                                            Fixed Rate
                                        </button>
                                        <button type="button" class="btn btn-sm py-0 px-2 @(qcPayoutType == "variable" ? "btn-dark" : "btn-outline-secondary")"
                                                style="font-size: 0.72rem;"
                                                @onclick='() => ChangePayoutType("variable")'>
                                            Variable Terms
                                        </button>
                                    </div>
                                </div>
                                <select id="qc-freq" class="form-select rounded-3" @bind="qcFrequency" @bind:after="OnFrequencyChanged">
                                    <option value="@DividendFrequency.Monthly">Monthly (12 payouts/yr)</option>
                                    <option value="@DividendFrequency.Quarterly">Quarterly (4 payouts/yr)</option>
                                    <option value="@DividendFrequency.SemiAnnually">Semi-annually (2 payouts/yr)</option>
                                    <option value="@DividendFrequency.Annually">Annually (1 payout/yr)</option>
                                </select>
                            </div>

                            <!-- Dividend Rate: Uniform vs Variable Term Inputs -->
                            @if (qcPayoutType == "uniform")
                            {
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="qc-dps">
                                        Dividend Per Share (@DividendEngine.FrequencyLabel(qcFrequency))
                                    </label>
                                    <div class="dc-currency-group">
                                        <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                        <input id="qc-dps" type="number" class="form-control" min="0" step="0.01"
                                               placeholder="0.30"
                                               @bind="qcDividendPerShare" @bind:event="oninput" />
                                    </div>
                                    <div class="dc-assumption-note">Amount paid per share for each @DividendEngine.FrequencyLabel(qcFrequency) distribution</div>
                                </div>
                            }
                            else
                            {
                                <!-- Variable per-term inputs (e.g. Q1, Q2, Q3, Q4) -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label small fw-semibold mb-0" style="color: var(--omm-ink-700);">
                                            Per-Term Dividend Rates (@DividendEngine.FrequencyShortLabel(qcFrequency))
                                        </label>
                                        <span class="text-muted" style="font-size: 0.7rem;">Enter term rates</span>
                                    </div>
                                    <div class="row g-2">
                                        @for (int i = 0; i < qcVariableTerms.Count; i++)
                                        {
                                            var idx = i;
                                            var termLabel = DividendEngine.GetPeriodLabel(qcFrequency, idx);
                                            <div class="@(qcVariableTerms.Count <= 4 ? "col-6" : "col-4 col-md-3")">
                                                <div class="dc-term-box">
                                                    <div class="dc-term-label">@termLabel</div>
                                                    <div class="dc-currency-group">
                                                        <span class="dc-currency-addon" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; min-width: 32px;">@dcCurrencySymbol</span>
                                                        <input type="number" class="form-control form-control-sm" min="0" step="0.01"
                                                               placeholder="0.00"
                                                               value="@qcVariableTerms[idx]"
                                                               @oninput="@((ChangeEventArgs e) => UpdateVariableTerm(idx, e.Value?.ToString()))" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Special / One-off Dividend Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="qc-special-dps">
                                    Special / Bonus Dividend Per Share <span class="dc-subtle-optional">(Optional)</span>
                                </label>
                                <div class="dc-currency-group">
                                    <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                    <input id="qc-special-dps" type="number" class="form-control" min="0" step="0.01"
                                           placeholder="0.00 (leave blank if none)"
                                           @bind="qcSpecialDividendPerShare" @bind:event="oninput" />
                                </div>
                                <div class="dc-assumption-note">One-time extra or special dividend distribution</div>
                            </div>
                        </div>

                        <!-- 3. Price & Yield Calculations (Optional Section) -->
                        <div class="dc-card-optional">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="small fw-bold text-dark font-display" style="font-size: 0.82rem;">
                                    <i class="ti ti-percentage me-1 text-primary"></i> Market &amp; Cost Basis <span class="dc-subtle-optional">(Optional)</span>
                                </span>
                            </div>
                            <p class="text-muted small mb-3" style="font-size: 0.75rem; line-height: 1.4;">
                                Enter market price and purchase cost to calculate Dividend Yield and Yield on Cost.
                            </p>

                            <div class="row g-2">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-semibold text-muted mb-1" for="qc-price">Current Share Price</label>
                                    <div class="dc-currency-group">
                                        <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                        <input id="qc-price" type="number" class="form-control" min="0" step="0.01"
                                               placeholder="10.50"
                                               @bind="qcSharePrice" @bind:event="oninput" />
                                    </div>
                                    <div class="dc-assumption-note">For Dividend Yield %</div>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-semibold text-muted mb-1" for="qc-purchase">Purchase Cost Basis</label>
                                    <div class="dc-currency-group">
                                        <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                        <input id="qc-purchase" type="number" class="form-control" min="0" step="0.01"
                                               placeholder="8.00"
                                               @bind="qcPurchasePrice" @bind:event="oninput" />
                                    </div>
                                    <div class="dc-assumption-note">For Yield on Cost %</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- RIGHT: Live Results -->
                <div class="col-12 col-lg-7">
                    @if (!QcHasResult)
                    {
                        <div class="card border-0 shadow-sm rounded-4 bg-white h-100 d-flex align-items-center justify-content-center p-5">
                            <div class="dc-empty-state">
                                <i class="ti ti-chart-bar fs-1 mb-3"></i>
                                <div class="fw-bold fs-6 mb-1" style="color: var(--omm-ink-800);">Ready to calculate your dividends</div>
                                <div class="small text-muted">Enter your shares and dividend rate on the left to see instant income projections.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 h-100">
                            <!-- Hero: Annual Dividend -->
                            <div class="dc-hero-block dc-animate shadow-sm">
                                <div class="dc-hero-label">
                                    @(!string.IsNullOrWhiteSpace(qcStockName) ? $"{qcStockName} ({qcStockSymbol}) - " : "")Annual Dividend
                                </div>
                                <div class="dc-hero-value">@dcCurrencySymbol@CurrentQuickCalc.AnnualDividend.ToString("N2")</div>
                                <div class="dc-hero-sub">
                                    @if (qcSpecialDividendPerShare > 0)
                                    {
                                        <span>Regular: @dcCurrencySymbol@CurrentQuickCalc.RegularAnnualDividend.ToString("N2")</span>
                                        <span>&nbsp;+ Special: @dcCurrencySymbol@CurrentQuickCalc.SpecialDividendTotal.ToString("N2")</span>
                                        <span>&nbsp;·&nbsp;</span>
                                    }
                                    <span>@dcCurrencySymbol@CurrentQuickCalc.PerPaymentDividend.ToString("N2")</span> avg/@DividendEngine.FrequencyLabel(qcFrequency)
                                    &nbsp;·&nbsp;
                                    ≈ <span>@dcCurrencySymbol@CurrentQuickCalc.MonthlyEquivalent.ToString("N2")</span> /mo
                                </div>
                            </div>

                            <!-- Breakdown of terms if variable or special exists -->
                            @if (qcPayoutType == "variable" || qcSpecialDividendPerShare > 0)
                            {
                                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white dc-animate">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="small fw-bold text-dark font-display" style="font-size: 0.78rem;">
                                            <i class="ti ti-calendar-event me-1 text-primary"></i> Payout Distribution Breakdown
                                        </span>
                                        <span class="text-muted" style="font-size: 0.72rem;">@qcShares.ToString("N0") shares</span>
                                    </div>
                                    <div class="row g-2">
                                        @for (int i = 0; i < CurrentQuickCalc.PayoutBreakdown.Count; i++)
                                        {
                                            var termDps = CurrentQuickCalc.PayoutBreakdown[i];
                                            var termPayout = qcShares * termDps;
                                            <div class="@(CurrentQuickCalc.PayoutBreakdown.Count <= 4 ? "col-6 col-md-3" : "col-4 col-md-2")">
                                                <div class="p-2 rounded-3 text-center border" style="background: var(--omm-ink-50);">
                                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.65rem;">
                                                        @DividendEngine.GetPeriodLabel(qcFrequency, i)
                                                    </div>
                                                    <div class="fw-bold text-dark font-display" style="font-size: 0.9rem;">
                                                        @dcCurrencySymbol@termPayout.ToString("N0")
                                                    </div>
                                                    <small class="text-muted" style="font-size: 0.68rem;">@dcCurrencySymbol@termDps.ToString("N3")/sh</small>
                                                </div>
                                            </div>
                                        }
                                        @if (qcSpecialDividendPerShare > 0)
                                        {
                                            <div class="@(CurrentQuickCalc.PayoutBreakdown.Count <= 4 ? "col-6 col-md-3" : "col-4 col-md-2")">
                                                <div class="p-2 rounded-3 text-center border border-warning-subtle" style="background: #fffbeb;">
                                                    <div class="text-warning-emphasis text-uppercase fw-bold" style="font-size: 0.65rem;">
                                                        Special Div
                                                    </div>
                                                    <div class="fw-bold text-warning-emphasis font-display" style="font-size: 0.9rem;">
                                                        @dcCurrencySymbol@CurrentQuickCalc.SpecialDividendTotal.ToString("N0")
                                                    </div>
                                                    <small class="text-muted" style="font-size: 0.68rem;">@dcCurrencySymbol@qcSpecialDividendPerShare.ToString("N3")/sh</small>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Supporting metrics -->
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dc-animate">
                                <div class="dc-metric-row">
                                    <span class="dc-metric-label">Shares Owned</span>
                                    <span class="dc-metric-value">@qcShares.ToString("N0")</span>
                                </div>
                                <div class="dc-metric-row">
                                    <span class="dc-metric-label">Annualized Dividend / Share</span>
                                    <span class="dc-metric-value">
                                        @dcCurrencySymbol@((CurrentQuickCalc.AnnualDividend / (qcShares > 0 ? qcShares : 1)).ToString("N4"))
                                    </span>
                                </div>
                                <div class="dc-metric-row">
                                    <span class="dc-metric-label">Payment Frequency</span>
                                    <span class="dc-metric-value">@CurrentQuickCalc.PaymentsPerYear × / year (@DividendEngine.FrequencyShortLabel(qcFrequency))</span>
                                </div>
                                @if (qcSharePrice > 0 && CurrentQuickCalc.DividendYield.HasValue)
                                {
                                    <div class="dc-metric-row">
                                        <span class="dc-metric-label">Estimated Dividend Yield (at @dcCurrencySymbol@qcSharePrice.ToString("N2"))</span>
                                        <span class="dc-metric-value text-success fw-bold">@CurrentQuickCalc.DividendYield.Value.ToString("F2")%</span>
                                    </div>
                                }
                                @if (qcPurchasePrice > 0 && CurrentQuickCalc.YieldOnCost.HasValue)
                                {
                                    <div class="dc-metric-row">
                                        <span class="dc-metric-label">Yield on Cost (at cost basis @dcCurrencySymbol@qcPurchasePrice.ToString("N2"))</span>
                                        <span class="dc-metric-value text-primary fw-bold">@CurrentQuickCalc.YieldOnCost.Value.ToString("F2")%</span>
                                    </div>
                                }
                            </div>

                            <!-- Actions: Save as Mine & Transition to Simulator -->
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dc-animate">
                                <div class="small fw-semibold mb-3 text-muted text-uppercase" style="letter-spacing: 0.06em; font-size: 0.7rem;">Next Actions</div>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <!-- Save to Mines -->
                                    <button class="btn-save-mine" @onclick="SaveToMinesAsync">
                                        <i class="ti ti-device-floppy"></i>
                                        Save as Mine to Track
                                    </button>

                                    <!-- Simulator Transitions -->
                                    <button class="dc-action-link ms-auto" @onclick="CarryToSimulator">
                                        <i class="ti ti-trending-up"></i>
                                        Project in Simulator
                                    </button>
                                    <button class="dc-action-link" @onclick="CarryToSimulatorDrip">
                                        <i class="ti ti-refresh"></i>
                                        Model with DRIP
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- ──────────────────────────────────────────────────────────────
                 INVESTMENT SIMULATOR MODE
            ─────────────────────────────────────────────────────────────── -->
            <div class="row g-4 dc-animate">
                <!-- LEFT: Inputs -->
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                        <!-- Stock metadata -->
                        <div class="dc-section">
                            <div class="dc-section-title">Stock / Asset</div>
                            <div class="row g-2">
                                <div class="col-5">
                                    <label class="form-label small fw-semibold text-muted" for="sim-symbol">Stock Code</label>
                                    <input id="sim-symbol" type="text" class="form-control rounded-3"
                                           placeholder="e.g. 1155.KL" @bind="simStockSymbol" @bind:event="oninput" />
                                </div>
                                <div class="col-7">
                                    <label class="form-label small fw-semibold text-muted" for="sim-name">Company Name</label>
                                    <input id="sim-name" type="text" class="form-control rounded-3"
                                           placeholder="e.g. Maybank" @bind="simStockName" @bind:event="oninput" />
                                </div>
                            </div>
                        </div>

                        <!-- Investment section -->
                        <div class="dc-section">
                            <div class="dc-section-title">Investment &amp; Capital</div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-shares">Initial Shares Owned</label>
                                <input id="sim-shares" type="number" class="form-control rounded-3" min="0" step="100"
                                       placeholder="e.g. 1000" @bind="simShares" @bind:event="oninput" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-cur-price">Current Market Share Price</label>
                                <div class="dc-currency-group">
                                    <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                    <input id="sim-cur-price" type="number" class="form-control" min="0" step="0.01"
                                           placeholder="10.50" @bind="simCurrentPrice" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-purchase-price">Purchase Price Per Share (Cost Basis)</label>
                                <div class="dc-currency-group">
                                    <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                    <input id="sim-purchase-price" type="number" class="form-control" min="0" step="0.01"
                                           placeholder="8.00" @bind="simPurchasePrice" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-8">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-contrib">Recurring Contribution</label>
                                    <div class="dc-currency-group">
                                        <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                        <input id="sim-contrib" type="number" class="form-control" min="0" step="100"
                                               placeholder="0" @bind="simContribution" @bind:event="oninput" />
                                    </div>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-contrib-freq">Frequency</label>
                                    <select id="sim-contrib-freq" class="form-select rounded-3" @bind="simContribFrequency">
                                        <option value="@ContributionFrequency.None">None</option>
                                        <option value="@ContributionFrequency.Monthly">Monthly</option>
                                        <option value="@ContributionFrequency.Quarterly">Quarterly</option>
                                        <option value="@ContributionFrequency.Annually">Annually</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Dividend section -->
                        <div class="dc-section">
                            <div class="dc-section-title">Dividend Parameters</div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-dps">Dividend Per Share (per distribution)</label>
                                <div class="dc-currency-group">
                                    <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                    <input id="sim-dps" type="number" class="form-control" min="0" step="0.01"
                                           placeholder="0.30" @bind="simDividendPerShare" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-freq">Frequency</label>
                                    <select id="sim-freq" class="form-select rounded-3" @bind="simFrequency">
                                        <option value="@DividendFrequency.Monthly">Monthly</option>
                                        <option value="@DividendFrequency.Quarterly">Quarterly</option>
                                        <option value="@DividendFrequency.SemiAnnually">Semi-annually</option>
                                        <option value="@DividendFrequency.Annually">Annually</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-div-growth">Div Growth (% p.a.)</label>
                                    <div class="dc-currency-group">
                                        <input id="sim-div-growth" type="number" class="form-control" step="0.5"
                                               placeholder="5" @bind="simDividendGrowth" @bind:event="oninput" />
                                        <span class="dc-currency-suffix">%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-1">
                                <label class="form-label small fw-semibold text-muted" for="sim-special-dps">Special Dividend Per Share (Year 1)</label>
                                <div class="dc-currency-group">
                                    <span class="dc-currency-addon">@dcCurrencySymbol</span>
                                    <input id="sim-special-dps" type="number" class="form-control" min="0" step="0.01"
                                           placeholder="0.00" @bind="simSpecialDividendPerShare" @bind:event="oninput" />
                                </div>
                            </div>
                        </div>

                        <!-- Growth section -->
                        <div class="dc-section">
                            <div class="dc-section-title">Growth &amp; Horizon</div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-price-growth">Price Growth (% p.a.)</label>
                                    <div class="dc-currency-group">
                                        <input id="sim-price-growth" type="number" class="form-control" step="0.5"
                                               placeholder="0" @bind="simPriceGrowth" @bind:event="oninput" />
                                        <span class="dc-currency-suffix">%</span>
                                    </div>
                                    <div class="dc-assumption-note">Defaults to 0%</div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" style="color: var(--omm-ink-700);" for="sim-years">Investment Period</label>
                                    <div class="dc-currency-group">
                                        <input id="sim-years" type="number" class="form-control" min="1" max="100" step="1"
                                               placeholder="10" @bind="simYears" @bind:event="oninput" />
                                        <span class="dc-currency-suffix">yr</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reinvestment (DRIP) section -->
                        <div class="dc-section">
                            <div class="dc-section-title">Reinvestment (DRIP)</div>
                            <div class="dc-toggle-row">
                                <div>
                                    <div class="dc-toggle-label">Reinvest dividends (DRIP)</div>
                                    <div class="dc-toggle-sub">Auto-compound dividend payouts into new shares</div>
                                </div>
                                <div class="form-check form-switch mb-0 ms-3">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sim-drip"
                                           @bind="simDripEnabled" />
                                </div>
                            </div>
                            @if (simDripEnabled)
                            {
                                <div class="dc-toggle-row">
                                    <div>
                                        <div class="dc-toggle-label">Allow fractional shares</div>
                                        <div class="dc-toggle-sub">Reinvest exact cash amount including fractions</div>
                                    </div>
                                    <div class="form-check form-switch mb-0 ms-3">
                                        <input class="form-check-input" type="checkbox" role="switch" id="sim-fractional"
                                               @bind="simFractionalShares" />
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Tax section -->
                        <div class="dc-section">
                            <div class="dc-section-title">Estimated Tax (Optional)</div>
                            <div class="dc-toggle-row mb-2">
                                <div>
                                    <div class="dc-toggle-label">Include estimated tax withholding</div>
                                    <div class="dc-toggle-sub">For net after-tax income modeling</div>
                                </div>
                                <div class="form-check form-switch mb-0 ms-3">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sim-tax"
                                           @bind="simTaxEnabled" />
                                </div>
                            </div>
                            @if (simTaxEnabled)
                            {
                                <div class="row g-2 mt-1">
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold text-muted" for="sim-div-tax">Dividend Tax Rate</label>
                                        <div class="dc-currency-group">
                                            <input id="sim-div-tax" type="number" class="form-control" min="0" max="100" step="1"
                                                   placeholder="15" @bind="simDividendTaxRate" @bind:event="oninput" />
                                            <span class="dc-currency-suffix">%</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold text-muted" for="sim-cgt">Capital Gains Tax Rate</label>
                                        <div class="dc-currency-group">
                                            <input id="sim-cgt" type="number" class="form-control" min="0" max="100" step="1"
                                                   placeholder="10" @bind="simCapGainsTaxRate" @bind:event="oninput" />
                                            <span class="dc-currency-suffix">%</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Results + Charts -->
                <div class="col-12 col-lg-7">

                    @if (!SimHasResult)
                    {
                        <div class="card border-0 shadow-sm rounded-4 bg-white d-flex align-items-center justify-content-center p-5" style="min-height: 300px;">
                            <div class="dc-empty-state">
                                <i class="ti ti-chart-dots fs-1 mb-3"></i>
                                <div class="fw-bold fs-6 mb-1" style="color: var(--omm-ink-800);">Simulation Parameters Needed</div>
                                <div class="small text-muted">Enter shares, share price, and dividend rate on the left to generate models.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Summary metrics grid -->
                        <div class="row g-3 mb-4 dc-animate">
                            <div class="col-12">
                                <div class="dc-sim-metric highlight shadow-sm">
                                    <div class="dc-sim-metric-label">Projected Portfolio Value</div>
                                    <div class="dc-sim-metric-value">@dcCurrencySymbol@CurrentSimResult.FinalPortfolioValue.ToString("N0")</div>
                                    <div class="dc-sim-metric-sub">After @simYears year@(simYears != 1 ? "s" : "")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Annual Dividend Income</div>
                                    <div class="dc-sim-metric-value">@dcCurrencySymbol@CurrentSimResult.FinalAnnualDividend.ToString("N0")</div>
                                    <div class="dc-sim-metric-sub">Year @simYears @(simTaxEnabled ? "(net after tax)" : "(gross)")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Dividends Received</div>
                                    <div class="dc-sim-metric-value">@dcCurrencySymbol@CurrentSimResult.TotalDividendsNet.ToString("N0")</div>
                                    <div class="dc-sim-metric-sub">@(simTaxEnabled ? "Net, after estimated tax" : "Gross, cumulative")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Shares</div>
                                    <div class="dc-sim-metric-value">@CurrentSimResult.TotalShares.ToString("N2")</div>
                                    <div class="dc-sim-metric-sub">@(simDripEnabled ? $"+{CurrentSimResult.Projections.LastOrDefault()?.CumulativeSharesBoughtViaDrip.ToString("N2") ?? "0"} via DRIP" : "No DRIP")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Return</div>
                                    <div class="dc-sim-metric-value text-success">@CurrentSimResult.TotalReturn.ToString("F1")%</div>
                                    <div class="dc-sim-metric-sub">Portfolio growth + dividends</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Yield on Cost</div>
                                    <div class="dc-sim-metric-value text-primary">@CurrentSimResult.YieldOnCost.ToString("F2")%</div>
                                    <div class="dc-sim-metric-sub">Year @simYears div / initial basis</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Capital Invested</div>
                                    <div class="dc-sim-metric-value">@dcCurrencySymbol@(CurrentSimResult.InitialInvestment + CurrentSimResult.TotalContributions).ToString("N0")</div>
                                    <div class="dc-sim-metric-sub">Initial + regular contributions</div>
                                </div>
                            </div>
                        </div>

                        <!-- Charts -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 dc-animate">
                            <div class="row g-4">
                                <!-- Portfolio Growth -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Portfolio Growth</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-portfolio"></canvas>
                                    </div>
                                </div>
                                <!-- Dividend Income -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Annual Dividend Income</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-dividend"></canvas>
                                    </div>
                                </div>
                                <!-- Shares Growth -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Shares Growth</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-shares"></canvas>
                                    </div>
                                </div>
                                <!-- Cash vs DRIP -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Portfolio: DRIP vs Cash Dividends</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-drip"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Year-by-Year Projection Table -->
                        <div class="card border-0 shadow-sm rounded-4 bg-white dc-animate">
                            <div class="p-4 d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold font-display" style="color: var(--omm-ink-900); font-size: 0.95rem;">Year-by-Year Projection</div>
                                    <div class="text-muted small">Detailed annual financial milestones</div>
                                </div>
                                <button class="dc-expand-btn" @onclick="() => simTableExpanded = !simTableExpanded">
                                    <i class="ti @(simTableExpanded ? "ti-chevron-up" : "ti-chevron-down")"></i>
                                    @(simTableExpanded ? "Collapse" : "Expand")
                                </button>
                            </div>

                            @if (simTableExpanded)
                            {
                                <div class="dc-projection-table-wrapper" style="border-top: 1px solid var(--omm-ink-100); overflow-x: auto;">
                                    <table class="dc-projection-table">
                                        <thead>
                                            <tr>
                                                <th>Year</th>
                                                <th style="text-align:right;">Shares</th>
                                                <th style="text-align:right;">Div/Share (ann.)</th>
                                                <th style="text-align:right;">Annual Dividend</th>
                                                <th style="text-align:right;">Share Price</th>
                                                <th style="text-align:right;">Portfolio Value</th>
                                                <th style="text-align:right;">Total Return</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in CurrentSimResult.Projections)
                                            {
                                                <tr>
                                                    <td><span class="badge bg-light text-dark border">Yr @row.Year</span></td>
                                                    <td style="text-align:right;">@row.Shares.ToString("N2")</td>
                                                    <td style="text-align:right;">@dcCurrencySymbol@row.DividendPerShare.ToString("N4")</td>
                                                    <td style="text-align:right;">@dcCurrencySymbol@row.AnnualDividendNet.ToString("N2")</td>
                                                    <td style="text-align:right;">@dcCurrencySymbol@row.SharePrice.ToString("N2")</td>
                                                    <td class="highlight-col" style="text-align:right;">@dcCurrencySymbol@row.PortfolioValue.ToString("N0")</td>
                                                    <td style="text-align:right; color: @(row.TotalReturn >= 0 ? "var(--omm-mine-green)" : "var(--omm-burden-red)");">
                                                        @row.TotalReturn.ToString("F1")%
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Chart rendering trigger -->
            @if (SimHasResult)
            {
                _ = RenderChartsAsync(CurrentSimResult);
            }
        }
    }
    else
    {
        <!-- Default fallback for other tools -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white animate-fade-up">
            <i class="ti ti-tool fs-1 text-muted mb-3"></i>
            <h3 class="h5 fw-bold text-dark mb-1">Simulator Ready</h3>
            <p class="text-muted small mb-4">Adjust the sliders and parameters to explore scenarios.</p>
            <button class="btn btn-dark btn-sm rounded-3 px-3" @onclick="() => activeTool = null">Return to Tools Catalog</button>
        </div>
    }
}

@code {
    private string? activeTool;
    private string userCurrency = "MYR";
    private string dcCurrencySymbol = "RM";
    private bool savedNotification = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await MineService.GetMinerProfileAsync();
            if (profile != null && !string.IsNullOrWhiteSpace(profile.Currency))
            {
                userCurrency = profile.Currency;
                dcCurrencySymbol = FormatHelper.GetCurrencySymbol(userCurrency);
            }
        }
        catch
        {
            // fallback to default MYR
        }

        InitializeVariableTerms();
    }

    // ── Back / cleanup ───────────────────────────────────────────────────────
    private async Task HandleBackToTools()
    {
        await JS.InvokeVoidAsync("dividendCharts.destroyAll");
        activeTool = null;
        savedNotification = false;
    }

    // ── FD Calculator state ──────────────────────────────────────────────────
    private decimal fdPrincipal = 50000m;
    private decimal fdRate = 3.85m;
    private int fdTenureMonths = 12;

    private decimal FdMaturityValue => fdPrincipal * (decimal)Math.Pow((double)(1m + (fdRate / 100m)), (double)fdTenureMonths / 12.0);
    private decimal FdTotalInterest => FdMaturityValue - fdPrincipal;
    private decimal FdMonthlyEquivalent => fdTenureMonths > 0 ? FdTotalInterest / fdTenureMonths : 0;

    // ── Freedom Calculator state ─────────────────────────────────────────────
    private decimal simExpenses = 4500m;
    private decimal simPassive = 1200m;
    private decimal simMonthlySaving = 2000m;
    private decimal simYield = 6.0m;

    // ── Emergency Fund state ─────────────────────────────────────────────────
    private decimal efMonthlyExpense = 4500m;
    private decimal efCurrentCash = 25000m;
    private int efTargetMonths = 6;

    // ─────────────────────────────────────────────────────────────────────────
    // DIVIDEND CALCULATOR STATE
    // ─────────────────────────────────────────────────────────────────────────

    private string dcMode = "quick";

    // ── Quick Calculate inputs ───────────────────────────────────────────────
    private string qcStockSymbol = "";
    private string qcStockName = "";
    private decimal qcShares = 0m;
    private decimal qcDividendPerShare = 0m;
    private decimal qcSpecialDividendPerShare = 0m;
    private DividendFrequency qcFrequency = DividendFrequency.Quarterly;
    private string qcPayoutType = "uniform"; // "uniform" or "variable"
    private List<decimal> qcVariableTerms = [];

    // Optional Pricing fields
    private decimal qcSharePrice = 0m;
    private decimal qcPurchasePrice = 0m;

    private void InitializeVariableTerms()
    {
        int count = DividendEngine.PaymentsPerYear(qcFrequency);
        qcVariableTerms = Enumerable.Repeat(qcDividendPerShare > 0 ? qcDividendPerShare : 0m, count).ToList();
    }

    private void OnFrequencyChanged()
    {
        InitializeVariableTerms();
    }

    private void ChangePayoutType(string type)
    {
        qcPayoutType = type;
        if (qcPayoutType == "variable" && (qcVariableTerms == null || qcVariableTerms.Count != DividendEngine.PaymentsPerYear(qcFrequency)))
        {
            InitializeVariableTerms();
        }
    }

    private void UpdateVariableTerm(int index, string? valStr)
    {
        if (decimal.TryParse(valStr, out var val) && index >= 0 && index < qcVariableTerms.Count)
        {
            qcVariableTerms[index] = val;
        }
        else if (index >= 0 && index < qcVariableTerms.Count)
        {
            qcVariableTerms[index] = 0m;
        }
    }

    private QuickCalcResult CurrentQuickCalc => DividendEngine.QuickCalculate(
        qcShares,
        qcDividendPerShare,
        qcFrequency,
        qcSharePrice > 0 ? qcSharePrice : null,
        qcPurchasePrice > 0 ? qcPurchasePrice : null,
        qcSpecialDividendPerShare,
        qcPayoutType == "variable" ? qcVariableTerms : null
    );

    private bool QcHasResult
    {
        get
        {
            if (qcShares <= 0) return false;
            if (qcPayoutType == "uniform") return qcDividendPerShare > 0 || qcSpecialDividendPerShare > 0;
            return (qcVariableTerms != null && qcVariableTerms.Any(v => v > 0)) || qcSpecialDividendPerShare > 0;
        }
    }

    // ── Investment Simulator inputs ──────────────────────────────────────────
    private string simStockSymbol = "";
    private string simStockName = "";
    private decimal simShares = 0m;
    private decimal simCurrentPrice = 0m;
    private decimal simPurchasePrice = 0m;
    private decimal simContribution = 0m;
    private ContributionFrequency simContribFrequency = ContributionFrequency.Monthly;
    private decimal simDividendPerShare = 0m;
    private decimal simSpecialDividendPerShare = 0m;
    private DividendFrequency simFrequency = DividendFrequency.Quarterly;
    private decimal simDividendGrowth = 0m;
    private decimal simPriceGrowth = 0m;
    private int simYears = 10;
    private bool simDripEnabled = false;
    private bool simFractionalShares = true;
    private bool simTaxEnabled = false;
    private decimal simDividendTaxRate = 0m;
    private decimal simCapGainsTaxRate = 0m;
    private bool simTableExpanded = false;

    private SimulatorResult CurrentSimResult => DividendEngine.SimulatePortfolio(BuildSimulatorInput());
    private bool SimHasResult => simShares > 0 && (simDividendPerShare > 0 || simSpecialDividendPerShare > 0) && simCurrentPrice > 0;

    // ── Save to Mines Shortcut ───────────────────────────────────────────────
    private async Task SaveToMinesAsync()
    {
        try
        {
            var stockTitle = !string.IsNullOrWhiteSpace(qcStockName)
                ? qcStockName
                : (!string.IsNullOrWhiteSpace(qcStockSymbol) ? qcStockSymbol : "Dividend Stock");

            var currentVal = qcSharePrice > 0 ? qcShares * qcSharePrice : (CurrentQuickCalc.AnnualDividend > 0 ? CurrentQuickCalc.AnnualDividend * 15m : 1000m);
            var costVal = qcPurchasePrice > 0 ? qcShares * qcPurchasePrice : currentVal;

            var growthVal = currentVal - costVal;
            var growthPct = costVal > 0 ? (growthVal / costVal) * 100m : 0m;

            var newMine = new Mine
            {
                Id = $"mine-stock-{Guid.NewGuid():N}"[..18],
                Name = stockTitle,
                Category = MineCategory.Investments,
                Type = MineType.Stocks,
                Institution = !string.IsNullOrWhiteSpace(qcStockSymbol) ? qcStockSymbol : "Stock Portfolio",
                Currency = userCurrency,
                CurrentValue = currentVal,
                PurchaseCost = costVal,
                Growth = growthVal,
                GrowthPct = growthPct,
                MonthlyIncome = CurrentQuickCalc.MonthlyEquivalent,
                Holdings = $"{qcShares:N0} shares" + (qcSharePrice > 0 ? $" @ {dcCurrencySymbol}{qcSharePrice:N2}" : ""),
                Status = "active",
                UpdatedAt = DateTime.Today.ToString("yyyy-MM-dd")
            };

            await MineService.AddMineAsync(newMine);
            savedNotification = true;
            StateHasChanged();

            _ = Task.Delay(4000).ContinueWith(_ =>
            {
                savedNotification = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            // handle gracefully
        }
    }

    // ── Chart rendering ──────────────────────────────────────────────────────
    private SimulatorResult? _lastRenderedResult;

    private async Task RenderChartsAsync(SimulatorResult result)
    {
        if (_lastRenderedResult == result) return;
        _lastRenderedResult = result;

        await Task.Delay(50);

        try
        {
            var labels = result.Projections.Select(p => $"Yr {p.Year}").ToArray();
            var portfolioVals = result.Projections.Select(p => (double)p.PortfolioValue).ToArray();
            var totalInvestedVals = result.Projections.Select(p => (double)(result.InitialInvestment + p.CumulativeContributions)).ToArray();
            var grossDivVals = result.Projections.Select(p => (double)p.AnnualDividendGross).ToArray();
            var netDivVals = result.Projections.Select(p => (double)p.AnnualDividendNet).ToArray();
            var totalSharesVals = result.Projections.Select(p => (double)p.Shares).ToArray();
            var dripSharesVals = result.Projections.Select(p => (double)p.CumulativeSharesBoughtViaDrip).ToArray();
            var withDripVals = result.Projections.Select(p => (double)p.PortfolioValue).ToArray();
            var withoutDripVals = result.Projections.Select(p => (double)(result.InitialInvestment + p.CumulativeContributions + p.CumulativeDividendsNet)).ToArray();

            await JS.InvokeVoidAsync("dividendCharts.renderPortfolioGrowth",
                "chart-portfolio", labels, portfolioVals, totalInvestedVals, dcCurrencySymbol);

            await JS.InvokeVoidAsync("dividendCharts.renderDividendIncome",
                "chart-dividend", labels, grossDivVals, netDivVals, dcCurrencySymbol);

            await JS.InvokeVoidAsync("dividendCharts.renderSharesGrowth",
                "chart-shares", labels, totalSharesVals, dripSharesVals);

            await JS.InvokeVoidAsync("dividendCharts.renderCashVsReinvested",
                "chart-drip", labels, withDripVals, withoutDripVals, dcCurrencySymbol);
        }
        catch
        {
            // JS interop retry on next tick
        }
    }

    // ── Mode switching ────────────────────────────────────────────────────────
    private async Task SwitchMode(string mode)
    {
        await JS.InvokeVoidAsync("dividendCharts.destroyAll");
        _lastRenderedResult = null;
        dcMode = mode;
    }

    // ── Carry Quick Calc values to Simulator ──────────────────────────────────
    private async Task CarryToSimulator()
    {
        simStockSymbol = qcStockSymbol;
        simStockName = qcStockName;
        simShares = qcShares;
        simDividendPerShare = qcPayoutType == "uniform" 
            ? qcDividendPerShare 
            : (qcVariableTerms.Count > 0 ? qcVariableTerms.Average() : 0m);
        simSpecialDividendPerShare = qcSpecialDividendPerShare;
        simFrequency = qcFrequency;
        simCurrentPrice = qcSharePrice > 0 ? qcSharePrice : (qcPurchasePrice > 0 ? qcPurchasePrice : 0m);
        simPurchasePrice = qcPurchasePrice > 0 ? qcPurchasePrice : (qcSharePrice > 0 ? qcSharePrice : 0m);
        await SwitchMode("simulator");
    }

    private async Task CarryToSimulatorDrip()
    {
        await CarryToSimulator();
        simDripEnabled = true;
    }

    // ── Build simulator input from current state ──────────────────────────────
    private DividendSimulatorInput BuildSimulatorInput()
    {
        int years = DividendEngine.IsValidYears(simYears) ? simYears : 10;

        return new DividendSimulatorInput
        {
            StockSymbol = simStockSymbol,
            StockName = simStockName,
            InitialShares = simShares >= 0 ? simShares : 0m,
            PurchasePrice = simPurchasePrice >= 0 ? simPurchasePrice : 0m,
            CurrentSharePrice = simCurrentPrice >= 0 ? simCurrentPrice : 0m,
            RecurringContribution = simContribution >= 0 ? simContribution : 0m,
            ContributionFrequency = simContribFrequency,
            DividendPerShare = simDividendPerShare >= 0 ? simDividendPerShare : 0m,
            SpecialDividendPerShare = simSpecialDividendPerShare >= 0 ? simSpecialDividendPerShare : 0m,
            DividendFrequency = simFrequency,
            DividendGrowthRate = DividendEngine.IsValidPercentage(simDividendGrowth) ? simDividendGrowth : 0m,
            SharePriceGrowthRate = DividendEngine.IsValidPercentage(simPriceGrowth) ? simPriceGrowth : 0m,
            InvestmentYears = years,
            DripEnabled = simDripEnabled,
            AllowFractionalShares = simFractionalShares,
            TaxEnabled = simTaxEnabled,
            DividendTaxRate = simDividendTaxRate >= 0 && simDividendTaxRate <= 100 ? simDividendTaxRate : 0m,
            CapitalGainsTaxRate = simCapGainsTaxRate >= 0 && simCapGainsTaxRate <= 100 ? simCapGainsTaxRate : 0m
        };
    }
}
