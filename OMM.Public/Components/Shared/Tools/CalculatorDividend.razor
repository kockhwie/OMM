                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Dividends Received</div>
                                    <div class="dc-sim-metric-value">@dcCurrencySymbol @CurrentSimResult.TotalDividendsNet.ToString("N0")</div>
                                    <div class="dc-sim-metric-sub">@(simTaxEnabled ? "Net, after estimated tax" : "Gross, cumulative")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Shares</div>
                                    <div class="dc-sim-metric-value">@CurrentSimResult.TotalShares.ToString("N2")</div>
                                    <div class="dc-sim-metric-sub">@(simDripEnabled ? $"+{CurrentSimResult.Projections.LastOrDefault()?.CumulativeSharesBoughtViaDrip.ToString("N2") ?? "0"} via DRIP" : "No DRIP")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Return</div>
                                    <div class="dc-sim-metric-value text-success">@CurrentSimResult.TotalReturn.ToString("F1")%</div>
                                    <div class="dc-sim-metric-sub">Portfolio growth + dividends</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Yield on Cost</div>
                                    <div class="dc-sim-metric-value text-primary">@CurrentSimResult.YieldOnCost.ToString("F2")%</div>
                                    <div class="dc-sim-metric-sub">Year @simYears div / initial basis</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="dc-sim-metric">
                                    <div class="dc-sim-metric-label">Total Capital Invested</div>
                                    <div class="dc-sim-metric-value">@dcCurrencySymbol @(CurrentSimResult.InitialInvestment + CurrentSimResult.TotalContributions) </div>
                                    <div class="dc-sim-metric-sub">Initial + regular contributions</div>
                                </div>
                            </div>
                        </div>

                        <!-- Charts -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 dc-animate">
                            <div class="row g-4">
                                <!-- Portfolio Growth -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Portfolio Growth</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-portfolio"></canvas>
                                    </div>
                                </div>
                                <!-- Dividend Income -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Annual Dividend Income</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-dividend"></canvas>
                                    </div>
                                </div>
                                <!-- Shares Growth -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Shares Growth</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-shares"></canvas>
                                    </div>
                                </div>
                                <!-- Cash vs DRIP -->
                                <div class="col-12 col-md-6">
                                    <div class="dc-chart-title">Portfolio: DRIP vs Cash Dividends</div>
                                    <div class="dc-chart-container">
                                        <canvas id="chart-drip"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Year-by-Year Projection Table -->
                        <div class="card border-0 shadow-sm rounded-4 bg-white dc-animate">
                            <div class="p-4 d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold font-display" style="color: var(--omm-ink-900); font-size: 0.95rem;">Year-by-Year Projection</div>
                                    <div class="text-muted small">Detailed annual financial milestones</div>
                                </div>
                                <button class="dc-expand-btn" @onclick="() => simTableExpanded = !simTableExpanded">
                                    <i class="ti @(simTableExpanded ? "ti-chevron-up" : "ti-chevron-down")"></i>
                                    @(simTableExpanded ? "Collapse" : "Expand")
                                </button>
                            </div>

                            @if (simTableExpanded)
                            {
                                <div class="dc-projection-table-wrapper" style="border-top: 1px solid var(--omm-ink-100); overflow-x: auto;">
                                    <table class="dc-projection-table">
                                        <thead>
                                            <tr>
                                                <th>Year</th>
                                                <th style="text-align:right;">Shares</th>
                                                <th style="text-align:right;">Div/Share (ann.)</th>
                                                <th style="text-align:right;">Annual Dividend</th>
                                                <th style="text-align:right;">Share Price</th>
                                                <th style="text-align:right;">Portfolio Value</th>
                                                <th style="text-align:right;">Total Return</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in CurrentSimResult.Projections)
                                            {
                                                <tr>
                                                    <td><span class="badge bg-light text-dark border">Yr @row.Year</span></td>
                                                    <td style="text-align:right;">@row.Shares.ToString("N2")</td>
                                                    <td style="text-align:right;">@dcCurrencySymbol @row.DividendPerShare.ToString("N4")</td>
                                                    <td style="text-align:right;">@dcCurrencySymbol @row.AnnualDividendNet.ToString("N2")</td>
                                                    <td style="text-align:right;">@dcCurrencySymbol @row.SharePrice.ToString("N2")</td>
                                                    <td class="highlight-col" style="text-align:right;">@dcCurrencySymbol @row.PortfolioValue.ToString("N0")</td>
                                                    <td style="text-align:right; color: @(row.TotalReturn >= 0 ? "var(--omm-mine-green)" : "var(--omm-burden-red)");">
                                                        @row.TotalReturn.ToString("F1")%
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Chart rendering trigger -->
            @if (SimHasResult)
            {
                _ = RenderChartsAsync(CurrentSimResult);
            }
        }
    }
@code {
    [Parameter] public string UserCurrency { get; set; } = "MYR";
    [Parameter] public string CurrencySymbol { get; set; } = "RM";

    // Aliases so existing markup references compile
    private string dcCurrencySymbol => CurrencySymbol;
    private string userCurrency => UserCurrency;
    private bool qcShowOptional;
    private bool savedNotification = false;

    // ─────────────────────────────────────────────────────────────────────────
    // DIVIDEND CALCULATOR STATE
    // ─────────────────────────────────────────────────────────────────────────

    private string dcMode = "quick";

    // ── Quick Calculate inputs ───────────────────────────────────────────────
    private string qcStockSymbol = "";
    private string qcStockName = "";
    private decimal qcShares = 0m;
    private decimal qcDividendPerShare = 0m;
    private decimal qcSpecialDividendPerShare = 0m;
    private DividendFrequency qcFrequency = DividendFrequency.Quarterly;
    private string qcPayoutType = "uniform"; // "uniform" or "variable"
    private List<decimal> qcVariableTerms = [];

    // Optional Pricing fields
    private decimal qcSharePrice = 0m;
    private decimal qcPurchasePrice = 0m;

    private void InitializeVariableTerms()
    {
        int count = DividendEngine.PaymentsPerYear(qcFrequency);
        qcVariableTerms = Enumerable.Repeat(qcDividendPerShare > 0 ? qcDividendPerShare : 0m, count).ToList();
    }

    private void OnFrequencyChanged()
    {
        InitializeVariableTerms();
    }

    private void ChangePayoutType(string type)
    {
        qcPayoutType = type;
        if (qcPayoutType == "variable" && (qcVariableTerms == null || qcVariableTerms.Count != DividendEngine.PaymentsPerYear(qcFrequency)))
        {
            InitializeVariableTerms();
        }
    }

    private void UpdateVariableTerm(int index, string? valStr)
    {
        if (decimal.TryParse(valStr, out var val) && index >= 0 && index < qcVariableTerms.Count)
        {
            qcVariableTerms[index] = val;
        }
        else if (index >= 0 && index < qcVariableTerms.Count)
        {
            qcVariableTerms[index] = 0m;
        }
    }

    private QuickCalcResult CurrentQuickCalc => DividendEngine.QuickCalculate(
        qcShares,
        qcDividendPerShare,
        qcFrequency,
        qcSharePrice > 0 ? qcSharePrice : null,
        qcPurchasePrice > 0 ? qcPurchasePrice : null,
        qcSpecialDividendPerShare,
        qcPayoutType == "variable" ? qcVariableTerms : null
    );

    private bool QcHasResult
    {
        get
        {
            if (qcShares <= 0) return false;
            if (qcPayoutType == "uniform") return qcDividendPerShare > 0 || qcSpecialDividendPerShare > 0;
            return (qcVariableTerms != null && qcVariableTerms.Any(v => v > 0)) || qcSpecialDividendPerShare > 0;
        }
    }

    // ── Advanced Mode inputs ──────────────────────────────────────────
    private string simStockSymbol = "";
    private string simStockName = "";
    private decimal simShares = 0m;
    private decimal simCurrentPrice = 0m;
    private decimal simPurchasePrice = 0m;
    private decimal simContribution = 0m;
    private ContributionFrequency simContribFrequency = ContributionFrequency.Monthly;
    private decimal simDividendPerShare = 0m;
    private decimal simSpecialDividendPerShare = 0m;
    private DividendFrequency simFrequency = DividendFrequency.Quarterly;
    private decimal simDividendGrowth = 0m;
    private decimal simPriceGrowth = 0m;
    private int simYears = 10;
    private bool simDripEnabled = false;
    private bool simFractionalShares = true;
    private bool simTaxEnabled = false;
    private decimal simDividendTaxRate = 0m;
    private decimal simCapGainsTaxRate = 0m;
    private bool simTableExpanded = false;

    private SimulatorResult CurrentSimResult => DividendEngine.SimulatePortfolio(BuildSimulatorInput());
    private bool SimHasResult => simShares > 0 && (simDividendPerShare > 0 || simSpecialDividendPerShare > 0) && simCurrentPrice > 0;

    // ── Save to Mines Shortcut ───────────────────────────────────────────────
    private async Task SaveToMinesAsync()
    {
        try
        {
            var stockTitle = !string.IsNullOrWhiteSpace(qcStockName)
                ? qcStockName
                : (!string.IsNullOrWhiteSpace(qcStockSymbol) ? qcStockSymbol : "Dividend Stock");

            var currentVal = qcSharePrice > 0 ? qcShares * qcSharePrice : (CurrentQuickCalc.AnnualDividend > 0 ? CurrentQuickCalc.AnnualDividend * 15m : 1000m);
            var costVal = qcPurchasePrice > 0 ? qcShares * qcPurchasePrice : currentVal;

            var growthVal = currentVal - costVal;
            var growthPct = costVal > 0 ? (growthVal / costVal) * 100m : 0m;

            var newMine = new Mine
            {
                Id = $"mine-stock-{Guid.NewGuid():N}"[..18],
                Name = stockTitle,
                Category = MineCategory.Investments,
                Type = MineType.Stocks,
                Institution = !string.IsNullOrWhiteSpace(qcStockSymbol) ? qcStockSymbol : "Stock Portfolio",
                Currency = userCurrency,
                CurrentValue = currentVal,
                PurchaseCost = costVal,
                Growth = growthVal,
                GrowthPct = growthPct,
                MonthlyIncome = CurrentQuickCalc.MonthlyEquivalent,
                Holdings = $"{qcShares:N0} shares" + (qcSharePrice > 0 ? $" @ {dcCurrencySymbol}{qcSharePrice:N2}" : ""),
                Status = "active",
                UpdatedAt = DateTime.Today.ToString("yyyy-MM-dd")
            };

            await MineService.AddMineAsync(newMine);
            savedNotification = true;
            StateHasChanged();

            _ = Task.Delay(4000).ContinueWith(_ =>
            {
                savedNotification = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            // handle gracefully
        }
    }

    // ── Chart rendering ──────────────────────────────────────────────────────
    private SimulatorResult? _lastRenderedResult;

    private async Task RenderChartsAsync(SimulatorResult result)
    {
        if (_lastRenderedResult == result) return;
        _lastRenderedResult = result;

        await Task.Delay(50);

        try
        {
            var labels = result.Projections.Select(p => $"Yr {p.Year}").ToArray();
            var portfolioVals = result.Projections.Select(p => (double)p.PortfolioValue).ToArray();
            var totalInvestedVals = result.Projections.Select(p => (double)(result.InitialInvestment + p.CumulativeContributions)).ToArray();
            var grossDivVals = result.Projections.Select(p => (double)p.AnnualDividendGross).ToArray();
            var netDivVals = result.Projections.Select(p => (double)p.AnnualDividendNet).ToArray();
            var totalSharesVals = result.Projections.Select(p => (double)p.Shares).ToArray();
            var dripSharesVals = result.Projections.Select(p => (double)p.CumulativeSharesBoughtViaDrip).ToArray();
            var withDripVals = result.Projections.Select(p => (double)p.PortfolioValue).ToArray();
            var withoutDripVals = result.Projections.Select(p => (double)(result.InitialInvestment + p.CumulativeContributions + p.CumulativeDividendsNet)).ToArray();

            await JS.InvokeVoidAsync("dividendCharts.renderPortfolioGrowth",
                "chart-portfolio", labels, portfolioVals, totalInvestedVals, dcCurrencySymbol);

            await JS.InvokeVoidAsync("dividendCharts.renderDividendIncome",
                "chart-dividend", labels, grossDivVals, netDivVals, dcCurrencySymbol);

            await JS.InvokeVoidAsync("dividendCharts.renderSharesGrowth",
                "chart-shares", labels, totalSharesVals, dripSharesVals);

            await JS.InvokeVoidAsync("dividendCharts.renderCashVsReinvested",
                "chart-drip", labels, withDripVals, withoutDripVals, dcCurrencySymbol);
        }
        catch
        {
            // JS interop retry on next tick
        }
    }

    // ── Mode switching ────────────────────────────────────────────────────────
    private async Task SwitchMode(string mode)
    {
        await JS.InvokeVoidAsync("dividendCharts.destroyAll");
        _lastRenderedResult = null;
        dcMode = mode;
    }

    // ── Carry Quick Calc values to Simulator ──────────────────────────────────
    private async Task CarryToSimulator()
    {
        simStockSymbol = qcStockSymbol;
        simStockName = qcStockName;
        simShares = qcShares;
        simDividendPerShare = qcPayoutType == "uniform" 
            ? qcDividendPerShare 
            : (qcVariableTerms.Count > 0 ? qcVariableTerms.Average() : 0m);
        simSpecialDividendPerShare = qcSpecialDividendPerShare;
        simFrequency = qcFrequency;
        simCurrentPrice = qcSharePrice > 0 ? qcSharePrice : (qcPurchasePrice > 0 ? qcPurchasePrice : 0m);
        simPurchasePrice = qcPurchasePrice > 0 ? qcPurchasePrice : (qcSharePrice > 0 ? qcSharePrice : 0m);
        await SwitchMode("simulator");
    }

    private async Task CarryToSimulatorDrip()
    {
        await CarryToSimulator();
        simDripEnabled = true;
    }

    // ── Build simulator input from current state ──────────────────────────────
    private DividendSimulatorInput BuildSimulatorInput()
    {
        int years = DividendEngine.IsValidYears(simYears) ? simYears : 10;

        return new DividendSimulatorInput
        {
            StockSymbol = simStockSymbol,
            StockName = simStockName,
            InitialShares = simShares >= 0 ? simShares : 0m,
            PurchasePrice = simPurchasePrice >= 0 ? simPurchasePrice : 0m,
            CurrentSharePrice = simCurrentPrice >= 0 ? simCurrentPrice : 0m,
            RecurringContribution = simContribution >= 0 ? simContribution : 0m,
            ContributionFrequency = simContribFrequency,
            DividendPerShare = simDividendPerShare >= 0 ? simDividendPerShare : 0m,
            SpecialDividendPerShare = simSpecialDividendPerShare >= 0 ? simSpecialDividendPerShare : 0m,
            DividendFrequency = simFrequency,
            DividendGrowthRate = DividendEngine.IsValidPercentage(simDividendGrowth) ? simDividendGrowth : 0m,
            SharePriceGrowthRate = DividendEngine.IsValidPercentage(simPriceGrowth) ? simPriceGrowth : 0m,
            InvestmentYears = years,
            DripEnabled = simDripEnabled,
            AllowFractionalShares = simFractionalShares,
            TaxEnabled = simTaxEnabled,
            DividendTaxRate = simDividendTaxRate >= 0 && simDividendTaxRate <= 100 ? simDividendTaxRate : 0m,
            CapitalGainsTaxRate = simCapGainsTaxRate >= 0 && simCapGainsTaxRate <= 100 ? simCapGainsTaxRate : 0m
        };
    }

    
    private bool YieldInputsPartiallyFilled => (qcSharePrice > 0) != (qcPurchasePrice > 0);

    private void OnStockPicked(KlseStock stock)
    {
        // Placeholder for later: e.g. qcSharePrice = await PriceLookup.GetLatestAsync(stock.Code);
        // Left as a manual, always-editable field for now per your note — this hook is just
        // here so wiring in a live price feed later doesn't require touching the markup again.
    }


}
