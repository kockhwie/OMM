@page "/expenses"
@layout DashboardLayout
@attribute [Authorize]
@using OMM.Public.Models
@using OMM.Public.Services
@inject MemberRecordService RecordService

<PageTitle>Expenses - OhMyMine</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">Expenses</h1>
        <p class="text-muted small mb-0">Track recurring and one-off outflows from your financial picture.</p>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="OpenAddModal">
        <i class="ti ti-plus fs-5"></i>
        <span>Add Expense</span>
    </button>
</div>

@if (expenses.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="ti ti-receipt-off fs-2 text-muted"></i>
        </div>
        <h2 class="h5 fw-bold text-dark">No expenses recorded yet</h2>
        <p class="text-muted small mb-3">Add your recurring expenses to understand your real monthly cash flow.</p>
        <button class="btn btn-outline-dark btn-sm rounded-3 px-3" @onclick="OpenAddModal">Add your first expense</button>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var expense in expenses)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h6 fw-bold text-dark mb-1">@expense.Name</h2>
                            <span class="badge bg-light text-dark">@expense.Frequency</span>
                        </div>
                        <button class="btn btn-sm btn-outline-danger rounded-3" title="Delete expense" @onclick="() => DeleteExpense(expense.Id)">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                    <div class="fs-4 fw-bold text-dark mt-4">@FormatHelper.FormatCurrency(expense.Amount, expense.Currency)</div>
                </div>
            </div>
        }
    </div>
}

@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header bg-dark text-white border-0">
                    <h2 class="h5 modal-title fw-bold mb-0">Add Expense</h2>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrWhiteSpace(inputError))
                    {
                        <div class="alert alert-danger rounded-3">@inputError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Expense name *</label>
                        <input class="form-control rounded-3" @bind="newExpense.Name" placeholder="e.g. Utilities, Groceries" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Amount *</label>
                            <input type="number" min="0" step="0.01" class="form-control rounded-3" @bind="newExpense.Amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Frequency *</label>
                            <select class="form-select rounded-3" @bind="newExpense.Frequency">
                                <option value="monthly">Monthly</option>
                                <option value="annual">Annual</option>
                                <option value="one-off">One-off</option>
                            </select>
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">Currency follows your saved profile currency unless a record-specific currency is added later.</p>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button class="btn btn-outline-secondary rounded-3" @onclick="CloseAddModal">Cancel</button>
                    <button class="btn btn-primary rounded-3" @onclick="SaveExpense">Save Expense</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Expense> expenses = [];
    private Expense newExpense = new();
    private bool showAddModal;
    private string? inputError;

    protected override async Task OnInitializedAsync() => await LoadExpenses();

    private async Task LoadExpenses() => expenses = await RecordService.GetExpensesAsync();

    private void OpenAddModal()
    {
        inputError = null;
        newExpense = new Expense { Frequency = "monthly" };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        inputError = null;
        showAddModal = false;
    }

    private async Task SaveExpense()
    {
        inputError = PublicInputValidator.GetDisplayTextError("Expense name", newExpense.Name);
        if (inputError is not null || newExpense.Amount <= 0)
        {
            inputError ??= "Enter an amount greater than zero.";
            return;
        }

        try
        {
            await RecordService.AddExpenseAsync(newExpense);
            CloseAddModal();
            await LoadExpenses();
        }
        catch (ArgumentException exception)
        {
            inputError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            inputError = exception.Message;
        }
    }

    private async Task DeleteExpense(string id)
    {
        await RecordService.DeleteExpenseAsync(id);
        await LoadExpenses();
    }
}
