@namespace OMM.Public.Components.Shared

<div class="omm-card metric-card metric-card-@Variant p-4 h-100 position-relative overflow-hidden @CardClass">
    <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
        <div class="flex-grow-1 min-w-0">
            <span class="metric-card-label text-uppercase fw-bold d-block">@Title</span>
            <div class="d-flex align-items-baseline flex-wrap gap-2 mt-1">
                @if (NumericTarget.HasValue)
                {
                    <h2 class="mb-0 font-display fw-bold metric-card-value"
                        data-counter-target="@NumericTarget.Value"
                        data-counter-prefix="@(CounterPrefix ?? "")"
                        data-counter-suffix="@(CounterSuffix ?? "")"
                        data-counter-decimals="@CounterDecimals">@Value</h2>
                }
                else
                {
                    <h2 class="mb-0 font-display fw-bold metric-card-value">@Value</h2>
                }
                @if (!string.IsNullOrEmpty(Trend))
                {
                    <span class="metric-card-trend @TrendClass fw-bold d-inline-flex align-items-center gap-1 flex-shrink-0">
                        <i class="ti @TrendIcon"></i>
                        @Trend
                    </span>
                }
            </div>
        </div>
        <div class="metric-card-icon d-flex align-items-center justify-content-center p-2 rounded-3 flex-shrink-0 @IconBgClass">
            <i class="ti @Icon fs-4"></i>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <div class="metric-card-subtitle">
            @Subtitle
        </div>
    }

    @if (ChildContent != null)
    {
        <div class="mt-3">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "ti-chart-bar";
    [Parameter] public string Variant { get; set; } = "default"; // default, mine, burden, gold, freedom
    [Parameter] public string? Trend { get; set; }
    [Parameter] public bool TrendPositive { get; set; } = true;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public decimal? NumericTarget { get; set; }
    [Parameter] public string? CounterPrefix { get; set; }
    [Parameter] public string? CounterSuffix { get; set; }
    [Parameter] public int CounterDecimals { get; set; } = 0;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CardClass { get; set; }

    private string IconBgClass => Variant switch
    {
        "mine" => "bg-success-subtle text-success",
        "burden" => "bg-danger-subtle text-danger",
        "gold" or "clay" => "bg-warning-subtle text-warning-emphasis",
        "freedom" => "bg-primary-subtle text-primary",
        _ => "bg-secondary-subtle text-secondary"
    };

    private string TrendClass => TrendPositive ? "text-success" : "text-danger";
    private string TrendIcon => TrendPositive ? "ti-trending-up" : "ti-trending-down";
}