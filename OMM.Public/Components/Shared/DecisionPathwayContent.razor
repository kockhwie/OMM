    }

    private async Task UseSignalAsync(SignalTemplate signal)
    {
        selectedSignal = signal;
        targetSecurity = signal.DefaultSecurity;
        targetSector = signal.DefaultSector;
        selectedConcern = signal.DefaultConcern;
        selectedScope = signal.DefaultScope;
        selectedObjective = signal.DefaultObjective;
        selectedAction = "hold";
        await LoadStoredStockDataAsync();
        await LookupUserPositionAsync();
        RefreshCalculations();
        screen = 2;
    }

    private async Task UseGeneralQuestionAsync(SignalCategory category, string? security, string? sector)
    {
        selectedSignal = CreateGeneralSignal(category, memberQuestion, security, sector);
        targetSecurity = security ?? string.Empty;
        targetSector = sector ?? string.Empty;
        selectedConcern = category == SignalCategory.PortfolioDecision ? "concentration" : "price_drop";
        selectedScope = category switch
        {
            SignalCategory.IndividualStock => "individual_stock",
            SignalCategory.Sector => "sector",
            SignalCategory.MalaysianMarket => "malaysian_market",
            SignalCategory.GlobalEconomy => "global_economy",
            _ => "portfolio"
        };
        selectedObjective = "balanced";
        await LoadStoredStockDataAsync();
        await LookupUserPositionAsync();
        RefreshCalculations();
    }

    private SignalTemplate CreateGeneralSignal(SignalCategory category, string question, string? security, string? sector)
    {
        var title = question.Trim();
        if (title.Length > 200)
        {
            title = $"{title[..197]}…";
        }

        return new SignalTemplate(
            $"member-question-{Guid.NewGuid():N}",
            category,
            string.IsNullOrWhiteSpace(title) ? "Guided decision" : title,
            "Member-entered question classified through guided deterministic steps.",
            question.Trim(),
            security ?? string.Empty,
            sector ?? string.Empty,
            category == SignalCategory.PortfolioDecision ? "concentration" : "price_drop",
            selectedScope,
            "balanced",
            isActive: false);
    }

    private async Task OnStockPicked(KlseStock stock)
    {
        targetSecurity = $"{stock.CompanyName} ({stock.Code})";
        await OnTargetSecurityChanged();
    }

    private async Task OnTargetSecurityChanged(ChangeEventArgs? e = null)
    {
        if (e?.Value is string val)
        {
            targetSecurity = val;
        }

        await LoadStoredStockDataAsync();
        await LookupUserPositionAsync();
        RefreshCalculations();
    }

    private async Task LookupUserPositionAsync()
    {
        matchedPosition = null;
        if (string.IsNullOrWhiteSpace(targetSecurity))
        {
            return;
        }

        try
        {
            var authState = await AuthenticationStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            matchedPosition = await PortfolioContextProvider.GetPositionAsync(userId, targetSecurity);

            if (matchedPosition != null)
            {
                if (calcShares == null || calcShares == 0)
                {
                    calcShares = (int)matchedPosition.Shares;
                }
                if (calcCostBasis == null || calcCostBasis == 0)
                {
                    calcCostBasis = matchedPosition.CostBasis;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to retrieve portfolio context for security {Security}", targetSecurity);
        }
    }

    private async Task LoadStoredStockDataAsync()
    {
        calcPrice = null;
        calcDividend = null;
        stockDataStatus = "No stored price data found. Enter a reference price to model scenarios.";

        var target = targetSecurity.Trim();
        if (target.Length == 0)
        {
            return;
        }

        var name = target.Split('(', '/')[0].Trim();
        if (name.Length == 0)
        {
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var stock = await dbContext.Stocks
                .AsNoTracking()
                .Where(item => item.IsActive &&
                    (EF.Functions.ILike(item.ShortName_EN, $"%{name}%") || EF.Functions.ILike(item.StockCode, $"%{name}%")))
                .OrderBy(item => item.ShortName_EN.Length)
                .FirstOrDefaultAsync();

            if (stock is null)
            {
                return;
            }

            calcPrice = stock.CurrentPrice is > 0 ? stock.CurrentPrice : null;
            calcDividend = stock.DPS is > 0 ? stock.DPS : null;
            stockDataStatus = stock.LastScrapedAt is { } refreshedAt
                ? $"Stored master data as of {refreshedAt.ToLocalTime():g}; not a live quote."
                : "Stored master data has no update timestamp; not a live quote.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to load stored stock data for the Decision Pathway.");
            stockDataStatus = "Stored stock data is unavailable. Enter a reference price manually.";
        }
    }

    private static SignalCategory GetSignalCategory(string signalType) => signalType switch
    {
        "stock_event" => SignalCategory.IndividualStock,
        "sector_event" => SignalCategory.Sector,
        "market_event" => SignalCategory.MalaysianMarket,
        "economic_event" => SignalCategory.GlobalEconomy,
        "opportunity" => SignalCategory.Opportunity,
        _ => SignalCategory.PortfolioDecision
    };

