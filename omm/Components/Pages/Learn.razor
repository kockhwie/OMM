@page "/learn"
@layout DashboardLayout
@inject NavigationManager Navigation

<PageTitle>Learn - The Mining Philosophy - OhMyMine</PageTitle>

<div class="mb-4 animate-fade-up">
    <h1 class="h3 fw-bold text-dark font-display mb-1">Learn</h1>
    <p class="text-muted small mb-0">The mental models, frameworks, and principles behind OhMyMine</p>
</div>

<!-- Featured Article Hero -->
<div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 mb-4 text-white overflow-hidden position-relative animate-fade-up"
     style="background: linear-gradient(135deg, #0d0e13 0%, #1e293b 100%);">
    <div class="position-relative" style="z-index: 2; max-width: 720px;">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning bg-opacity-25 text-warning small fw-bold mb-3 border border-warning border-opacity-25">
            <i class="ti ti-book-2"></i>
            <span>FOUNDATIONAL GUIDE</span>
        </div>
        <h2 class="h2 fw-bold font-display text-white mb-3">The Mining Metaphor: A Radical Way to See Your Money</h2>
        <p class="text-white-50 mb-4" style="line-height: 1.6; font-size: 0.95rem;">
            Everything you own is either a <strong>Mine</strong> that generates ore, or a <strong>Burden</strong> weighing on your cashflow. 
            When your passive ore exceeds your monthly living expenses, you cross the threshold into true financial freedom.
        </p>
        <button class="btn btn-warning fw-bold px-4 py-2 rounded-3 text-dark d-inline-flex align-items-center gap-2 shadow-sm"
                @onclick='() => OpenArticle("metaphor")'>
            <span>Read Core Guide</span>
            <i class="ti ti-arrow-right"></i>
        </button>
    </div>
</div>

<!-- Articles Grid -->
<div class="row g-4 mb-4">
    @foreach (var article in articles)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer bg-white animate-fade-up"
                 @onclick="() => OpenArticle(article.Id)">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-3 bg-dark-subtle text-dark p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="ti @article.IconClass fs-4"></i>
                    </div>
                    <span class="badge @article.TagClass">@article.Tag</span>
                </div>
                <h3 class="h6 fw-bold text-dark font-display mb-2">@article.Title</h3>
                <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                    @article.Excerpt
                </p>
                <div class="d-flex align-items-center justify-content-between pt-3 border-top border-light-subtle text-muted small">
                    <span class="d-inline-flex align-items-center gap-1">
                        <i class="ti ti-clock fs-6"></i>
                        @article.ReadTime read
                    </span>
                    <i class="ti ti-arrow-right fs-6 text-dark"></i>
                </div>
            </div>
        </div>
    }
</div>

<!-- Reader Modal -->
@if (selectedArticle != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti @selectedArticle.IconClass text-warning fs-4"></i>
                        <span class="badge @selectedArticle.TagClass">@selectedArticle.Tag</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseArticle"></button>
                </div>
                <div class="modal-body p-4 p-md-5">
                    <h2 class="h3 fw-bold text-dark font-display mb-2">@selectedArticle.Title</h2>
                    <div class="text-muted small mb-4 pb-3 border-bottom border-light-subtle d-flex align-items-center gap-3">
                        <span><i class="ti ti-clock me-1"></i>@selectedArticle.ReadTime read</span>
                        <span><i class="ti ti-sparkles me-1"></i>OhMyMine Knowledge Base</span>
                    </div>

                    <div class="article-content text-dark" style="line-height: 1.8; font-size: 0.95rem;">
                        @((MarkupString)selectedArticle.ContentHtml)
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-dark rounded-3 px-4 fw-medium" @onclick="CloseArticle">Done Reading</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Article? selectedArticle;

    private void OpenArticle(string id)
    {
        selectedArticle = articles.FirstOrDefault(a => a.Id == id);
    }

    private void CloseArticle()
    {
        selectedArticle = null;
    }

    private record Article(string Id, string Title, string Excerpt, string ReadTime, string Tag, string TagClass, string IconClass, string ContentHtml);

    private readonly List<Article> articles =
    [
        new(
            "metaphor",
            "What is a Mine?",
            "A mine is any asset you own that produces or holds value. Learn how to identify mines in your own financial life - from EPF to dividend stocks.",
            "4 min",
            "Core Concept",
            "bg-dark-subtle text-dark border",
            "ti-pick",
            @"<p>In traditional accounting, assets are often defined in dry terms like capital, equity, and liquidity. In <strong>OhMyMine</strong>, we use the visual language of <strong>mining</strong>.</p>
              <h4>1. Every Asset is a Mine</h4>
              <p>A mine is any container where your capital works for you. It might be your <strong>EPF/KWSP account</strong> compounding annual dividends, a <strong>Fixed Deposit placement</strong> at CIMB, a portfolio of <strong>dividend-paying Bursa stocks</strong>, or physical <strong>Gold</strong> stored in Maybank.</p>
              <h4>2. The Quality of Ore</h4>
              <p>Not all mines produce the same output:</p>
              <ul>
                <li><strong>Golden Ore:</strong> Predictable, recurring passive income (rental distributions, dividends, interest).</li>
                <li><strong>Silver Ore:</strong> Capital appreciation that grows silently over years.</li>
                <li><strong>Coal:</strong> Stagnant cash that loses purchasing power against Malaysian inflation.</li>
              </ul>
              <p>Your objective as a financial miner is simple: acquire quality mines, protect their output, and eliminate unserviceable burdens.</p>"
        ),
        new(
            "burdens",
            "Understanding Burdens & Net Equity",
            "Burdens are obligations that weigh on your mines. Learn how to link debts to assets and see your true net position.",
            "3 min",
            "Core Concept",
            "bg-danger-subtle text-danger border border-danger-subtle",
            "ti-weight",
            @"<p>Debt is not necessarily evil, but unanchored debt creates friction in your cash flow.</p>
              <h4>The Burden Connection</h4>
              <p>When you take a loan to acquire a mine (for example, a 30-year housing loan for a condo in Mont Kiara), that loan is a <strong>Burden linked to that Mine</strong>.</p>
              <h4>Calculating True Net Equity</h4>
              <p>A property worth RM620,000 with an outstanding mortgage of RM380,000 gives you <strong>RM240,000 in net realizable equity</strong>.</p>
              <p>Tracking the burden directly against the mine prevents the illusion of wealth and gives you absolute clarity on your true solvency.</p>"
        ),
        new(
            "freedom",
            "The Freedom Ratio Explained",
            "How to calculate your freedom ratio, what the numbers mean, and how to use it as your primary financial compass.",
            "5 min",
            "Freedom",
            "bg-success-subtle text-success border border-success-subtle",
            "ti-bolt",
            @"<p>The <strong>Freedom Ratio</strong> is the single most important metric in the OhMyMine framework.</p>
              <div class='p-3 rounded-3 bg-light border mb-3 text-center'>
                <strong>Freedom Ratio = (Monthly Passive Income ÷ Monthly Recurring Living Expenses) × 100%</strong>
              </div>
              <h4>Interpreting the Compass:</h4>
              <ul>
                <li><strong>0% – 25%:</strong> Early Exploration - Active salary pays for all living costs.</li>
                <li><strong>25% – 50%:</strong> Momentum - Passive income covers utility bills and groceries.</li>
                <li><strong>50% – 75%:</strong> Semi-Freedom - Basic survival is fully covered without working.</li>
                <li><strong>100%+:</strong> True Sovereignty - Work becomes entirely optional.</li>
              </ul>"
        ),
        new(
            "malaysia",
            "The Malaysian Mining Ecosystem",
            "A comprehensive overview of Malaysian wealth instruments: EPF/KWSP, ASB/ASM, PRS, Bursa Malaysia, and Gold.",
            "6 min",
            "Ecosystem",
            "bg-warning-subtle text-warning border border-warning-subtle",
            "ti-building-bank",
            @"<h4>1. EPF / KWSP</h4>
              <p>Malaysia's premier retirement mine. With historical dividend returns averaging 5.5% - 6.5% p.a., it provides guaranteed capital protection for Simpanan Konvensional and Shariah accounts.</p>
              <h4>2. ASB & ASM (Amanah Saham)</h4>
              <p>Fixed-price unit trust funds offering liquidity, capital preservation at RM1.00/unit, and competitive historic yields.</p>
              <h4>3. Bursa Malaysia Dividend REITs & Blue Chips</h4>
              <p>Companies like Maybank, Public Bank, Sunway REIT, and Axis REIT distribute consistent quarterly or biannual cash dividends directly into your bank account.</p>
              <h4>4. Physical Gold & Digital Gold Accounts</h4>
              <p>A hedge against currency depreciation and systemic risks.</p>"
        ),
        new(
            "philosophy",
            "OhMyMine Philosophy: Compass over GPS",
            "Why we built a tool that provides radical clarity rather than algorithmic sales pitches.",
            "3 min",
            "Philosophy",
            "bg-light text-dark border",
            "ti-compass",
            @"<p>Most financial software wants to sell you unit trusts, credit cards, or robotic robo-advisory packages.</p>
              <h4>We Believe in Sovereign Clarity</h4>
              <p>OhMyMine is designed as a <strong>compass, not a GPS</strong>. A GPS tells you which turn to make, removes your judgment, and takes control. A compass gives you true north, reveals the terrain, and trusts you to navigate your own path.</p>
              <p>When you see your mines, burdens, and freedom ratio clearly, the right decisions become self-evident.</p>"
        )
    ];
}
