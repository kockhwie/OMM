<div class="rounded-3 border border-dashed p-4 text-center" style="background-color: var(--omm-ink-50);">
    <i class="ti @Icon text-muted fs-3"></i>
    <h3 class="h6 fw-bold text-dark mt-2 mb-1">@Title</h3>
    <p class="text-muted small mb-3">@Description</p>
    <a class="btn btn-sm btn-outline-dark rounded-3" href="@Href">@ActionText</a>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Href { get; set; } = string.Empty;
    [Parameter] public string ActionText { get; set; } = "Get started";
    [Parameter] public string Icon { get; set; } = "ti-arrow-right";
}
