@namespace OMM.Public.Components.Shared

<header class="fixed-top bg-white bg-opacity-95 shadow-sm border-bottom border-light" style="backdrop-filter: blur(8px); z-index: 1030;">
    <div class="container-xl d-flex align-items-center justify-content-between py-2">
        <Logo Href="/" />

        <NavLink class="omm-navlink" href="/tools">Financial Tools</NavLink>
        <NavLink class="omm-navlink" href="/learn">Learn</NavLink>
        <a class="omm-navlink" href="/#about">About</a>

        <div class="d-none d-md-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <a href="/dashboard" class="btn btn-omm-primary">
                        <span>Enter Mine Board</span>
                        <i class="ti ti-chevron-right fs-6"></i>
                    </a>
                    <form action="Account/Logout" method="post" class="d-inline m-0">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 py-2 px-3 rounded-3 fw-medium">
                            <i class="ti ti-logout"></i>
                            <span>Sign Out</span>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login?returnUrl=%2Fdashboard" class="btn btn-light">
                        Log in
                    </a>
                    <a href="/dashboard" class="btn btn-omm-primary">
                        <span>Enter Mine Board</span>
                        <i class="ti ti-chevron-right fs-6"></i>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <button class="btn btn-sm d-md-none border-0 text-dark" @onclick="ToggleMobileMenu" aria-label="Toggle menu">
            <i class="ti @(isMobileMenuOpen ? "ti-x" : "ti-menu-2") fs-3"></i>
        </button>
    </div>

    @if (isMobileMenuOpen)
    {
        <div class="d-md-none bg-white border-top px-4 py-3 shadow-sm">
            <div class="d-flex flex-column gap-2">
                <NavLink class="omm-navlink" href="/tools">Financial Tools</NavLink>
                <NavLink class="omm-navlink" href="/learn">Learn</NavLink>
                <a class="omm-navlink" href="/#about">About</a>
                <hr class="my-2" />
                <AuthorizeView>
                    <Authorized>
                        <a href="/dashboard" class="btn btn-omm-primary w-100 mb-2">
                            <span>Enter Mine Board</span>
                            <i class="ti ti-chevron-right fs-6"></i>
                        </a>
                        <form action="Account/Logout" method="post" class="w-100">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="/" />
                            <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                                <i class="ti ti-logout"></i>
                                <span>Sign Out</span>
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/Account/Login?returnUrl=%2Fdashboard" class="btn btn-omm-secondary w-100">
                            Log in
                        </a>
                        <a href="/dashboard" class="btn btn-omm-primary w-100 mt-1">
                            <span>Enter Mine Board</span>
                            <i class="ti ti-chevron-right fs-6"></i>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    }
</header>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }
}
