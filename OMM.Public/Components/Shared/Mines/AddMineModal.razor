    private void RecalculateStock()
    {
        var shares = metadata.SharesOwned ?? 0;
        var costPerShare = metadata.PurchasePricePerShare ?? 0;
        var currentPrice = metadata.CurrentSharePrice ?? 0;

        if (costPerShare > 0)
        {
            workingMine.PurchaseCost = shares * costPerShare;
        }
        if (currentPrice > 0)
        {
            workingMine.CurrentValue = shares * currentPrice;
            ComputeGrowth();
        }
        else
        {
            workingMine.Growth = 0;
            workingMine.GrowthPct = 0;
            workingMine.MonthlyIncome = 0;
        }

        if (currentPrice > 0 && metadata.DividendYieldPct.HasValue && metadata.DividendYieldPct > 0)
        {
            var annual = workingMine.CurrentValue * (metadata.DividendYieldPct.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        workingMine.Holdings = $"{shares:N0} shares @ {currentPrice:N2}";
    }

    private void RecalculateStockManualValue()
    {
        ComputeGrowth();
        workingMine.MonthlyIncome = 0;
    }

    private void RecalculateUsStock()
    {
        ComputeGrowth();
        if (metadata.DividendYieldPct.HasValue && metadata.DividendYieldPct > 0)
        {
            var annual = workingMine.CurrentValue * (metadata.DividendYieldPct.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        if (!string.IsNullOrWhiteSpace(metadata.StockCode))
        {
            workingMine.Holdings = $"{metadata.SharesOwned} shares of {metadata.StockCode}";
        }
    }

    private void RecalculateFund()
    {
        var units = metadata.UnitsHeld ?? 0;
        var purchaseNav = metadata.NavPerUnit ?? 0;
        var currentNav = currentNavTemp ?? 0;

        if (purchaseNav > 0)
        {
            workingMine.PurchaseCost = units * purchaseNav;
        }
        if (currentNav > 0)
        {
            workingMine.CurrentValue = units * currentNav;
            ComputeGrowth();
        }
        else
        {
            workingMine.Growth = 0;
            workingMine.GrowthPct = 0;
            workingMine.MonthlyIncome = 0;
        }

        if (currentNav > 0 && metadata.DividendYieldPct.HasValue && metadata.DividendYieldPct > 0)
        {
            var annual = workingMine.CurrentValue * (metadata.DividendYieldPct.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        workingMine.Holdings = $"{units:N2} units @ {currentNav:N4} NAV";
    }

    private void RecalculateFundManualCost()
    {
        ComputeGrowth();
    }

    private void RecalculateFundManualValue()
    {
        ComputeGrowth();
        workingMine.MonthlyIncome = 0;
    }

    private void RecalculateProperty()
    {
        ComputeGrowth();
        var netRent = Math.Max(0, (metadata.RentalIncomeMonthly ?? 0) - (metadata.MaintenanceCostMonthly ?? 0));
        workingMine.MonthlyIncome = netRent;
        if (!string.IsNullOrWhiteSpace(metadata.PropertyType))
        {
            workingMine.Holdings = $"{metadata.PropertyType} - {metadata.Address}";
        }
    }

    private void RecalculatePreciousMetals()
    {
        var weight = metadata.WeightGrams ?? 0;
        var buybackPricePerG = metadata.BuybackPricePerGram ?? 0;
        if (buybackPricePerG > 0)
        {
            workingMine.CurrentValue = weight * buybackPricePerG;
            ComputeGrowth();
        }
        else
        {
            workingMine.Growth = 0;
            workingMine.GrowthPct = 0;
            workingMine.MonthlyIncome = 0;
        }
        workingMine.Holdings = $"{weight:N1}g {metadata.GoldForm ?? "Gold"}";
    }

    private void RecalculatePreciousMetalManualValue()
    {
        ComputeGrowth();
        workingMine.MonthlyIncome = 0;
    }

    private void RecalculateCrypto()
    {
        ComputeGrowth();
        if (metadata.StakingYieldPct.HasValue && metadata.StakingYieldPct > 0)
        {
            var annual = workingMine.CurrentValue * (metadata.StakingYieldPct.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        if (!string.IsNullOrWhiteSpace(metadata.CoinSymbol))
        {
