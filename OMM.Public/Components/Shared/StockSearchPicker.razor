@namespace OMM.Public.Components.Shared
@using OMM.Public.Models
@using OMM.Public.Services
@inject IKlseStockLookupService StockLookup

<div class="position-relative">
    <div class="search-input-group">
        <i class="ti ti-search"></i>
        <input type="text" autocomplete="off"
               placeholder="@Placeholder"
               value="@searchText"
               @oninput="@(e => OnInput(e.Value?.ToString()))"
               @onfocus="OnFocus"
               @onkeydown="OnKeyDown"
               @onfocusout="OnFocusOut" />
        @if (HasSelection)
        {
            <button type="button" class="btn-clear btn btn-sm btn-link text-muted p-0"
                    @onmousedown:preventDefault="true" @onmousedown="Clear" aria-label="Clear selected stock">
                <i class="ti ti-x"></i>
            </button>
        }
    </div>

    @if (showSuggestions)
    {
        <div class="stk-suggest-panel">
            @if (filtered.Count == 0)
            {
                <div class="stk-suggest-empty">No matches, try a different code or name.</div>
            }
            else
            {
                @for (int i = 0; i < filtered.Count; i++)
                {
                    var idx = i;
                    var s = filtered[idx];
                    <button type="button" class="stk-suggest-item @(idx == highlightIndex ? "active" : "")"
                            @onmousedown:preventDefault="true"
                            @onmousedown="@(() => Select(s))">
                        <span class="stk-suggest-code">@s.Code</span>
                        <span class="stk-suggest-name">@s.Name</span>
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public EventCallback<string> CodeChanged { get; set; }

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public EventCallback<string> NameChanged { get; set; }

    /// <summary>Fires with the full matched record when the user picks a suggestion —
    /// use this later to auto-populate Current Share Price, sector, etc.</summary>
    [Parameter] public EventCallback<KlseStock> OnStockSelected { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Search by stock code or name, e.g. 1155 or Maybank";

    private List<KlseStock> allStocks = [];
    private List<KlseStock> filtered = [];
    private string searchText = "";
    private bool showSuggestions;
    private int highlightIndex = -1;

    private bool HasSelection => !string.IsNullOrWhiteSpace(Code) || !string.IsNullOrWhiteSpace(Name);

    protected override async Task OnInitializedAsync()
    {
        allStocks = (await StockLookup.GetAllAsync()).ToList();
        searchText = Label(Code, Name);
    }

    private static string Label(string code, string name)
    {
        if (string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(name)) return "";
        if (string.IsNullOrWhiteSpace(code)) return name;
        if (string.IsNullOrWhiteSpace(name)) return code;
        return $"{code} — {name}";
    }

    private void OnFocus()
    {
        if (!HasSelection)
        {
            Refilter(searchText);
        }
    }

    private async Task OnInput(string? value)
    {
        searchText = value ?? "";
        highlightIndex = -1;

        // Typing again invalidates whatever was previously confirmed — the read-only
        // Code/Name fields in the parent should go blank until a new pick is made.
        if (HasSelection)
        {
            Code = "";
            Name = "";
            await CodeChanged.InvokeAsync(Code);
            await NameChanged.InvokeAsync(Name);
        }

        Refilter(searchText);
    }

    private void Refilter(string query)
    {
        query = query.Trim();
        if (query.Length == 0)
        {
            filtered = [];
            showSuggestions = false;
            return;
        }

        filtered = allStocks
            .Where(s => s.Code.Contains(query, StringComparison.OrdinalIgnoreCase)
                     || s.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToList();

        showSuggestions = true;
    }

    private async Task Select(KlseStock stock)
    {
        Code = stock.Code;
        Name = stock.Name;
        searchText = Label(Code, Name);

        await CodeChanged.InvokeAsync(Code);
        await NameChanged.InvokeAsync(Name);
        await OnStockSelected.InvokeAsync(stock);

        showSuggestions = false;
        filtered = [];
    }

    private async Task Clear()
    {
        Code = "";
        Name = "";
        searchText = "";
        await CodeChanged.InvokeAsync(Code);
        await NameChanged.InvokeAsync(Name);
        showSuggestions = false;
        filtered = [];
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (!showSuggestions || filtered.Count == 0) return;

        switch (e.Key)
        {
            case "ArrowDown":
                highlightIndex = Math.Min(highlightIndex + 1, filtered.Count - 1);
                break;
            case "ArrowUp":
                highlightIndex = Math.Max(highlightIndex - 1, 0);
                break;
            case "Enter" when highlightIndex >= 0:
                _ = Select(filtered[highlightIndex]);
                break;
            case "Escape":
                showSuggestions = false;
                break;
        }
    }

    private async Task OnFocusOut()
    {
        await Task.Delay(120);
        showSuggestions = false;
        StateHasChanged();
    }
}
