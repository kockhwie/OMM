            <!-- Hero Visual Card -->
            <div class="row justify-content-center mt-4 pt-3">
                <div class="col-lg-9">
                    <div class="omm-hero-glow animate-fade-up" style="animation-delay: 0.4s;">
                        <div class="omm-card p-4 p-md-5 shadow-lg border-0" style="border-radius: 20px;">
                            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                                <div>
                                    <span class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Net Wealth Snapshot</span>
                                    <div class="h2 font-display fw-bold text-dark mb-0 mt-1">
                                        <span data-counter-target="535100" data-counter-prefix="RM " data-counter-duration="1500">RM 0</span>
                                    </div>
                                </div>
                                <div class="text-md-end">
                                    <span class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Freedom Ratio</span>
                                    <div class="h2 font-display fw-bold text-success mb-0 mt-1">
                                        <span data-counter-target="22" data-counter-suffix="%" data-counter-duration="1200">0%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3" style="background-color: var(--omm-ink-50);">
                                        <div class="d-flex align-items-center gap-2 text-muted mb-1" style="font-size: 0.8rem;">
                                            <i class="ti ti-shovel fs-4 omm-icon-interactive"></i>
                                            <span>Total Mines</span>
                                        </div>
                                        <div class="fw-bold fs-5 text-dark">RM 945k</div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 rounded-3" style="background-color: var(--omm-ink-50);">
                                        <div class="d-flex align-items-center gap-2 text-muted mb-1" style="font-size: 0.8rem;">
                                            <i class="ti ti-scale omm-icon-interactive"></i>
                                            <span>Total Burdens</span>
                                        </div>
                                        <div class="fw-bold fs-5 text-dark">RM 409k</div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 rounded-3" style="background-color: var(--omm-ink-50);">
                                        <div class="d-flex align-items-center gap-2 text-muted mb-1" style="font-size: 0.8rem;">
                                            <i class="ti ti-trending-up omm-icon-interactive"></i>
