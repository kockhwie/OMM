@page "/admin/members"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using OMM.Admin.Services.Admin
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "RequireAdminRole")]

@inject IPublicMemberManagementService MemberManagementService
@inject IJSRuntime JS

<PageTitle>Public Members - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 font-display">Public Members</h1>
            <p class="text-muted mb-0">Member accounts registered through the public application.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
            <i class="ti ti-users me-1"></i> Public Identity
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-4" role="alert">
            <i class="ti ti-alert-circle fs-5"></i>
            <div>@_errorMessage</div>
        </div>
    }

    <AdminDataGrid TItem="PublicMemberListDto"
                   Items="@_members"
                   TotalCount="@_members.Count"
                   IsLoading="@_isLoading"
                   SearchPlaceholder="Search username, email or name..."
                   OnSearchChanged="LoadMembersAsync">
        <Columns>
            <GridColumn TItem="PublicMemberListDto" Field="@(member => member.UserName)" Title="Username" Sortable="true">
                <Template Context="member">
                    <div class="d-flex flex-column">
                        <span class="fw-bold text-dark font-monospace">@member.UserName</span>
                        @if (!string.IsNullOrWhiteSpace(member.FirstName) || !string.IsNullOrWhiteSpace(member.LastName))
                        {
                            <span class="text-muted small">@member.FirstName @member.LastName</span>
                        }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn TItem="PublicMemberListDto" Field="@(member => member.Email)" Title="Email" Sortable="true" />
            <GridColumn TItem="PublicMemberListDto" Field="@(member => member.EmailConfirmed)" Title="Email Status">
                <Template Context="member">
                    @if (member.EmailConfirmed)
                    {
                        <span class="badge bg-success-subtle text-success"><i class="ti ti-check me-1"></i>Confirmed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning"><i class="ti ti-clock me-1"></i>Pending</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn TItem="PublicMemberListDto" Field="@(member => member.MustChangePassword)" Title="Password Status">
                <Template Context="member">
                    @if (member.MustChangePassword)
                    {
                        <span class="badge bg-warning-subtle text-warning">Reset Required</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success">Active</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn TItem="PublicMemberListDto" Field="@(member => member.LockoutEnd)" Title="Account Status">
                <Template Context="member">
                    @if (member.LockoutEnd is not null)
                    {
                        <span class="badge bg-danger-subtle text-danger"><i class="ti ti-lock me-1"></i>Locked</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success"><i class="ti ti-lock-open me-1"></i>Active</span>
                    }
                </Template>
            </GridColumn>
        </Columns>
        <ActionColumn Context="member">
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-primary" title="Edit member" @onclick="@(() => OpenEditModal(member))">
                    <i class="ti ti-edit"></i>
                </button>
                <button class="btn btn-outline-warning" title="Require password reset" @onclick="@(() => ForceResetAsync(member.Id))">
                    <i class="ti ti-key"></i>
                </button>
                <button class="btn @(member.LockoutEnd is null ? "btn-outline-danger" : "btn-outline-success")"
                        title="@(member.LockoutEnd is null ? "Lock member" : "Unlock member")"
                        @onclick="@(() => ToggleLockAsync(member))">
                    <i class="ti @(member.LockoutEnd is null ? "ti-lock" : "ti-lock-open")"></i>
                </button>
                <button class="btn btn-outline-danger" title="Delete member" @onclick="@(() => DeleteMemberAsync(member))">
                    <i class="ti ti-trash"></i>
                </button>
            </div>
        </ActionColumn>
    </AdminDataGrid>
</div>

<PublicMemberEditModal IsOpen="@_isEditModalOpen"
                       Member="@_selectedMember"
                       OnSave="HandleSaveMemberAsync"
                       OnClose="CloseEditModal" />

@code {
    private List<PublicMemberListDto> _members = [];
    private bool _isLoading;
    private string? _errorMessage;
    private bool _isEditModalOpen;
    private PublicMemberListDto? _selectedMember;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembersAsync();
    }

    private async Task LoadMembersAsync(string? searchTerm = null)
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _members = (await MemberManagementService.ListAsync(searchTerm)).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load public members: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal(PublicMemberListDto member)
    {
        _selectedMember = member;
        _isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        _isEditModalOpen = false;
        _selectedMember = null;
    }

    private async Task HandleSaveMemberAsync(PublicMemberUpdateDto dto)
    {
        var result = await MemberManagementService.UpdateAsync(dto);
        await HandleResultAsync(result, "Member updated successfully.");
        if (result.Succeeded)
        {
            CloseEditModal();
        }
    }

    private async Task ForceResetAsync(string memberId)
    {
        var result = await MemberManagementService.ForcePasswordResetAsync(memberId);
        await HandleResultAsync(result, "Password reset required.");
    }

    private async Task ToggleLockAsync(PublicMemberListDto member)
    {
        var result = await MemberManagementService.SetLockoutAsync(member.Id, member.LockoutEnd is null);
        await HandleResultAsync(result, member.LockoutEnd is null ? "Member locked." : "Member unlocked.");
    }

    private async Task DeleteMemberAsync(PublicMemberListDto member)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Permanently delete public member '{member.UserName}'?");
        if (!confirmed)
        {
            return;
        }

        var result = await MemberManagementService.DeleteAsync(member.Id);
        await HandleResultAsync(result, "Member deleted.");
    }

    private async Task HandleResultAsync(Microsoft.AspNetCore.Identity.IdentityResult result, string successMessage)
    {
        _errorMessage = result.Succeeded ? null : string.Join(" ", result.Errors.Select(error => error.Description));
        if (result.Succeeded)
        {
            await LoadMembersAsync();
        }
    }
}
