@page "/admin/klse-stocks"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using OMM.Admin.Data
@inject MasterDataDbContext DbContext

<PageTitle>KLSE Stocks - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">KLSE Stocks</h1>
            <p class="text-muted mb-0">Manage Malaysian equity securities, tickers, markets, and fundamentals.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshData" disabled="@_isLoading">
                <i class="ti ti-refresh me-1 @(_isLoading ? "ti-spin" : "")"></i> Refresh
            </button>
            <button class="btn btn-sm btn-danger opacity-75" disabled title="Full Add/Edit form arrives in Phase 5">
                <i class="ti ti-plus me-1"></i> Add Stock <span class="badge bg-dark ms-1">Phase 5</span>
            </button>
        </div>
    </div>

    <!-- Active Filters / Summary Row -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary p-2 rounded-2">
                        <i class="ti ti-chart-candle fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Securities</div>
                        <div class="h5 fw-bold mb-0">@_totalCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success p-2 rounded-2">
                        <i class="ti ti-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Active Listings</div>
                        <div class="h5 fw-bold mb-0">@_activeCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning p-2 rounded-2">
                        <i class="ti ti-moon fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Shariah Compliant</div>
                        <div class="h5 fw-bold mb-0">@_shariahCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-danger-subtle text-danger p-2 rounded-2">
                        <i class="ti ti-building-bank fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Markets</div>
                        <div class="h5 fw-bold mb-0">MAIN / ACE / LEAP</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DataGrid -->
    <AdminDataGrid TItem="Stock"
                   Items="@_stocks"
                   TotalCount="@_totalCount"
                   @bind-PageSize="@_pageSize"
                   @bind-CurrentPage="@_currentPage"
                   IsLoading="@_isLoading"
                   ServerSide="true"
                   SearchPlaceholder="Search code, name, ticker..."
                   OnSearchChanged="HandleSearchChanged"
                   OnSortChanged="HandleSortChanged"
                   OnPageChanged="HandlePageChanged"
                   OnPageSizeChanged="HandlePageSizeChanged">

        <Columns>
            <GridColumn TItem="Stock" Field="@(s => s.StockCode)" Title="Code" Sortable="true">
                <Template Context="stock">
                    <span class="badge bg-light text-dark font-monospace fw-bold border px-2 py-1">
                        @stock.StockCode
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.ShortName_EN)" Title="Security Name" Sortable="true">
                <Template Context="stock">
                    <div class="d-flex flex-column">
                        <span class="fw-bold text-dark">@stock.ShortName_EN</span>
                        @if (!string.IsNullOrEmpty(stock.RicCode) || !string.IsNullOrEmpty(stock.LegalName_EN))
                        {
                            <span class="text-muted small font-monospace">
                                @(stock.RicCode ?? stock.LegalName_EN)
                            </span>
                        }
                    </div>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Title="Market" SortKey="Market" Sortable="true">
                <Template Context="stock">
                    <span class="badge @(stock.Market?.MarketCode == "MAIN" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                        @(stock.Market?.MarketCode ?? "-")
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Title="Sector" SortKey="Sector" Sortable="true">
                <Template Context="stock">
                    <span class="text-muted small">
                        @(stock.Sector?.SectorName_EN ?? "Unclassified")
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.CurrentPrice)" Title="Price (MYR)" Sortable="true">
                <Template Context="stock">
                    <span class="font-monospace fw-semibold">
                        @(stock.CurrentPrice.HasValue ? stock.CurrentPrice.Value.ToString("N3") : "-")
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.ShariahCompliant)" Title="Shariah" Sortable="true">
                <Template Context="stock">
                    @if (stock.ShariahCompliant)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="ti ti-check me-1"></i> Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border">No</span>
                    }
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.IsActive)" Title="Status" Sortable="true">
                <Template Context="stock">
                    @if (stock.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                    }
                </Template>
            </GridColumn>
        </Columns>

        <ActionColumn Context="stock">
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" title="Edit in Phase 5" disabled>
                    <i class="ti ti-edit"></i>
                </button>
                <button class="btn btn-outline-danger" title="Delete in Phase 5" disabled>
                    <i class="ti ti-trash"></i>
                </button>
            </div>
        </ActionColumn>

        <EmptyTemplate>
            <div class="text-center py-5">
                <div class="stat-icon-wrapper bg-light text-muted mx-auto mb-3" style="width: 54px; height: 54px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="ti ti-search-off"></i>
                </div>
                <h5 class="fw-bold mb-1">No matching stocks found</h5>
                <p class="text-muted small mb-0">Check your search query or clear the filter to view all securities.</p>
            </div>
        </EmptyTemplate>
    </AdminDataGrid>
</div>

@code {
    private List<Stock> _stocks = [];
    private int _totalCount;
    private int _activeCount;
    private int _shariahCount;
    private int _pageSize = 20;
    private int _currentPage = 1;
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _sortColumn = "StockCode";
    private SortDirection _sortDirection = SortDirection.Ascending;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryCounts();
        await LoadData();
    }

    private async Task LoadSummaryCounts()
    {
        try
        {
            _activeCount = await DbContext.Stocks.CountAsync(s => s.IsActive);
            _shariahCount = await DbContext.Stocks.CountAsync(s => s.ShariahCompliant);
        }
        catch
        {
            // Ignore if metrics calculation fails
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var query = DbContext.Stocks
                .AsNoTracking()
                .Include(s => s.Market)
                .Include(s => s.Sector)
                .AsQueryable();

            // Search Filter
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                query = query.Where(s =>
                    s.StockCode.ToLower().Contains(term) ||
                    s.ShortName_EN.ToLower().Contains(term) ||
                    (s.RicCode != null && s.RicCode.ToLower().Contains(term)) ||
                    (s.LegalName_EN != null && s.LegalName_EN.ToLower().Contains(term)));
            }

            _totalCount = await query.CountAsync();

            // Sorting
            query = (_sortColumn, _sortDirection) switch
            {
                ("StockCode", SortDirection.Ascending) => query.OrderBy(s => s.StockCode),
                ("StockCode", SortDirection.Descending) => query.OrderByDescending(s => s.StockCode),
                ("ShortName_EN", SortDirection.Ascending) => query.OrderBy(s => s.ShortName_EN),
                ("ShortName_EN", SortDirection.Descending) => query.OrderByDescending(s => s.ShortName_EN),
                ("Market", SortDirection.Ascending) => query.OrderBy(s => s.Market.MarketCode),
                ("Market", SortDirection.Descending) => query.OrderByDescending(s => s.Market.MarketCode),
                ("Sector", SortDirection.Ascending) => query.OrderBy(s => s.Sector != null ? s.Sector.SectorName_EN : string.Empty),
                ("Sector", SortDirection.Descending) => query.OrderByDescending(s => s.Sector != null ? s.Sector.SectorName_EN : string.Empty),
                ("CurrentPrice", SortDirection.Ascending) => query.OrderBy(s => s.CurrentPrice),
                ("CurrentPrice", SortDirection.Descending) => query.OrderByDescending(s => s.CurrentPrice),
                ("ShariahCompliant", SortDirection.Ascending) => query.OrderBy(s => s.ShariahCompliant),
                ("ShariahCompliant", SortDirection.Descending) => query.OrderByDescending(s => s.ShariahCompliant),
                ("IsActive", SortDirection.Ascending) => query.OrderBy(s => s.IsActive),
                ("IsActive", SortDirection.Descending) => query.OrderByDescending(s => s.IsActive),
                _ => query.OrderBy(s => s.StockCode)
            };

            // Paging
            _stocks = await query
                .Skip((_currentPage - 1) * _pageSize)
                .Take(_pageSize)
                .ToListAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadSummaryCounts();
        await LoadData();
    }

    private async Task HandleSearchChanged(string term)
    {
        _searchTerm = term;
        _currentPage = 1;
        await LoadData();
    }

    private async Task HandleSortChanged(SortChangedArgs args)
    {
        _sortColumn = string.IsNullOrEmpty(args.ColumnKey) ? "StockCode" : args.ColumnKey;
        _sortDirection = args.Direction;
        _currentPage = 1;
        await LoadData();
    }

    private async Task HandlePageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _currentPage = 1;
        await LoadData();
    }
}
