                                    @if (simTaxEnabled)
                                    {
                                        <div class="row g-2 mt-1">
                                            <div class="col-6">
                                                <label class="form-label text-muted" for="sim-div-tax">Dividend Tax Rate</label>
                                                <div class="dc-currency-group">
                                                    <input id="sim-div-tax" type="number" class="form-control" min="0" max="100" step="1"
                                                           placeholder="15" @bind="simDividendTaxRate" @bind:event="oninput" />
