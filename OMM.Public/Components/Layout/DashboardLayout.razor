@inherits LayoutComponentBase
@implements IDisposable
@inject IMinerProfileService ProfileService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

    <div class="dashboard-layout d-flex min-vh-100">
    @if (!requiresOnboarding)
    {
    <!-- Desktop Sidebar -->
    <aside class="dashboard-sidebar d-none d-lg-flex flex-column position-fixed top-0 bottom-0 start-0 bg-white border-end @(isDesktopSidebarCollapsed ? "is-collapsed" : string.Empty)">
        <div class="dashboard-sidebar-brand d-flex align-items-center px-3 border-bottom" style="height: 64px;">
            <Logo Size="sm" Href="/" TaglineTwoLines="true" />
        </div>
        <button type="button" class="dashboard-sidebar-collapse-toggle" @onclick="ToggleDesktopSidebar" aria-label="@(isDesktopSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" title="@(isDesktopSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" data-bs-toggle="tooltip" data-bs-placement="right">
            <i class="ti @(isDesktopSidebarCollapsed ? "ti-chevron-right" : "ti-chevron-left")"></i>
        </button>

        <nav class="flex-grow-1 px-3 py-3 overflow-y-auto d-flex flex-column gap-1">
            <NavLink class="sidebar-link" href="dashboard" Match="NavLinkMatch.All" data-bs-toggle="tooltip" data-bs-placement="right" title="Mine Board">
                <i class="ti ti-layout-dashboard fs-5 sidebar-icon-dashboard"></i>
                <span class="dashboard-sidebar-label">Mine Board</span>
            </NavLink>
            <NavLink class="sidebar-link" href="mines" data-bs-toggle="tooltip" data-bs-placement="right" title="My Mines">
                <i class="ti ti-shovel fs-5 sidebar-icon-mines"></i>
                <span class="dashboard-sidebar-label">My Mines</span>
            </NavLink>
            <NavLink class="sidebar-link" href="burdens" data-bs-toggle="tooltip" data-bs-placement="right" title="Burdens">
                <i class="ti ti-scale fs-5 sidebar-icon-burdens"></i>
                <span class="dashboard-sidebar-label">Burdens</span>
            </NavLink>
            <NavLink class="sidebar-link" href="income" data-bs-toggle="tooltip" data-bs-placement="right" title="Income">
                <i class="ti ti-trending-up fs-5 sidebar-icon-income"></i>
                <span class="dashboard-sidebar-label">Income</span>
            </NavLink>
            <NavLink class="sidebar-link" href="goals" data-bs-toggle="tooltip" data-bs-placement="right" title="Goals">
                <i class="ti ti-target fs-5 sidebar-icon-goals"></i>
                <span class="dashboard-sidebar-label">Goals</span>
            </NavLink>
            <NavLink class="sidebar-link" href="expenses" data-bs-toggle="tooltip" data-bs-placement="right" title="Expenses">
                <i class="ti ti-receipt fs-5 sidebar-icon-expenses"></i>
                <span class="dashboard-sidebar-label">Expenses</span>
            </NavLink>
            <NavLink class="sidebar-link" href="dashboard/tools" data-bs-toggle="tooltip" data-bs-placement="right" title="Tools">
                <i class="ti ti-calculator fs-5 sidebar-icon-tools"></i>
                <span class="dashboard-sidebar-label">Tools</span>
            </NavLink>
            <NavLink class="sidebar-link" href="learn" data-bs-toggle="tooltip" data-bs-placement="right" title="Learn">
                <i class="ti ti-book fs-5 sidebar-icon-learn"></i>
                <span class="dashboard-sidebar-label">Learn</span>
            </NavLink>
        </nav>

        <div class="dashboard-sidebar-footer border-top">
            <NavLink class="sidebar-link" href="settings" data-bs-toggle="tooltip" data-bs-placement="right" title="Settings">
                <i class="ti ti-settings fs-5 sidebar-icon-settings"></i>
                <span class="dashboard-sidebar-label">Settings</span>
            </NavLink>

            <form action="Account/Logout" method="post" class="w-100">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="/" />
                <button type="submit" class="sidebar-link sidebar-logout w-100 text-start" data-bs-toggle="tooltip" data-bs-placement="right" title="Sign Out" aria-label="Sign Out">
                    <i class="ti ti-logout fs-5 sidebar-icon-signout"></i>
                    <span class="dashboard-sidebar-label">Sign Out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Mobile Sidebar Offcanvas -->
    @if (isMobileNavOpen)
    {
        <div class="dashboard-mobile-overlay position-fixed top-0 bottom-0 start-0 end-0 d-lg-none" style="z-index: 1040;">
            <div class="position-absolute top-0 bottom-0 start-0 end-0 bg-dark opacity-50" @onclick="ToggleMobileNav"></div>
            <div class="dashboard-mobile-sidebar position-relative bg-white h-100 d-flex flex-column" style="width: 280px;">
                <div class="dashboard-sidebar-brand d-flex align-items-center justify-content-between ps-3 pe-2 border-bottom" style="height: 64px;">
                    <Logo Size="sm" Href="/" TaglineTwoLines="true" />
                    <button class="dashboard-sidebar-close btn btn-sm" @onclick="ToggleMobileNav" aria-label="Close navigation">
                        <i class="ti ti-x fs-4"></i>
                    </button>
                </div>
                <nav class="px-3 py-3 overflow-y-auto d-flex flex-column gap-1">
                    <NavLink class="sidebar-link" href="dashboard" Match="NavLinkMatch.All" @onclick="ToggleMobileNav">
                        <i class="ti ti-layout-dashboard fs-5 sidebar-icon-dashboard"></i>
                        <span>Mine Board</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="mines" @onclick="ToggleMobileNav">
                        <i class="ti ti-shovel fs-5 sidebar-icon-mines"></i>
                        <span>My Mines</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="burdens" @onclick="ToggleMobileNav">
                        <i class="ti ti-scale fs-5 sidebar-icon-burdens"></i>
                        <span>Burdens</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="income" @onclick="ToggleMobileNav">
                        <i class="ti ti-trending-up fs-5 sidebar-icon-income"></i>
                        <span>Income</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="goals" @onclick="ToggleMobileNav">
                        <i class="ti ti-target fs-5 sidebar-icon-goals"></i>
                        <span>Goals</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="expenses" @onclick="ToggleMobileNav">
                        <i class="ti ti-receipt fs-5 sidebar-icon-expenses"></i>
                        <span>Expenses</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="dashboard/tools" @onclick="ToggleMobileNav">
                        <i class="ti ti-calculator fs-5 sidebar-icon-tools"></i>
                        <span>Tools</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="learn" @onclick="ToggleMobileNav">
                        <i class="ti ti-book fs-5 sidebar-icon-learn"></i>
                        <span>Learn</span>
                    </NavLink>
                </nav>
                <div class="dashboard-sidebar-footer border-top">
                    <NavLink class="sidebar-link" href="settings" @onclick="ToggleMobileNav">
                        <i class="ti ti-settings fs-5 sidebar-icon-settings"></i>
                        <span>Settings</span>
                    </NavLink>
                    <form action="Account/Logout" method="post" class="w-100">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="sidebar-link sidebar-logout w-100 text-start">
                            <i class="ti ti-logout fs-5 sidebar-icon-signout"></i>
                            <span>Sign Out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    }

    <!-- Main Content Area -->
    <div class="flex-grow-1 d-flex flex-column dashboard-content-wrapper @(isDesktopSidebarCollapsed ? "sidebar-collapsed" : string.Empty)">
        <!-- Top Bar -->
        <header class="sticky-top bg-white bg-opacity-95 border-bottom px-4 px-lg-5 d-flex align-items-center justify-content-between" 
                style="height: 64px; backdrop-filter: blur(8px); z-index: 1010; width: 100%;">
            <div class="d-flex align-items-center gap-3">
                @if (!requiresOnboarding)
                {
                    <button class="btn btn-sm d-lg-none p-1 text-dark border-0" @onclick="ToggleMobileNav" aria-label="Open navigation">
                        <i class="ti ti-menu-2 fs-4"></i>
                    </button>
                }
                <div class="d-none d-sm-flex search-input-group" style="width: 100%; max-width: 320px; min-width: 160px;">
                    <i class="ti ti-search"></i>
                    <input type="text" placeholder="Search mines, burdens..." />
                </div>
            </div>

            <div class="dashboard-topbar-actions d-flex align-items-center position-relative">
                @if (!requiresOnboarding && profile != null)
                {
                    <a href="settings" class="dashboard-profile-card d-flex align-items-center text-decoration-none flex-shrink-0"
                       title="Account Settings (@profile.Name)">
                        <div class="dashboard-profile-details" aria-hidden="true">
                            <div class="fw-semibold text-dark text-truncate">@profile.Name</div>
                            <div class="text-muted text-truncate">@profile.Email</div>
                        </div>
                        <div class="dashboard-profile-avatar flex-shrink-0">
                            @GetInitials(profile.Name)
                        </div>
                    </a>
                }

                <!-- Stealth Mode Toggle -->
                <button class="dashboard-topbar-action btn-stealth-toggle @(isStealthMode ? "active" : "")" 
                        @onclick="ToggleStealthMode" 
                        title="@(isStealthMode ? "Stealth Mode active: click to unhide amounts" : "Enable Stealth Mode (hide amounts in public)")" 
                        aria-label="Toggle Stealth Mode">
                    <i class="ti @(isStealthMode ? "ti-eye-off" : "ti-eye")"></i>
                </button>

                <!-- Notification Bell -->
                <div class="position-relative">
                    <button class="dashboard-topbar-action position-relative" 
                            @onclick="ToggleNotifDropdown" 
                            aria-label="Notifications">
                        <i class="ti ti-bell"></i>
                        @if (unreadNotifCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        }
                    </button>

                    @if (isNotifOpen)
                    {
                        <div class="position-fixed top-0 bottom-0 start-0 end-0" style="z-index: 1050;" @onclick="ToggleNotifDropdown"></div>
                        <div class="position-absolute end-0 mt-2 omm-card shadow-lg bg-white overflow-hidden" 
                             style="width: 320px; z-index: 1060; border-radius: 16px;">
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light">
                                <span class="fw-bold" style="font-size: 0.85rem;">Notifications</span>
                                <span class="badge bg-danger-subtle text-danger" style="font-size: 0.75rem;">@unreadNotifCount new</span>
                            </div>
                            <div class="overflow-y-auto" style="max-height: 320px;">
                                @if (notifications != null)
                                {
                                    @foreach (var n in notifications)
                                    {
                                        <div class="p-3 border-bottom @(!n.Read ? "bg-warning-subtle bg-opacity-25" : "")">
                                            <div class="d-flex gap-2">
                                                @if (!n.Read)
                                                {
                                                    <span class="rounded-circle bg-warning mt-1" style="width: 8px; height: 8px; flex-shrink: 0;"></span>
                                                }
                                                <div>
                                                    <div class="fw-semibold text-dark" style="font-size: 0.825rem;">@n.Title</div>
                                                    <div class="text-muted mt-1" style="font-size: 0.75rem; line-height: 1.4;">@n.Body</div>
                                                    <div class="text-muted mt-1" style="font-size: 0.7rem;">@n.Date</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <form action="Account/Logout" method="post" class="d-inline m-0">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="/" />
                    <button type="submit" class="dashboard-signout-button" title="Sign Out">
                        <i class="ti ti-logout"></i>
                    </button>
                </form>
            </div>
        </header>

        <!-- Dynamic Body Container -->
        <main class="flex-grow-1 px-4 px-lg-5 py-4 w-100" style="max-width: 1800px;">
            @Body
        </main>
    </div>
</div>

@code {
    private MinerProfile? profile;
    private List<Notification>? notifications;
    private bool isMobileNavOpen = false;
    private bool isDesktopSidebarCollapsed = false;
    private bool isNotifOpen = false;
    private bool isStealthMode = false;
    private bool requiresOnboarding = true;
    private int unreadNotifCount => notifications?.Count(n => !n.Read) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;

        var currentProfile = await ProfileService.GetCurrentAsync();
        profile = currentProfile is null
            ? new MinerProfile()
            : new MinerProfile
            {
                Name = currentProfile.DisplayName ?? currentProfile.Email,
                Email = currentProfile.Email,
                Country = currentProfile.CountryName ?? string.Empty,
                Currency = currentProfile.CurrencyCode ?? string.Empty,
                Language = currentProfile.Language ?? string.Empty,
                JoinedDate = currentProfile.CreatedAt.ToString("yyyy-MM-dd")
            };

        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', 2)[0]
            .Trim('/');
        var isOnboardingRoute = string.Equals(currentPath, "onboarding", StringComparison.OrdinalIgnoreCase);
        requiresOnboarding = currentProfile is null
            || !currentProfile.CurrencyId.HasValue
            || !currentProfile.CountryId.HasValue
            || string.IsNullOrWhiteSpace(currentProfile.DisplayName)
            || currentProfile.OnboardingStatus != OMM.Public.Data.Entities.OnboardingStatus.Completed;

        if (!isOnboardingRoute && requiresOnboarding)
        {
            NavigationManager.NavigateTo("/onboarding", replace: true);
            return;
        }

        await NotificationService.GenerateAsync();
        notifications = (await NotificationService.GetAsync()).ToList();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(args.Location)
            .Split('?', 2)[0]
            .Trim('/');
        var isOnboardingRoute = string.Equals(currentPath, "onboarding", StringComparison.OrdinalIgnoreCase);

        if (requiresOnboarding && !isOnboardingRoute)
        {
            NavigationManager.NavigateTo("/onboarding", replace: true);
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isStealthMode = await JS.InvokeAsync<bool>("ommStealth.init");
                StateHasChanged();
            }
            catch
            {
                // Non-fatal if JS not ready
            }
        }
    }

    private async Task ToggleStealthMode()
    {
        try
        {
            isStealthMode = await JS.InvokeAsync<bool>("ommStealth.toggle");
        }
        catch
        {
            isStealthMode = !isStealthMode;
        }
    }

    private void ToggleMobileNav() => isMobileNavOpen = !isMobileNavOpen;
    private void ToggleDesktopSidebar() => isDesktopSidebarCollapsed = !isDesktopSidebarCollapsed;
    private void ToggleNotifDropdown() => isNotifOpen = !isNotifOpen;

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "M";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0]));
    }
}
