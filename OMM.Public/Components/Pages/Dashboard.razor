@page "/dashboard"
@layout DashboardLayout
@attribute [Authorize]
@inject DashboardQueryService DashboardQuery
@inject INotificationService NotificationService
@inject IJSRuntime JS
@namespace OMM.Public.Components.Pages

<PageTitle>Mine Board Overview - OhMyMine</PageTitle>

@if (snapshot == null)
{
    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Loading Mine Board...</span>
        </div>
    </div>
}
else
{
    <!-- Page Header -->
    <div class="mb-4">
        <p class="text-muted mb-1" style="font-size: 0.875rem;">Welcome back, @(profile.Name.Split(' ')[0])</p>
        <h1 class="h3 font-display fw-bold text-dark mb-0">Mine Board Overview</h1>
    </div>

    @if (IsZeroData)
    {
        <div class="mb-4">
            <DashboardEmptyState />
        </div>
    }
    else if (ProfileNeedsSetup)
    {
        <div class="omm-card p-4 mb-4 border-warning-subtle">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Complete your profile</h2>
                    <p class="text-muted mb-0">Add your country and base currency so your dashboard can present your records correctly.</p>
                </div>
                <a class="btn btn-outline-dark rounded-3" href="/settings">Complete profile</a>
            </div>
        </div>
    }

    <!-- Key Metrics Grid -->
    <div class="row g-3 mb-4">
        <!-- Net Wealth -->
        <div class="col-sm-6 col-xl-3">
            <MetricCard Title="Net Wealth"
                        Value="@FormatSummaryAmount(summary.NetWealth)"
                        NumericTarget="@(summary.HasMixedCurrencies ? null : summary.NetWealth)"
                        Icon="ti-sparkles"
                        Variant="gold"
                        Subtitle="@($"{FormatSummaryAmount(summary.TotalMines)} mines − {FormatSummaryAmount(summary.TotalBurdens)} burdens")" />
        </div>

        <!-- Total Mines -->
        <div class="col-sm-6 col-xl-3">
            <MetricCard Title="Total Mines"
                        Value="@FormatSummaryAmount(summary.TotalMines)"
                        NumericTarget="@(summary.HasMixedCurrencies ? null : summary.TotalMines)"
                        Icon="ti-shovel"
                        Variant="mine"
                        Subtitle="@($"{allMines?.Count ?? 0} active wealth mines")" />
        </div>

        <!-- Passive Income -->
        <div class="col-sm-6 col-xl-3">
            <MetricCard Title="Passive / month"
                        Value="@FormatSummaryAmount(summary.PassiveIncomeMonthly)"
                        NumericTarget="@(summary.HasMixedCurrencies ? null : summary.PassiveIncomeMonthly)"
                        Icon="ti-trending-up"
                        Variant="mine"
                        Subtitle="@($"vs {FormatSummaryAmount(summary.RecurringExpensesMonthly)} recurring exp.")" />
        </div>

        <!-- Total Growth -->
        <div class="col-sm-6 col-xl-3">
            <MetricCard Title="Total Growth"
                        Value="@FormatSummaryAmount(summary.TotalGrowth)"
                        NumericTarget="@(summary.HasMixedCurrencies ? null : summary.TotalGrowth)"
                        Icon="@(summary.TotalGrowth >= 0 ? "ti-trending-up" : "ti-trending-down")"
                        Variant="@(summary.TotalGrowth >= 0 ? "mine" : "burden")"
                        Trend="@FormatHelper.FormatPercent(summary.TotalGrowthPct)"
                        TrendPositive="@(summary.TotalGrowth >= 0)"
                        Subtitle="across all active mines" />
        </div>
    </div>

    <!-- Visual Command Center: Freedom Speedometer + Asset Breakdown Donut -->
    <div class="row g-4 mb-4">
        <!-- Freedom Speedometer Gauge -->
        <div class="col-12 col-lg-5 col-xl-4">
            <FreedomGauge Percentage="@summary.FreedomRatio" 
                          PassiveMonthly="@summary.PassiveIncomeMonthly" 
                          RecurringMonthly="@summary.RecurringExpensesMonthly" />
        </div>

        <!-- Asset Allocation & Burden Breakdown Donut -->
        <div class="col-12 col-lg-7 col-xl-8">
            @if (HasNoMinesAndBurdens)
            {
                <DashboardSectionEmptyState Icon="ti-chart-donut" Title="Your wealth picture starts here" Description="Add a mine or burden to see your asset and liability breakdown." Href="/mines" ActionText="Add a mine" />
            }
            else
            {
                <WealthBreakdownChart Mines="@allMines"
                                      TotalMines="@summary.TotalMines"
                                      TotalBurdens="@summary.TotalBurdens" />
            }
        </div>
    </div>

    <!-- Main Content 2-Column Grid -->
    <div class="row g-4">
        <!-- Left: Top Mines by Value -->
        <div class="col-lg-8">
            <div class="omm-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-display fw-bold text-dark mb-0">Top Mines by Value</h5>
                    <a href="mines" class="text-decoration-none text-muted fw-semibold d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                        View all <i class="ti ti-chevron-right"></i>
                    </a>
                </div>

                @if (topMines is { Count: > 0 })
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var mine in topMines)
                        {
                            <a href="@($"mines/{mine.Id}")" class="text-decoration-none text-dark">
                                <div class="d-flex align-items-center gap-3 p-3 rounded-3 omm-card-hover" style="background-color: var(--omm-ink-50);">
                                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-white p-2 text-dark shadow-sm" style="width: 40px; height: 40px; flex-shrink: 0;">
                                        <i class="ti @FormatHelper.CategoryToIcon(mine.Category) fs-5"></i>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size: 0.9rem;">@mine.Name</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.75rem;">@mine.Category · @mine.Type</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold" style="font-size: 0.9rem;">@FormatHelper.FormatCurrency(mine.CurrentValue, mine.Currency)</div>
                                        <div class="@(mine.Growth >= 0 ? "text-success" : "text-danger") fw-semibold" style="font-size: 0.75rem;">
                                            @FormatHelper.FormatPercent(mine.GrowthPct)
                                        </div>
                                    </div>
                                    <i class="ti ti-chevron-right text-muted"></i>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <DashboardSectionEmptyState Icon="ti-shovel" Title="No mines yet" Description="Your first mine gives the dashboard something real to track." Href="/mines" ActionText="Add a mine" />
                }
            </div>

            <!-- Notifications & Upcoming Maturities -->
            <div class="omm-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-display fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="ti ti-bell text-muted"></i> Notifications & Maturities
                    </h5>
                </div>

                <div class="d-flex flex-column gap-2">
                    @if (notifications != null)
                    {
                        @foreach (var n in notifications.Take(2))
                        {
                            <div class="p-3 rounded-3 border @(!n.Read ? "border-warning-subtle" : "border-light")" 
                                 style="background-color: @(!n.Read ? "var(--omm-clay-100)" : "var(--omm-ink-50)");">
                                <div class="d-flex align-items-start gap-2">
                                    @if (!n.Read)
                                    {
                                        <span class="rounded-circle mt-1" style="width: 8px; height: 8px; background-color: var(--omm-clay-500); flex-shrink: 0;"></span>
                                    }
                                    <div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@n.Title</div>
                                        <div class="text-muted mt-1" style="font-size: 0.775rem; line-height: 1.4;">@n.Body</div>
                                    </div>
                                    <div class="ms-auto d-flex gap-2">
                                        @if (!n.Read)
                                        {
                                            <button class="btn btn-sm btn-link text-muted p-0" @onclick="() => MarkNotificationRead(n.Id)">Read</button>
                                        }
                                        <button class="btn btn-sm btn-link text-muted p-0" @onclick="() => DismissNotification(n.Id)">Dismiss</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (upcomingMaturities != null)
                    {
                        @foreach (var item in upcomingMaturities)
                        {
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: var(--omm-ink-50);">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ti ti-calendar-time text-warning fs-5"></i>
                                    <div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@item.Mine.Name - @item.SubMine.Label</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">Matures @item.SubMine.MaturityDate</div>
                                    </div>
                                </div>
                                <span class="badge-pill-warning">
                                    @(GetDaysUntil(item.SubMine.MaturityDate)) days
                                </span>
                            </div>
                        }
                    }

                    @if ((notifications?.Count ?? 0) == 0 && (upcomingMaturities?.Count ?? 0) == 0)
                    {
                        <DashboardSectionEmptyState Icon="ti-bell" Title="Nothing needs your attention yet" Description="Notifications will appear when your saved data creates a useful reminder." Href="/mines" ActionText="Review your mines" />
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Goals & Burdens Snapshot -->
        <div class="col-lg-4">
            <!-- Goals Card -->
            <div class="omm-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-display fw-bold text-dark mb-0">Goals</h5>
                    <a href="goals" class="text-decoration-none text-muted fw-semibold d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                        All <i class="ti ti-chevron-right"></i>
                    </a>
                </div>

                @if (goals is { Count: > 0 })
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var goal in goals.Take(3))
                        {
                            var progress = goal.Target > 0 ? Math.Min(100, (goal.Current / goal.Target) * 100) : 0;
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-dark" style="font-size: 0.8rem;">
                                        <i class="ti @FormatHelper.GoalTypeToIcon(goal.Type) text-muted me-1"></i>
                                        @goal.Title
                                    </span>
                                    <span class="fw-bold text-dark" style="font-size: 0.8rem;">@((int)progress)%</span>
                                </div>
                                <ProgressBar Percentage="@progress" 
                                             Variant="@(goal.Status == "on-track" ? "mine" : goal.Status == "needs-attention" ? "warning" : "default")" 
                                             Height="6px" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <DashboardSectionEmptyState Icon="ti-target-arrow" Title="Set your first goal" Description="Turn your next financial milestone into something you can track." Href="/goals" ActionText="Add a goal" />
                }
            </div>

            <!-- Burdens Card -->
            <div class="omm-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-display fw-bold text-dark mb-0">Burdens</h5>
                    <a href="burdens" class="text-decoration-none text-muted fw-semibold d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                        All <i class="ti ti-chevron-right"></i>
                    </a>
                </div>

                @if (burdens is { Count: > 0 })
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var b in burdens.Take(3))
                        {
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 rounded-3 bg-danger-subtle text-danger">
                                        <i class="ti @FormatHelper.BurdenTypeToIcon(b.Type) fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@b.Name</div>
                                        <div class="text-muted" style="font-size: 0.725rem;">@b.Type · @b.InterestRate% p.a.</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold" style="font-size: 0.85rem;">@FormatHelper.FormatCurrency(b.Balance, b.Currency)</div>
                                    <div class="text-muted" style="font-size: 0.725rem;">@FormatHelper.FormatCurrency(b.MonthlyPayment, b.Currency)/mo</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size: 0.775rem;">Total monthly debt service</span>
                        <span class="fw-bold text-dark" style="font-size: 0.9rem;">
                            @FormatSummaryAmount(burdens.Sum(b => b.MonthlyPayment))
                        </span>
                    </div>
                }
                else
                {
                    <DashboardSectionEmptyState Icon="ti-shield-check" Title="No burdens recorded" Description="Add your loans or obligations when you are ready to see the full picture." Href="/burdens" ActionText="Add a burden" />
                }
            </div>
        </div>
    </div>
}

@code {
    private DashboardSnapshot? snapshot;
    private DashboardSummary summary = new();
    private MinerProfile profile = new();
    private List<Mine>? allMines;
    private List<Mine>? topMines;
    private List<Burden>? burdens;
    private List<Goal>? goals;
    private List<Notification>? notifications;
    private List<(Mine Mine, SubMine SubMine)>? upcomingMaturities;

    private bool IsZeroData => (allMines?.Count ?? 0) == 0
        && (burdens?.Count ?? 0) == 0
        && (goals?.Count ?? 0) == 0
        && (snapshot?.IncomeRecords.Count ?? 0) == 0
        && (snapshot?.Expenses.Count ?? 0) == 0;

    private bool HasNoMinesAndBurdens => (allMines?.Count ?? 0) == 0 && (burdens?.Count ?? 0) == 0;

    private bool ProfileNeedsSetup => string.IsNullOrWhiteSpace(profile.Currency)
        || string.IsNullOrWhiteSpace(profile.Country);

    protected override async Task OnInitializedAsync()
    {
        snapshot = await DashboardQuery.GetSnapshotAsync();
        summary = snapshot.Summary;
        profile = snapshot.Profile;
        allMines = snapshot.Mines.ToList();
        topMines = allMines.OrderByDescending(m => m.CurrentValue).Take(4).ToList();
        burdens = snapshot.Burdens.ToList();
        goals = snapshot.Goals.ToList();
        notifications = snapshot.Notifications.ToList();

        upcomingMaturities = allMines
            .Where(m => m.SubMines != null)
            .SelectMany(m => m.SubMines!.Where(s => !string.IsNullOrEmpty(s.MaturityDate)).Select(s => (Mine: m, SubMine: s)))
            .OrderBy(x => x.SubMine.MaturityDate)
            .Take(3)
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("ommCounters.animateDashboard", ".dashboard-content-wrapper");
            }
            catch
            {
                // Non-fatal if script not yet available
            }
        }
    }

    private string GetFreedomLabel(decimal ratio)
    {
        if (ratio >= 100) return "100% - Fully financially free!";
        if (ratio >= 50) return $"{ratio:F0}% - Halfway to freedom";
        if (ratio >= 25) return $"{ratio:F0}% - Building passive runway";
        return $"{ratio:F0}% - Early stage miner";
    }

    private int GetDaysUntil(string? dateStr)
    {
        if (DateTime.TryParse(dateStr, out var date))
        {
            var diff = (date - DateTime.Now).Days;
            return Math.Max(0, diff);
        }
        return 14;
    }

    private string FormatSummaryAmount(decimal amount) => summary.HasMixedCurrencies
        ? "Multiple currencies"
        : FormatHelper.FormatCurrency(amount, summary.Currency);

    private async Task MarkNotificationRead(string id)
    {
        await NotificationService.MarkReadAsync(id);
        notifications = (await NotificationService.GetAsync()).ToList();
    }

    private async Task DismissNotification(string id)
    {
        await NotificationService.DismissAsync(id);
        notifications = (await NotificationService.GetAsync()).ToList();
    }
}
