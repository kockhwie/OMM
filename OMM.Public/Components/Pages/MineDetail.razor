@page "/mines/{Id}"
@layout DashboardLayout
@attribute [Authorize]
@using OMM.Public.Data.Entities
@using OMM.Public.Models
@using OMM.Public.Services
@using OMM.Public.Components.Shared.Mines
@inject DatabaseMineService MineService
@inject NavigationManager Navigation

<PageTitle>@(currentMine?.Name ?? "Mine Detail") - OhMyMine</PageTitle>

@if (currentMine == null)
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 my-5 animate-fade-up">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="ti ti-alert-triangle fs-2 text-warning"></i>
        </div>
        <h2 class="h5 fw-bold text-dark mb-1">Mine Not Found</h2>
        <p class="text-muted small mb-4">The mine you requested could not be located or has been deleted.</p>
        <div>
            <a href="/mines" class="btn btn-outline-dark rounded-3 px-4 fw-medium">
                <i class="ti ti-arrow-left me-1"></i> Back to Mines
            </a>
        </div>
    </div>
}
else
{
    <!-- Breadcrumb / Back Link -->
    <div class="mb-3 animate-fade-up">
        <a href="/mines" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 hover-underline">
            <i class="ti ti-arrow-left"></i>
            <span>Back to all mines</span>
        </a>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-between gap-3 mb-4 animate-fade-up">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-4 bg-dark text-warning p-3 d-flex align-items-center justify-content-center shadow-xs"
                 style="width: 56px; height: 56px;">
                <i class="ti @FormatHelper.MineTypeToIcon(currentMine.Type) fs-2"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold text-dark font-display mb-1">@currentMine.Name</h1>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-light text-dark border">@FormatHelper.CategoryLabel(currentMine.Category)</span>
                    <span class="badge bg-light text-dark border">@FormatHelper.MineTypeLabel(currentMine.Type)</span>
                    <StatusBadge Status="@currentMine.Status" />
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-dark btn-sm rounded-3 px-3 d-inline-flex align-items-center gap-1" @onclick="OpenEditModal">
                <i class="ti ti-edit"></i>
                <span>Edit Mine</span>
            </button>
            <button class="btn btn-outline-danger btn-sm rounded-3 px-3 d-inline-flex align-items-center gap-1" @onclick="ConfirmDelete">
                <i class="ti ti-trash"></i>
                <span>Delete</span>
            </button>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4 animate-fade-up">
        <!-- Current Value -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-2 text-muted mb-2">
                    <i class="ti ti-pick fs-5 text-warning"></i>
                    <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Current Value</span>
                </div>
                <div class="fs-4 fw-bold text-dark font-display">
                    @FormatHelper.FormatCurrency(currentMine.CurrentValue, currentMine.Currency)
                </div>
            </div>
        </div>

        <!-- Purchase Price -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-2 text-muted mb-2">
                    <i class="ti ti-coin fs-5 text-primary"></i>
                    <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Purchase Price</span>
                </div>
                <div class="fs-4 fw-bold text-dark font-display">
                    @FormatHelper.FormatCurrency(currentMine.PurchaseCost, currentMine.Currency)
                </div>
            </div>
        </div>

        <!-- Total Growth -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-2 text-muted mb-2">
                    <i class="ti @(currentMine.Growth >= 0 ? "ti-trending-up text-success" : "ti-trending-down text-danger") fs-5"></i>
                    <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Growth</span>
                </div>
                <div class="fs-4 fw-bold font-display @(currentMine.Growth >= 0 ? "text-success" : "text-danger")">
                    @FormatHelper.FormatCurrency(currentMine.Growth, currentMine.Currency)
                    <span class="fs-6 fw-semibold text-muted ms-1">(@FormatHelper.FormatPercent(currentMine.GrowthPct))</span>
                </div>
            </div>
        </div>

        <!-- Monthly Income -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-2 text-muted mb-2">
                    <i class="ti ti-bolt fs-5 text-success"></i>
                    <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Monthly Income</span>
                </div>
                <div class="fs-4 fw-bold text-dark font-display">
                    @(currentMine.MonthlyIncome > 0 ? FormatHelper.FormatCurrency(currentMine.MonthlyIncome, currentMine.Currency) : FormatHelper.FormatCurrency(0, currentMine.Currency))
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <nav class="mine-detail-tabs mb-4 border-bottom border-light-subtle pb-2 animate-fade-up" aria-label="Mine details sections">
                        <button type="button" class="mine-detail-tab btn btn-sm rounded-3 px-3 py-2 fw-semibold @(activeTab == "overview" ? "btn-dark text-white" : "btn-light text-dark")"
                @onclick="@(() => activeTab = "overview")">
            <i class="ti ti-info-circle me-1"></i> Overview & Details
        </button>
        <button type="button" class="mine-detail-tab btn btn-sm rounded-3 px-3 py-2 fw-semibold @(activeTab == "history" ? "btn-dark text-white" : "btn-light text-dark")"
                @onclick="@(() => activeTab = "history")">
            <i class="ti ti-history me-1"></i> Yield History @(yieldHistories.Count > 0 ? $"({yieldHistories.Count})" : "")
        </button>
        <button type="button" class="mine-detail-tab btn btn-sm rounded-3 px-3 py-2 fw-semibold @(activeTab == "submines" ? "btn-dark text-white" : "btn-light text-dark")"
                @onclick="@(() => activeTab = "submines")">
            <i class="ti ti-layers-intersect me-1"></i> Sub-Mines @(currentMine.SubMines?.Count > 0 ? $"({currentMine.SubMines.Count})" : "")
        </button>
        <button type="button" class="mine-detail-tab btn btn-sm rounded-3 px-3 py-2 fw-semibold @(activeTab == "income" ? "btn-dark text-white" : "btn-light text-dark")"
                @onclick="@(() => activeTab = "income")">
            <i class="ti ti-cash me-1"></i> Income Impact
        </button>
    </nav>

    <!-- Tab Contents -->
    <div class="row g-4">
        @if (activeTab == "overview")
        {
            <!-- Mine Details Card -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up mb-4">
                    <h3 class="h6 fw-bold text-dark font-display mb-3">Mine Specifications</h3>
                    <div class="mine-specifications">
                        <div class="mine-specification-row">
                            <span class="text-muted small">Category</span>
                            <span class="fw-semibold text-dark small">@FormatHelper.CategoryLabel(currentMine.Category)</span>
                        </div>
                        <div class="mine-specification-row">
                            <span class="text-muted small">Asset Type</span>
                            <span class="fw-semibold text-dark small">@FormatHelper.MineTypeLabel(currentMine.Type)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(currentMine.Institution))
                        {
                            <div class="mine-specification-row">
                                <span class="text-muted small">Institution / Platform</span>
                                <span class="fw-semibold text-dark small">@currentMine.Institution</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(currentMine.Holdings))
                        {
                            <div class="mine-specification-row">
                                <span class="text-muted small">Holdings / Volume</span>
                                <span class="fw-semibold text-dark small">@currentMine.Holdings</span>
                            </div>
                        }
                        <div class="mine-specification-row">
                            <span class="text-muted small">Currency</span>
                            <span class="fw-semibold text-dark small">@currentMine.Currency</span>
                        </div>
                        <div class="mine-specification-row">
                            <span class="text-muted small">Last Updated</span>
                            <span class="fw-semibold text-dark small">@currentMine.UpdatedAt</span>
                        </div>
                    </div>
                </div>

                <!-- Asset-Specific Typed Metadata Attributes -->
                @if (currentMine.Metadata != null)
                {
                    var meta = currentMine.Metadata;
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                        <h3 class="h6 fw-bold text-dark font-display mb-3 d-flex align-items-center gap-2">
                            <i class="ti ti-adjustments-alt text-warning"></i>
                            <span>Asset Class Attributes</span>
                        </h3>
                        <div class="d-flex flex-column gap-2">
                            @if (!string.IsNullOrWhiteSpace(meta.AccountType))
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Account Scheme</span>
                                    <span class="fw-semibold text-dark">@meta.AccountType</span>
                                </div>
                            }
                            @if (meta.Akaun1Balance.HasValue || meta.Akaun2Balance.HasValue || meta.Akaun3Balance.HasValue)
                            {
                                <div class="py-2 border-bottom border-light-subtle">
                                    <span class="text-muted small d-block mb-2">EPF Account Tranches</span>
                                    <div class="row g-2 text-center">
                                        <div class="col-4">
                                            <div class="p-2 bg-light rounded-3">
                                                <small class="text-muted d-block" style="font-size: 0.65rem;">Akaun Persaraan (75%)</small>
                                                <span class="fw-bold small text-dark">@FormatHelper.FormatCurrency(meta.Akaun1Balance ?? 0, currentMine.Currency)</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 bg-light rounded-3">
                                                <small class="text-muted d-block" style="font-size: 0.65rem;">Akaun Sejahtera (15%)</small>
                                                <span class="fw-bold small text-dark">@FormatHelper.FormatCurrency(meta.Akaun2Balance ?? 0, currentMine.Currency)</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 bg-light rounded-3">
                                                <small class="text-muted d-block" style="font-size: 0.65rem;">Akaun Fleksibel (10%)</small>
                                                <span class="fw-bold small text-dark">@FormatHelper.FormatCurrency(meta.Akaun3Balance ?? 0, currentMine.Currency)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (meta.UnitsHeld.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Units Owned</span>
                                    <span class="fw-semibold text-dark">@meta.UnitsHeld.Value.ToString("N2") units</span>
                                </div>
                            }
                            @if (meta.NavPerUnit.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">NAV / Price per Unit</span>
                                    <span class="fw-semibold text-dark">@FormatHelper.FormatCurrencyPrecise(meta.NavPerUnit.Value, currentMine.Currency)</span>
                                </div>
                            }
                            @if (meta.InterestRatePct.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Interest / APY Rate</span>
                                    <span class="fw-semibold text-success">@meta.InterestRatePct.Value.ToString("0.00")% p.a.</span>
                                </div>
                            }
                            @if (meta.ExpectedDividendRate.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Expected Annual Dividend</span>
                                    <span class="fw-semibold text-success">@meta.ExpectedDividendRate.Value.ToString("0.00")% p.a.</span>
                                </div>
                            }
                            @if (meta.DividendYieldPct.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Dividend Yield Estimate</span>
                                    <span class="fw-semibold text-success">@meta.DividendYieldPct.Value.ToString("0.00")% p.a.</span>
                                </div>
                            }
                            @if (meta.TenureMonths.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Placement Tenure</span>
                                    <span class="fw-semibold text-dark">@meta.TenureMonths.Value Months</span>
                                </div>
                            }
                            @if (meta.MaturityDate.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Maturity Date</span>
                                    <span class="fw-semibold text-dark">@meta.MaturityDate.Value.ToString("dd MMM yyyy")</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(meta.RolloverBehavior))
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Maturity Rollover</span>
                                    <span class="fw-semibold text-dark">@meta.RolloverBehavior</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(meta.StockCode))
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Stock Symbol / Ticker</span>
                                    <span class="fw-semibold text-dark">@meta.StockCode (@(meta.Exchange ?? "Bursa"))</span>
                                </div>
                            }
                            @if (meta.SharesOwned.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Shares Owned</span>
                                    <span class="fw-semibold text-dark">@meta.SharesOwned.Value.ToString("N0") shares</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(meta.Address))
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Property Location</span>
                                    <span class="fw-semibold text-dark">@meta.Address</span>
                                </div>
                            }
                            @if (meta.RentalIncomeMonthly.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Gross Monthly Rental</span>
                                    <span class="fw-semibold text-success">@FormatHelper.FormatCurrency(meta.RentalIncomeMonthly.Value, currentMine.Currency)/mo</span>
                                </div>
                            }
                            @if (meta.WeightGrams.HasValue)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Weight / Form</span>
                                    <span class="fw-semibold text-dark">@meta.WeightGrams.Value.ToString("N1")g (@(meta.GoldForm ?? "Physical"))</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(meta.CoinSymbol))
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom border-light-subtle small">
                                    <span class="text-muted">Coin / Platform</span>
                                    <span class="fw-semibold text-dark">@meta.CoinsHeld @meta.CoinSymbol (@(meta.WalletOrExchange ?? "Wallet"))</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Linked Burden / Net Equity Position -->
            <div class="col-12 col-lg-5">
                @if (linkedBurden != null)
                {
                    var netEquity = currentMine.CurrentValue - linkedBurden.Balance;
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h3 class="h6 fw-bold text-dark font-display mb-0">Linked Burden</h3>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Liability Linked</span>
                        </div>

                        <div class="p-3 rounded-4 bg-danger-subtle border border-danger-subtle mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="ti @FormatHelper.BurdenTypeToIcon(linkedBurden.Type) text-danger fs-5"></i>
                                <span class="fw-bold text-dark small">@linkedBurden.Name</span>
                            </div>
                            <div class="d-flex flex-column gap-2 text-dark small">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Outstanding balance</span>
                                    <span class="fw-semibold">@FormatHelper.FormatCurrency(linkedBurden.Balance, linkedBurden.Currency)</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Monthly payment</span>
                                    <span class="fw-semibold">@FormatHelper.FormatCurrency(linkedBurden.MonthlyPayment, linkedBurden.Currency)</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Interest rate</span>
                                    <span class="fw-semibold">@linkedBurden.InterestRate% p.a.</span>
                                </div>
                            </div>
                        </div>

                        <!-- Net Equity Calculation -->
                        <div class="p-3 rounded-4 bg-success-subtle border border-success-subtle">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-muted small fw-medium">Net Realizable Equity</div>
                                    <div class="fs-4 fw-bold text-success font-display">
                                        @FormatHelper.FormatCurrency(netEquity, currentMine.Currency)
                                    </div>
                                </div>
                                <a href="/burdens" class="btn btn-sm btn-outline-success rounded-3">Manage</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                        <h3 class="h6 fw-bold text-dark font-display mb-3">Net Position</h3>
                        <div class="p-4 rounded-4 bg-success-subtle border border-success-subtle text-center">
                            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center p-2 mb-2" style="width: 40px; height: 40px;">
                                <i class="ti ti-shield-check fs-4"></i>
                            </div>
                            <div class="text-muted small mb-1">Unencumbered Asset - 100% Equity</div>
                            <div class="fs-3 fw-bold text-success font-display">
                                @FormatHelper.FormatCurrency(currentMine.CurrentValue, currentMine.Currency)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "history")
        {
            <!-- Yield & Rate History Timeline Tab -->
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
                        <div>
                            <h3 class="h6 fw-bold text-dark font-display mb-0">Rate &amp; Dividend History</h3>
                            <p class="text-muted small mb-0">Track year-over-year declared dividend rates, FD renewals, or yield revisions</p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 align-self-start align-self-md-center"
                                @onclick="OpenYieldDeclarationModal">
                            <i class="ti ti-plus"></i>
                            <span>Log Rate Declaration</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(yieldMessage))
                    {
                        <div class="alert @(yieldMessageIsError ? "alert-danger" : "alert-success") rounded-3 d-flex align-items-center gap-2 mb-3 py-2" role="alert">
                            <i class="ti @(yieldMessageIsError ? "ti-alert-triangle" : "ti-circle-check") flex-shrink-0 fs-5"></i>
                            <span class="small">@yieldMessage</span>
                        </div>
                    }

                    @if (yieldHistories.Count > 0)
                    {
                        @if (yieldHistories.Count >= 2)
                        {
                            var newestRecords = yieldHistories
                                .OrderByDescending(record => record.EffectiveYear)
                                .ThenByDescending(record => record.RecordDate)
                                .Take(2)
                                .ToList();
                            var currentRecord = newestRecords[0];
                            var previousRecord = newestRecords[1];
                            var delta = currentRecord.RatePct - previousRecord.RatePct;
                            var relativeGrowth = previousRecord.RatePct != 0
                                ? delta / previousRecord.RatePct * 100m
                                : (decimal?)null;
                            var badgeClass = delta > 0
                                ? "bg-success-subtle text-success border border-success-subtle"
                                : delta < 0
                                    ? "bg-danger-subtle text-danger border border-danger-subtle"
                                    : "bg-light text-muted border";
                            var iconClass = delta > 0
                                ? "ti-trending-up"
                                : delta < 0
                                    ? "ti-trending-down"
                                    : "ti-minus";

                            <div class="mb-3">
                                <span class="badge @badgeClass fw-semibold d-inline-flex align-items-center gap-1">
                                    <i class="ti @iconClass"></i>
                                    @((delta >= 0 ? "+" : "") + delta.ToString("0.00")) percentage points YoY
                                    @if (relativeGrowth.HasValue)
                                    {
                                        <span>(@((relativeGrowth.Value >= 0 ? "+" : "") + relativeGrowth.Value.ToString("0.0"))% growth vs @previousRecord.EffectiveYear)</span>
                                    }
                                </span>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Year</th>
                                        <th>Record Date</th>
                                        <th>Declared Rate</th>
                                        <th>Balance at Time</th>
                                        <th>Annual Return</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in yieldHistories)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-dark fw-bold">@record.EffectiveYear</span>
                                            </td>
                                            <td class="small text-muted">@record.RecordDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <span class="fw-bold text-success">@record.RatePct.ToString("0.00")% p.a.</span>
                                            </td>
                                            <td class="small">
                                                @(record.BalanceAtTime.HasValue ? FormatHelper.FormatCurrency(record.BalanceAtTime.Value, currentMine.Currency) : "—")
                                            </td>
                                            <td class="small fw-semibold text-dark">
                                                @(record.DeclaredAmount.HasValue ? FormatHelper.FormatCurrency(record.DeclaredAmount.Value, currentMine.Currency) : "—")
                                            </td>
                                            <td class="small text-muted">
                                                @(string.IsNullOrWhiteSpace(record.Notes) ? "—" : record.Notes)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="ti ti-history fs-1 mb-2 text-muted"></i>
                            <div class="fw-bold text-dark small">No Yield History Logged Yet</div>
                            <p class="small text-muted mb-3">When you update interest rates or annual dividends via "Edit Mine", check "Record to Yield History timeline" to track past years.</p>
                            <button class="btn btn-outline-dark btn-sm rounded-3 px-3" @onclick="OpenEditModal">
                                <i class="ti ti-edit me-1"></i> Edit Mine to Record Rate
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        else if (activeTab == "submines")
        {
            @if (currentMine.Type == MineType.ForeignCurrency)
            {
                var fxTransactions = currentMine.ForeignCurrencyTransactions ?? [];
                var foreignHeld = fxTransactions.Sum(item => item.TransactionType == ForeignCurrencyTransactionType.Sale ? -item.ForeignAmount : item.ForeignAmount);
                var totalMyrCost = fxTransactions.Sum(item => item.TransactionType == ForeignCurrencyTransactionType.Sale ? -item.MyrAmount : item.MyrAmount + item.FeesMyr);
                var weightedRate = totalMyrCost > 0 ? foreignHeld / totalMyrCost : 0;
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                            <div>
                                <h3 class="h6 fw-bold text-dark font-display mb-1">@currentMine.Metadata?.ForeignCurrencyCode Exchange Lots</h3>
                                <p class="text-muted small mb-0">Record each later exchange without creating another Mine.</p>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm rounded-3" @onclick="OpenForeignTransactionForm">
                                <i class="ti ti-plus me-1"></i> Add Exchange
                            </button>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3">
                                <div class="p-3 rounded-3 bg-light">
                                    <small class="text-muted d-block">Foreign Held</small>
                                    <strong class="text-dark">@foreignHeld.ToString("N2") @currentMine.Metadata?.ForeignCurrencyCode</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 rounded-3 bg-light">
                                    <small class="text-muted d-block">Total MYR Cost</small>
                                    <strong class="text-dark">@FormatHelper.FormatCurrency(totalMyrCost, currentMine.Currency)</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 rounded-3 bg-light">
                                    <small class="text-muted d-block">Weighted Average Rate</small>
                                    <strong class="text-dark">@(weightedRate > 0 ? weightedRate.ToString("0.########") : "—")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 rounded-3 bg-light">
                                    <small class="text-muted d-block">Current Sell Rate</small>
                                    <strong class="text-dark">@(currentMine.Metadata?.CurrentSellRate?.ToString("0.########") ?? "Not entered")</strong>
                                </div>
                            </div>
                        </div>

                        @if (showForeignTransactionForm)
                        {
                            <div class="border rounded-3 p-3 mb-4 bg-light-subtle">
                                <h4 class="h6 fw-bold text-dark mb-3">Add Exchange Lot</h4>
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold" for="detail-fx-date">Exchange Date</label>
                                        <input id="detail-fx-date" type="date" class="form-control" value="@foreignTransactionDate.ToString("yyyy-MM-dd")" @onchange="OnForeignTransactionDateChanged" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold" for="detail-fx-amount">Foreign Amount</label>
                                        <input id="detail-fx-amount" type="number" class="form-control" min="0" step="0.000001" @bind="foreignTransactionAmount" @bind:event="oninput" @bind:after="RecalculateForeignTransaction" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold" for="detail-fx-myr">MYR Amount Paid</label>
                                        <input id="detail-fx-myr" type="number" class="form-control" min="0" step="0.01" @bind="foreignTransactionMyrAmount" @bind:event="oninput" @bind:after="RecalculateForeignTransaction" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold" for="detail-fx-rate">Exchange Rate</label>
                                        <input id="detail-fx-rate" type="number" class="form-control" readonly value="@foreignTransactionRate.ToString("0.########")" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold" for="detail-fx-fees">Fees (@currentMine.Currency)</label>
                                        <input id="detail-fx-fees" type="number" class="form-control" min="0" step="0.01" @bind="foreignTransactionFees" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold" for="detail-fx-notes">Notes</label>
                                        <input id="detail-fx-notes" type="text" class="form-control" maxlength="300" @bind="foreignTransactionNotes" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(foreignTransactionError))
                                {
                                    <div class="alert alert-danger py-2 small mt-3 mb-0">@foreignTransactionError</div>
                                }
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" class="btn btn-light border btn-sm" @onclick="CloseForeignTransactionForm">Cancel</button>
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveForeignTransactionAsync" disabled="@isSavingForeignTransaction">Save Exchange</button>
                                </div>
                            </div>
                        }

                        @if (fxTransactions.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr><th>Date</th><th>Type</th><th class="text-end">Foreign Amount</th><th class="text-end">MYR Cost</th><th class="text-end">Rate</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaction in fxTransactions.OrderByDescending(item => item.TransactionDate))
                                        {
                                            <tr>
                                                <td>@transaction.TransactionDate.ToString("dd MMM yyyy")</td>
                                                <td>@transaction.TransactionType</td>
                                                <td class="text-end">@transaction.ForeignAmount.ToString("N2")</td>
                                                <td class="text-end">@FormatHelper.FormatCurrency(transaction.MyrAmount + transaction.FeesMyr, currentMine.Currency)</td>
                                                <td class="text-end">@transaction.ExchangeRate.ToString("0.########")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <h3 class="h6 fw-bold text-dark font-display mb-0">Sub-Placements & Lots</h3>
                            <p class="text-muted small mb-0">Granular tranches or holdings inside this mine</p>
                        </div>
                    </div>

                    @if (currentMine.SubMines != null && currentMine.SubMines.Count > 0)
                    {
                        <div class="row g-3">
                            @foreach (var sm in currentMine.SubMines)
                            {
                                var days = !string.IsNullOrEmpty(sm.MaturityDate) ? FormatHelper.DaysUntil(sm.MaturityDate) : (int?)null;
                                <div class="col-12 col-md-6">
                                    <div class="p-3 rounded-4 border border-light-subtle bg-light">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <h4 class="h6 fw-bold text-dark mb-0">@sm.Label</h4>
                                            @if (days.HasValue)
                                            {
                                                <span class="badge @(days.Value <= 14 ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-dark-subtle text-dark")">
                                                    @(days.Value > 0 ? $"{days.Value} days to maturity" : "Matured")
                                                </span>
                                            }
                                        </div>
                                        <div class="d-flex flex-column gap-1 small text-muted">
                                            @if (sm.Principal.HasValue)
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span>Principal:</span>
                                                    <span class="fw-semibold text-dark">@FormatHelper.FormatCurrency(sm.Principal.Value, currentMine.Currency)</span>
                                                </div>
                                            }
                                            @if (sm.Rate.HasValue)
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span>Return Rate:</span>
                                                    <span class="fw-semibold text-dark">@sm.Rate.Value% p.a.</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(sm.Quantity))
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span>Quantity:</span>
                                                    <span class="fw-semibold text-dark">@sm.Quantity</span>
                                                </div>
                                            }
                                            @if (sm.PurchasePrice.HasValue)
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span>Purchase Price:</span>
                                                    <span class="fw-semibold text-dark">@FormatHelper.FormatCurrencyPrecise(sm.PurchasePrice.Value, currentMine.Currency)</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(sm.MaturityDate))
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span>Maturity Date:</span>
                                                    <span class="fw-semibold text-dark">@sm.MaturityDate</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="ti ti-layers-subtract fs-2 mb-2 text-muted"></i>
                            <p class="small mb-0">No sub-placements or tranches recorded for this mine.</p>
                        </div>
                    }
                </div>
            </div>
        }
        }
        else if (activeTab == "income")
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
                    <h3 class="h6 fw-bold text-dark font-display mb-3">Passive Income Contribution</h3>
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <div class="p-4 rounded-4 bg-warning-subtle border border-warning-subtle text-center">
                                <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem;">Monthly Cashflow</span>
                                <div class="fs-2 fw-bold text-dark font-display my-1">
                                    @(currentMine.MonthlyIncome > 0 ? FormatHelper.FormatCurrency(currentMine.MonthlyIncome, currentMine.Currency) : FormatHelper.FormatCurrency(0, currentMine.Currency))
                                </div>
                                <span class="small text-muted">Direct passive ore generated every 30 days</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-4 rounded-4 bg-light border border-light-subtle text-center">
                                <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem;">Annualized Yield</span>
                                <div class="fs-2 fw-bold text-dark font-display my-1">
                                    @FormatHelper.FormatCurrency(currentMine.MonthlyIncome * 12, currentMine.Currency)
                                </div>
                                <span class="small text-muted">Based on current monthly distribution rate</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top border-light-subtle d-flex align-items-center justify-content-between">
                        <span class="small text-muted">Want to see where this fits into your Freedom Ratio?</span>
                        <a href="/income" class="btn btn-outline-dark btn-sm rounded-3">
                            <span>View Full Income Matrix</span>
                            <i class="ti ti-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Edit Mine Modal -->
    <AddMineModal IsOpen="showEditModal"
                  ExistingMine="currentMine"
                  OnClose="CloseEditModal"
                  OnSaved="HandleMineSaved" />

    @if (showYieldDeclarationModal)
    {
        <div class="modal fade show d-block omm-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="yield-declaration-modal-title">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                    <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-percentage text-gold fs-4"></i>
                            <div>
                                <h2 id="yield-declaration-modal-title" class="h5 modal-title fw-bold font-display mb-0">Log Rate Declaration</h2>
                                <small class="text-white-50">Add a rate snapshot for @currentMine.Name</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseYieldDeclarationModal" disabled="@isSavingYieldDeclaration"></button>
                    </div>

                    <div class="modal-body p-4 bg-light">
                        @if (!string.IsNullOrWhiteSpace(yieldInputError))
                        {
                            <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-3 py-2" role="alert">
                                <i class="ti ti-alert-triangle flex-shrink-0 fs-5"></i>
                                <span class="small">@yieldInputError</span>
                            </div>
                        }

                        <div class="omm-form-section">
                            <div class="omm-form-grid">
                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="yield-effective-year">Effective year <span class="text-danger">*</span></label>
                                    <input id="yield-effective-year" type="number" class="form-control" min="1" max="9999" @bind="yieldEffectiveYear" />
                                </div>
                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="yield-record-date">Record date <span class="text-danger">*</span></label>
                                    <input id="yield-record-date" type="date" class="form-control" @bind="yieldRecordDate" />
                                </div>
                            </div>

                            <div class="omm-form-field">
                                <label class="omm-form-label" for="yield-rate-pct">Rate percentage <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input id="yield-rate-pct" type="number" class="form-control" min="0" step="0.01" @bind="yieldRatePct" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>

                            <div class="omm-form-grid">
                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="yield-declared-amount">Declared amount <span class="text-muted fw-normal">(optional)</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@currentMine.Currency</span>
                                        <input id="yield-declared-amount" type="number" class="form-control" min="0" step="0.01" @bind="yieldDeclaredAmount" />
                                    </div>
                                </div>
                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="yield-balance">Balance at time <span class="text-muted fw-normal">(optional)</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@currentMine.Currency</span>
                                        <input id="yield-balance" type="number" class="form-control" min="0" step="0.01" @bind="yieldBalanceAtTime" />
                                    </div>
                                </div>
                            </div>

                            <div class="omm-form-field">
                                <label class="omm-form-label" for="yield-notes">Notes <span class="text-muted fw-normal">(optional)</span></label>
                                <textarea id="yield-notes" class="form-control" rows="3" maxlength="500" @bind="yieldNotes"></textarea>
                            </div>

                            <div class="form-check">
                                <input id="yield-create-income" type="checkbox" class="form-check-input" @bind="createIncomeRecord" />
                                <label class="form-check-label small" for="yield-create-income">Also create matching cash income record in Freedom Income log</label>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer px-4 py-3 border-0 bg-white">
                        <button type="button" class="btn btn-light border" @onclick="CloseYieldDeclarationModal" disabled="@isSavingYieldDeclaration">Cancel</button>
                        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1" @onclick="SaveYieldDeclarationAsync" disabled="@isSavingYieldDeclaration">
                            @if (isSavingYieldDeclaration)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="ti ti-device-floppy"></i>
                                <span>Save Declaration</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Mine? currentMine;
    private Burden? linkedBurden;
    private List<MineYieldHistoryEntity> yieldHistories = [];
    private string activeTab = "overview";
    private bool showEditModal = false;
    private bool showYieldDeclarationModal = false;
    private bool isSavingYieldDeclaration;
    private int yieldEffectiveYear;
    private DateOnly yieldRecordDate;
    private decimal yieldRatePct;
    private decimal? yieldDeclaredAmount;
    private decimal? yieldBalanceAtTime;
    private string yieldNotes = string.Empty;
    private bool createIncomeRecord;
    private string? yieldInputError;
    private string? yieldMessage;
    private bool yieldMessageIsError;
    private bool showForeignTransactionForm;
    private bool isSavingForeignTransaction;
    private DateOnly foreignTransactionDate;
    private decimal foreignTransactionAmount;
    private decimal foreignTransactionMyrAmount;
    private decimal foreignTransactionRate;
    private decimal foreignTransactionFees;
    private string foreignTransactionNotes = string.Empty;
    private string? foreignTransactionError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadMineData();
    }

    private async Task LoadMineData()
    {
        currentMine = await MineService.GetMineByIdAsync(Id);
        if (currentMine != null)
        {
            if (!string.IsNullOrEmpty(currentMine.LinkedBurdenId))
            {
                linkedBurden = await MineService.GetLinkedBurdenAsync(currentMine.LinkedBurdenId);
            }
            else
            {
                linkedBurden = null;
            }

            yieldHistories = await MineService.GetYieldHistoriesAsync(currentMine.Id);
        }
    }

    private void OpenEditModal() => showEditModal = true;
    private void CloseEditModal() => showEditModal = false;

    private void OpenYieldDeclarationModal()
    {
        yieldEffectiveYear = DateTime.UtcNow.Year;
        yieldRecordDate = DateOnly.FromDateTime(DateTime.UtcNow);
        yieldRatePct = 0;
        yieldDeclaredAmount = null;
        yieldBalanceAtTime = null;
        yieldNotes = string.Empty;
        createIncomeRecord = false;
        yieldInputError = null;
        yieldMessage = null;
        showYieldDeclarationModal = true;
    }

    private void OpenForeignTransactionForm()
    {
        foreignTransactionDate = DateOnly.FromDateTime(DateTime.Today);
        foreignTransactionAmount = 0;
        foreignTransactionMyrAmount = 0;
        foreignTransactionRate = 0;
        foreignTransactionFees = 0;
        foreignTransactionNotes = string.Empty;
        foreignTransactionError = null;
        showForeignTransactionForm = true;
    }

    private void CloseForeignTransactionForm()
    {
        if (!isSavingForeignTransaction)
        {
            showForeignTransactionForm = false;
            foreignTransactionError = null;
        }
    }

    private void RecalculateForeignTransaction()
    {
        foreignTransactionRate = foreignTransactionMyrAmount > 0
            ? Math.Round(foreignTransactionAmount / foreignTransactionMyrAmount, 8)
            : 0;
    }

    private void OnForeignTransactionDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            foreignTransactionDate = date;
        }
    }

    private async Task SaveForeignTransactionAsync()
    {
        if (isSavingForeignTransaction || currentMine is null)
        {
            return;
        }

        foreignTransactionError = null;
        if (foreignTransactionDate == default || foreignTransactionAmount <= 0 || foreignTransactionMyrAmount <= 0 || foreignTransactionRate <= 0 || foreignTransactionFees < 0)
        {
            foreignTransactionError = "Enter a valid date, foreign amount, MYR amount, and non-negative fees.";
            return;
        }

        isSavingForeignTransaction = true;
        try
        {
            var saved = await MineService.AddForeignCurrencyTransactionAsync(
                currentMine.Id,
                new ForeignCurrencyTransaction
                {
                    TransactionType = ForeignCurrencyTransactionType.Purchase,
                    TransactionDate = foreignTransactionDate,
                    ForeignAmount = foreignTransactionAmount,
                    MyrAmount = foreignTransactionMyrAmount,
                    ExchangeRate = foreignTransactionRate,
                    FeesMyr = foreignTransactionFees,
                    Notes = string.IsNullOrWhiteSpace(foreignTransactionNotes) ? null : foreignTransactionNotes.Trim()
                });

            if (!saved)
            {
                foreignTransactionError = "The exchange could not be saved.";
                return;
            }

            await LoadMineData();
            showForeignTransactionForm = false;
        }
        catch (Exception ex)
        {
            foreignTransactionError = ex.Message;
        }
        finally
        {
            isSavingForeignTransaction = false;
        }
    }

    private void CloseYieldDeclarationModal()
    {
        if (isSavingYieldDeclaration)
        {
            return;
        }

        yieldInputError = null;
        showYieldDeclarationModal = false;
    }

    private async Task HandleMineSaved()
    {
        await LoadMineData();
    }

    private async Task SaveYieldDeclarationAsync()
    {
        if (isSavingYieldDeclaration || currentMine is null || !ValidateYieldDeclaration())
        {
            return;
        }

        isSavingYieldDeclaration = true;
        yieldMessage = null;

        try
        {
            var saved = await MineService.RecordYieldDeclarationAsync(
                currentMine.Id,
                yieldEffectiveYear,
                yieldRecordDate,
                yieldRatePct,
                declaredAmount: yieldDeclaredAmount,
                balanceAtTime: yieldBalanceAtTime,
                notes: string.IsNullOrWhiteSpace(yieldNotes) ? null : yieldNotes.Trim(),
                createIncomeRecord: createIncomeRecord);

            if (!saved)
            {
                yieldMessage = "The rate declaration could not be saved.";
                yieldMessageIsError = true;
                return;
            }

            await LoadMineData();
            yieldMessage = createIncomeRecord
                ? "Rate declaration and matching income record saved."
                : "Rate declaration saved.";
            yieldMessageIsError = false;
            showYieldDeclarationModal = false;
        }
        catch (Exception ex)
        {
            yieldMessage = ex.Message;
            yieldMessageIsError = true;
        }
        finally
        {
            isSavingYieldDeclaration = false;
        }
    }

    private bool ValidateYieldDeclaration()
    {
        yieldInputError = null;

        if (yieldEffectiveYear is < 1 or > 9999)
        {
            yieldInputError = "Enter a valid effective year.";
        }
        else if (yieldRecordDate == default)
        {
            yieldInputError = "Enter a record date.";
        }
        else if (yieldRatePct <= 0)
        {
            yieldInputError = "Enter a rate percentage greater than zero.";
        }
        else if (yieldDeclaredAmount is < 0 || yieldBalanceAtTime is < 0)
        {
            yieldInputError = "Amounts cannot be negative.";
        }
        else if (createIncomeRecord && (!yieldDeclaredAmount.HasValue || yieldDeclaredAmount <= 0))
        {
            yieldInputError = "Enter a declared amount greater than zero to create the matching income record.";
        }

        return yieldInputError is null;
    }

    private async Task ConfirmDelete()
    {
        if (currentMine != null)
        {
            await MineService.DeleteMineAsync(currentMine.Id);
            Navigation.NavigateTo("/mines");
        }
    }
}
