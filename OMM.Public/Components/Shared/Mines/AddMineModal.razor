    // Auto-calculation methods
    private void RecalculateEpf()
    {
        var total = (metadata.Akaun1Balance ?? 0) + (metadata.Akaun2Balance ?? 0) + (metadata.Akaun3Balance ?? 0);
        workingMine.CurrentValue = total;
        workingMine.PurchaseCost = total;
        workingMine.Growth = 0;
        workingMine.GrowthPct = 0;

        if (metadata.ExpectedDividendRate.HasValue && metadata.ExpectedDividendRate > 0)
        {
            var annual = total * (metadata.ExpectedDividendRate.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        workingMine.Holdings = $"A1: {currencySymbol}{(metadata.Akaun1Balance ?? 0):N0} | A2: {currencySymbol}{(metadata.Akaun2Balance ?? 0):N0} | A3: {currencySymbol}{(metadata.Akaun3Balance ?? 0):N0}";
    }

    private void OnAsbFundChanged()
    {
        if (!IsEditMode && !string.IsNullOrWhiteSpace(metadata.FundCode))
        {
            workingMine.Name = metadata.FundCode;
        }
        RecalculateAsb();
    }

    private void RecalculateAsb()
    {
        metadata.NavPerUnit = 1.00m;
        var total = (metadata.UnitsHeld ?? 0) * 1.00m;
        workingMine.CurrentValue = total;
        workingMine.PurchaseCost = total;
        workingMine.Growth = 0;
        workingMine.GrowthPct = 0;

        if (metadata.ExpectedDividendRate.HasValue && metadata.ExpectedDividendRate > 0)
        {
            var annual = total * (metadata.ExpectedDividendRate.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        workingMine.Holdings = $"{(metadata.UnitsHeld ?? 0):N0} units @ RM 1.00";
    }

    private void RecalculateFd()
    {
        var principal = metadata.Principal ?? 0;
        var rate = metadata.InterestRatePct ?? 0;
        var tenureMonths = metadata.TenureMonths ?? 0;
        var placementDate = metadata.PlacementDate ?? DateOnly.FromDateTime(DateTime.Today);
        metadata.PlacementDate ??= placementDate;
        workingMine.PurchaseCost = principal;
        workingMine.CurrentValue = principal * (1m + (rate / 100m * tenureMonths / 12m));
        workingMine.Growth = workingMine.CurrentValue - principal;
        workingMine.GrowthPct = principal > 0
            ? Math.Round((workingMine.Growth / principal) * 100m, 1)
            : 0;

        if (rate > 0 && tenureMonths > 0)
        {
            var annual = principal * (rate / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        else
        {
            workingMine.MonthlyIncome = 0;
        }

        if (tenureMonths > 0)
        {
            metadata.MaturityDate = placementDate.AddMonths(tenureMonths);
        }

        workingMine.Holdings = null;
    }

    private void OnPlacementDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var dt))
        {
            metadata.PlacementDate = dt;
            RecalculateFd();
        }
    }

