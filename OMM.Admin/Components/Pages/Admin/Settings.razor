@page "/admin/settings"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Configuration
@using OMM.Admin.Services.Admin
@using OMM.Shared.Infrastructure.Settings
@attribute [Authorize(Policy = "RequireAdminRole")]

@inject ISystemSettingsService SystemSettingsService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogger AuditLogger
@inject IConfiguration Configuration

<PageTitle>System Settings - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 font-display">System Settings</h1>
            <p class="text-muted mb-0">Manage global system configurations, authentication providers, and feature toggles.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
            <i class="ti ti-settings me-1"></i> Global Settings
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-@_statusClass alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 mb-4" role="alert">
            <i class="ti @(_statusClass == "success" ? "ti-circle-check" : "ti-alert-circle") fs-5"></i>
            <div>@_statusMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => _statusMessage = null" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Authentication & Social Providers Section -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 bg-white shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                        <i class="ti ti-shield-lock fs-4"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold text-dark mb-0">Authentication & External Logins</h2>
                        <span class="text-muted small">Control which third-party authentication methods are permitted for public members.</span>
                    </div>
                </div>

                <hr class="my-3 opacity-10" />

                <!-- Google External Login Toggle -->
                <div class="p-3 border rounded-3 bg-light-subtle mb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-2 bg-white shadow-sm border d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                <i class="ti ti-brand-google fs-4 text-danger"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="h6 fw-bold mb-0">Google OAuth 2.0 Sign-In</h3>
                                    @if (_isLoading)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Loading...</span>
                                    }
                                    else if (_googleAuthEnabled)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="ti ti-circle-check me-1"></i>Enabled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <i class="ti ti-circle-x me-1"></i>Disabled
                                        </span>
                                    }
                                </div>
                                <p class="text-muted small mb-0 mt-1">
                                    When enabled, public members can sign up and sign in using their Google accounts. If disabled, Google login buttons and endpoints are deactivated.
                                </p>
                            </div>
                        </div>

                        <div class="form-check form-switch fs-4 ms-3 mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="googleAuthSwitch"
                                   checked="@_googleAuthEnabled"
                                   disabled="@(_isLoading || _isSaving)"
                                   @onchange="OnGoogleAuthToggleChanged" />
                        </div>
                    </div>

                    <!-- Credential configuration status note -->
                    <div class="mt-3 pt-3 border-top small">
                        @if (_isGoogleConfiguredInEnvironment)
                        {
                            <div class="text-success d-flex align-items-center gap-1">
                                <i class="ti ti-circle-check"></i>
                                <span>Google Client ID and Client Secret are configured in the environment / application configuration.</span>
                            </div>
                        }
                        else
                        {
                            <div class="text-warning d-flex align-items-center gap-1">
                                <i class="ti ti-alert-triangle"></i>
                                <span>
                                    <strong>Notice:</strong> Google Client ID or Client Secret is not detected in environment settings.
                                    Even if toggled ON here, OAuth redirects require valid credentials in <code>Authentication:Google:ClientId</code> and <code>Authentication:Google:ClientSecret</code>.
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="small text-muted bg-body-tertiary p-3 rounded-3 border">
                    <i class="ti ti-info-circle me-1 text-primary"></i>
                    <strong>Default Behavior:</strong> If no database record exists, Google login strictly defaults to <strong>Disabled (False)</strong>. Toggling the switch writes directly to the <code>SystemSetting</code> master data table and applies across all instances.
                </div>
            </div>
        </div>

        <!-- Setting Information & Audit Side Card -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 bg-white shadow-sm rounded-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="p-2 bg-info-subtle text-info rounded-3">
                        <i class="ti ti-database fs-4"></i>
                    </div>
                    <div>
                        <h2 class="h6 fw-bold text-dark mb-0">Setting Metadata</h2>
                        <span class="text-muted small">Database storage details</span>
                    </div>
                </div>

                <div class="list-group list-group-flush small">
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Setting Key:</span>
                        <code class="fw-semibold">@SystemSettingKeys.GoogleAuthEnabled</code>
                    </div>
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Table:</span>
                        <code class="fw-semibold">public."SystemSetting"</code>
                    </div>
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Current Value:</span>
                        <span class="fw-bold @(_googleAuthEnabled ? "text-success" : "text-secondary")">
                            @(_googleAuthEnabled ? "true" : "false")
                        </span>
                    </div>
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Default State:</span>
                        <span class="text-secondary fw-semibold">false (Disabled)</span>
                    </div>
                </div>

                <div class="alert alert-light border small mt-3 mb-0">
                    <i class="ti ti-history me-1"></i> All modifications to this switch are automatically recorded in the <a href="admin/audit-log" class="text-primary text-decoration-none fw-semibold">Audit Log</a>.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _googleAuthEnabled;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isGoogleConfiguredInEnvironment;

    private string? _statusMessage;
    private string _statusClass = "success";
    private string _currentUserId = string.Empty;
    private string _currentUserName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "Admin";
        _currentUserName = authState.User.Identity?.Name ?? "Admin";

        CheckEnvironmentCredentials();
        await LoadSettingsAsync();
    }

    private void CheckEnvironmentCredentials()
    {
        var clientId = Configuration["Authentication:Google:ClientId"]
                       ?? Configuration["Authentication:Google:ClientId".Replace(":", "__")]
                       ?? Configuration["ClientId"];
        var clientSecret = Configuration["Authentication:Google:ClientSecret"]
                           ?? Configuration["Authentication:Google:ClientSecret".Replace(":", "__")]
                           ?? Configuration["ClientSecret"];

        _isGoogleConfiguredInEnvironment = !string.IsNullOrWhiteSpace(clientId) && !string.IsNullOrWhiteSpace(clientSecret);
    }

    private async Task LoadSettingsAsync()
    {
        _isLoading = true;
        try
        {
            // Default is false if not found in database
            _googleAuthEnabled = await SystemSettingsService.IsGoogleAuthEnabledAsync();
        }
        catch (Exception ex)
        {
            _statusClass = "danger";
            _statusMessage = $"Failed to load settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnGoogleAuthToggleChanged(ChangeEventArgs e)
    {
        if (e.Value is not bool newEnabled)
        {
            if (!bool.TryParse(e.Value?.ToString(), out newEnabled))
            {
                return;
            }
        }

        _isSaving = true;
        _statusMessage = null;

        try
        {
            await SystemSettingsService.SetGoogleAuthEnabledAsync(newEnabled, _currentUserId);
            _googleAuthEnabled = newEnabled;

            await AuditLogger.LogAsync(
                _currentUserId,
                _currentUserName,
                newEnabled ? "EnableGoogleAuth" : "DisableGoogleAuth",
                targetUserId: null,
                detail: $"Google external login was toggled to {(newEnabled ? "ENABLED" : "DISABLED")}.");

            _statusClass = "success";
            _statusMessage = $"Google authentication has been successfully {(newEnabled ? "enabled" : "disabled")}.";
        }
        catch (Exception ex)
        {
            _statusClass = "danger";
            _statusMessage = $"Failed to update Google authentication setting: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
