    private async Task SavePlanAsync()
    {
        if (planSaved || isSaving)
        {
            return;
        }

        var signal = selectedSignal ?? CreateGeneralSignal(
            SignalCategory.PortfolioDecision,
            memberQuestion,
            targetSecurity,
            targetSector);

        var user = (await AuthenticationStateTask).User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            saveError = "Sign in to save this decision pathway.";
            return;
        }

        var trimmedQuestion = string.IsNullOrWhiteSpace(memberQuestion) ? null : memberQuestion.Trim();
        if (trimmedQuestion != null)
        {
            var notesError = PublicInputValidator.GetDisplayTextError("Notes", trimmedQuestion, optional: true);
            if (notesError != null)
            {
                saveError = notesError;
                return;
            }
        }

        isSaving = true;
        saveError = null;
        try
        {
            var record = new DecisionPathwayRecord
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                SignalId = signal.Id,
                SignalTitle = signal.Title,
                ScopeKey = selectedScope,
                ConcernKey = selectedConcern,
                ObjectiveKey = selectedObjective,
                SelectedActionKey = selectedAction,
                CurrentSharePrice = calcPrice,
                AnnualDividendPerShare = calcDividend,
                HorizonLabel = checkpoint.ReviewHorizon,
                CheckpointTitle = checkpoint.Title,
                CheckpointTriggerCondition = checkpoint.TriggerCondition,
                StockCode = matchedPosition?.StockCode ?? (!string.IsNullOrWhiteSpace(targetSecurity) ? targetSecurity : null),
                ReviewDate = checkpoint.ReviewDate ?? DateOnly.FromDateTime(DateTime.UtcNow.AddMonths(1)),
                TriggerPriceBelow = checkpoint.SuggestedTriggerBelow,
                TriggerPriceAbove = checkpoint.SuggestedTriggerAbove,
                Status = DecisionPathwayStatus.Open,
                CreatedAt = DateTimeOffset.UtcNow,
                Notes = trimmedQuestion
            };

            await DecisionPathwayService.SavePathwayAsync(record);
            planSaved = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save Decision Pathway plan.");
            saveError = "Unable to save the plan. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetPathway()
    {
        screen = 1;
        memberQuestion = string.Empty;
        selectedSignal = null;
        activeCategoryFilter = null;
        selectedConcern = "price_drop";
        selectedScope = "individual_stock";
        selectedObjective = "balanced";
        selectedAction = "hold";
        targetSecurity = string.Empty;
        targetSector = string.Empty;
        calcPrice = null;
        calcDividend = null;
        calcShares = null;
        calcCostBasis = null;
        matchedPosition = null;
        stressAdjustment = 0;
        branchCreated = false;
        planSaved = false;
        saveError = null;
        intentResult = null;
        classificationMessage = null;
        RefreshCalculations();
    }

    private void RefreshCalculations()
    {
        var category = selectedSignal?.Category ?? SignalCategory.PortfolioDecision;

        impactMap = DecisionEngine.BuildImpactMap(
            category,
            targetSector,
            targetSecurity,
            selectedConcern,
            selectedScope);

        evaluatedOptions = DecisionEngine.EvaluateActionOptions(
            selectedObjective,
            selectedConcern);

        if (!evaluatedOptions.Any(o => o.Key == selectedAction))
        {
            selectedAction = evaluatedOptions.FirstOrDefault()?.Key ?? "hold";
        }

        var input = new ScenarioCalculationInput(
            calcPrice ?? 0,
            calcDividend ?? 0,
            calcShares,
            "Several months",
            stressAdjustment);

        scenarios = DecisionEngine.CalculateScenarios(input, selectedAction);

        checkpoint = DecisionEngine.GenerateCheckpoint(
            ActiveTargetLabel,
            selectedAction,
            "Several months",
            calcPrice ?? 0);
    }

