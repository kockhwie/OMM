@page "/Account/AccessDenied"

<PageTitle>Access Denied - OMM Admin</PageTitle>

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="w-100 text-center" style="max-width: 460px;">
        <div class="omm-card p-5 shadow-sm border-top border-3 border-danger">
            <div class="stat-icon-wrapper bg-danger-subtle text-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem; border-radius: 16px;">
                <i class="ti ti-shield-x"></i>
            </div>
            <h1 class="h4 fw-bold text-danger mb-2">Access Denied</h1>
            <p class="text-muted mb-4">
                You do not have the required administrative permissions (<code>Admin</code> or <code>SuperAdmin</code>) to view this resource.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a href="login" class="btn btn-danger btn-sm px-3">
                    <i class="ti ti-login me-1"></i> Sign In With Admin Account
                </a>
            </div>
        </div>
    </div>
</div>
