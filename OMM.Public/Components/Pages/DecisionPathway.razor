@page "/decision-pathway"
@layout MainLayout
@using System.Security.Claims
@using OMM.Shared.DecisionSupport
@inject IInquiryIntentInterpreter IntentInterpreter
@inject IDeterministicDecisionEngine DecisionEngine
@inject IDecisionPathwayService DecisionPathwayService
@inject ILogger<DecisionPathway> Logger

<PageTitle>Decision Pathway - OhMyMine</PageTitle>

<PublicPageShell>
    <div class="decision-pathway animate-fade-up">
        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="decision-eyebrow">Decision Support System</span>
                    <span class="badge rounded-pill text-bg-light border">Deterministic Analysis</span>
                </div>
                <h1 class="mb-2">Turn any market signal into a disciplined next step.</h1>
                <p class="text-muted mb-0 decision-intro">
                    Examine market events across stocks, sectors, domestic macro, and global policy. Understand the transmission mechanism and compare deterministic scenarios before taking action.
                </p>
            </div>
            <button class="btn btn-link text-decoration-none text-dark p-0 decision-reset" @onclick="ResetPathway">
                <i class="ti ti-refresh me-1"></i>Start over
            </button>
        </div>

        <!-- 8-Stage Workspace -->
        <div class="decision-workspace">
            <!-- Sidebar: Pathway Progress -->
            <aside class="decision-tree-panel" aria-label="Decision pathway progress">
                <div class="decision-tree-heading">
                    <div>
                        <p class="decision-panel-kicker mb-1">Your Pathway</p>
                        <h2 class="h5 mb-0">@ActiveTargetLabel</h2>
                    </div>
                    <span class="decision-step-count">Step @screen of 8</span>
                </div>

                <div class="decision-tree" role="list">
                    <button class="decision-tree-node @(screen >= 1 ? (screen == 1 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(1)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-broadcast"></i></span>
                        <span><strong>1. Signal</strong><small>@SignalShortLabel</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen >= 2 ? (screen == 2 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(2)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-help-circle"></i></span>
                        <span><strong>2. Concern</strong><small>@ConcernShortLabel</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen >= 3 ? (screen == 3 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(3)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-compass"></i></span>
                        <span><strong>3. Scope</strong><small>@ScopeShortLabel</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen >= 4 ? (screen == 4 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(4)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-target"></i></span>
                        <span><strong>4. Objective</strong><small>@ObjectiveShortLabel</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen >= 5 ? (screen == 5 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(5)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-git-fork"></i></span>
                        <span><strong>5. Impact Map</strong><small>Transmission</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen >= 6 ? (screen == 6 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(6)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-list-check"></i></span>
                        <span><strong>6. Options</strong><small>@ActionShortLabel</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen >= 7 ? (screen == 7 ? "is-current" : "is-complete") : "")" @onclick="() => GoToScreen(7)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-chart-dots"></i></span>
                        <span><strong>7. Scenarios</strong><small>@ScenarioShortLabel</small></span>
                    </button>
                    <span class="decision-tree-line"></span>

                    <button class="decision-tree-node @(screen == 8 ? "is-current" : "")" @onclick="() => GoToScreen(8)" role="listitem">
                        <span class="decision-node-marker"><i class="ti ti-flag-checkered"></i></span>
                        <span><strong>8. Checkpoint</strong><small>Monitoring</small></span>
                    </button>
                </div>

                <div class="decision-tree-note">
                    <i class="ti ti-sparkles"></i>
                    <p class="mb-0">All calculations and decision rules run deterministically in OMM. AI is only used to classify free-form queries.</p>
                </div>
            </aside>

            <!-- Main Content Area -->
            <section class="decision-content-panel" aria-live="polite">
                @if (screen == 1)
                {
                    <!-- SCREEN 1: SIGNAL -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">01</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 1 · Signal Intake</p>
                            <h2>What event or market signal caught your attention?</h2>
                            <p class="text-muted mb-0">Type your question in free form, or pick from curated Malaysian and global market signals.</p>
                        </div>
                    </div>

                    <!-- Free Text AI Intake -->
                    <div class="decision-question-card mt-4 mb-4">
                        <div class="d-flex align-items-start gap-3">
                            <span class="decision-option-icon tone-blue"><i class="ti ti-sparkles"></i></span>
                            <div class="flex-grow-1">
                                <label for="member-question" class="h6 mb-2 d-block">Ask OMM in your own words</label>
                                <textarea id="member-question"
                                          class="form-control omm-input decision-question-input"
                                          rows="3"
                                          @bind="memberQuestion"
                                          placeholder="Example: US FED increases interest rates by 0.25 points. What could happen to Maybank?"></textarea>

                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                                    <span class="decision-question-help">
                                        <i class="ti ti-lock me-1"></i>Only this question is interpreted for classification; your portfolio records stay strictly in OMM.
                                    </span>
                                    <button class="btn btn-dark rounded-3 px-4" @onclick="InterpretQuestionAsync" disabled="@(string.IsNullOrWhiteSpace(memberQuestion) || isInterpreting)">
                                        @if (isInterpreting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                        }
                                        Understand my question <i class="ti ti-arrow-right ms-1"></i>
                                    </button>
                                </div>

                                @if (intentResult is not null)
                                {
                                    @* --- Determine which card state to show --- *@
                                    var isVague = intentResult.IsAvailable && (intentResult.SignalType == "unknown" || intentResult.Confidence < 0.4m);
                                    var isClassified = intentResult.IsAvailable && !isVague;

                                    <div class="decision-ai-result mt-3 @(isClassified ? "is-ready" : isVague ? "is-vague" : "is-unavailable")">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="ti @(isClassified ? "ti-sparkles" : isVague ? "ti-alert-circle" : "ti-sparkles") mt-1"></i>
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    @if (isClassified)
                                                    {
                                                        <strong>OMM classified your signal:</strong>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Ready to proceed</span>
                                                    }
                                                    else if (isVague)
                                                    {
                                                        <strong>Tell us more &mdash; pick a topic to start</strong>
                                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">More detail needed</span>
                                                    }
                                                    else
                                                    {
                                                        <strong>Guided classification available</strong>
                                                    }
                                                </div>
                                                <p class="mb-0 small">
                                                    @if (intentResult.IsAvailable)
                                                    {
                                                        @intentResult.Summary
                                                    }
                                                    else
                                                    {
                                                        @intentResult.ErrorMessage
                                                    }
                                                </p>
                                            </div>
                                        </div>

                                        @if (isClassified)
                                        {
                                            <div class="decision-ai-tags mt-3">
                                                <span>Signal: @intentResult.SignalType</span>
                                                @if (!string.IsNullOrWhiteSpace(intentResult.MentionedSecurity))
                                                {
                                                    <span>Stock: @intentResult.MentionedSecurity</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(intentResult.MentionedSector))
                                                {
                                                    <span>Sector: @intentResult.MentionedSector</span>
                                                }
                                                <span>Intent: @intentResult.Intent</span>
                                                <span>Confidence: @intentResult.Confidence.ToString("P0")</span>
                                            </div>
                                        }

                                        @if (isClassified || isVague)
                                        {
                                            <!-- Quick-concern chips -->
                                            <div class="mt-3 p-3 bg-white rounded-3 border">
                                                <p class="small mb-1 fw-bold text-dark">
                                                    <i class="ti ti-help-circle me-1 text-primary"></i>
                                                    @(intentResult.MissingQuestions.Count > 0
                                                        ? intentResult.MissingQuestions[0]
                                                        : "What is your main concern with this signal?")
                                                </p>
                                                <p class="text-muted small mb-2">Choose a topic to set your concern and continue directly to Step 3: Scope:</p>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" @onclick='() => SelectConcernAndProceed("price_drop")'>
                                                        <i class="ti ti-chart-candle me-1"></i>Price drop / valuation risk
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" @onclick='() => SelectConcernAndProceed("dividend")'>
                                                        <i class="ti ti-building-bank me-1"></i>Dividend safety
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill" @onclick='() => SelectConcernAndProceed("macro_shock")'>
                                                        <i class="ti ti-world me-1"></i>Interest rate / macro shock
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" @onclick='() => SelectConcernAndProceed("concentration")'>
                                                        <i class="ti ti-chart-pie me-1"></i>Rebalance portfolio weight
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill" @onclick='() => SelectConcernAndProceed("opportunity")'>
                                                        <i class="ti ti-bulb me-1"></i>Assess buying opportunity
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        @if (isClassified)
                                        {
                                            <!-- Primary Proceed Action -->
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-3 border-top">
                                                <span class="small text-muted">
                                                    <i class="ti ti-arrow-right-circle me-1"></i>Or skip directly to Step 2 with the signal as classified.
                                                </span>
                                                <button type="button" class="btn btn-dark rounded-3 px-4 btn-sm" @onclick="() => GoToScreen(2)">
                                                    Proceed to Step 2: Concern <i class="ti ti-arrow-right ms-1"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Curated Signals Picker -->
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3 mt-4">
                        <h3 class="h6 mb-0 text-muted text-uppercase tracking-wider">Or choose a pre-configured market signal</h3>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == null ? "active" : "")" @onclick="() => FilterCategory(null)">All</button>
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == SignalCategory.IndividualStock ? "active" : "")" @onclick="() => FilterCategory(SignalCategory.IndividualStock)">Stocks</button>
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == SignalCategory.Sector ? "active" : "")" @onclick="() => FilterCategory(SignalCategory.Sector)">Sectors</button>
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == SignalCategory.MalaysianMarket ? "active" : "")" @onclick="() => FilterCategory(SignalCategory.MalaysianMarket)">Malaysia</button>
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == SignalCategory.GlobalEconomy ? "active" : "")" @onclick="() => FilterCategory(SignalCategory.GlobalEconomy)">Global</button>
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == SignalCategory.PortfolioDecision ? "active" : "")" @onclick="() => FilterCategory(SignalCategory.PortfolioDecision)">Portfolio</button>
                            <button type="button" class="btn btn-outline-secondary @(activeCategoryFilter == SignalCategory.Opportunity ? "active" : "")" @onclick="() => FilterCategory(SignalCategory.Opportunity)">Opportunity</button>
                        </div>
                    </div>

                    <div class="decision-option-grid">
                        @foreach (var sig in FilteredSignals)
                        {
                            <button class="decision-option-card @(selectedSignal?.Id == sig.Id ? "is-selected" : "")"
                                    @onclick="() => SelectSignalTemplate(sig)">
                                <span class="decision-option-icon @GetCategoryTone(sig.Category)">
                                    <i class="@GetCategoryIcon(sig.Category)"></i>
                                </span>
                                <span class="text-start flex-grow-1">
                                    <strong>@sig.Title</strong>
                                    <small>@sig.Description</small>
                                </span>
                                <i class="ti ti-arrow-up-right decision-option-arrow"></i>
                            </button>
                        }
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(2)">
                            Continue to Concern <i class="ti ti-arrow-right ms-1"></i>
                        </button>
                    </div>
                }
                else if (screen == 2)
                {
                    <!-- SCREEN 2: CONCERN -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">02</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 2 · Member Concern</p>
                            <h2>What is bothering you about this signal?</h2>
                            <p class="text-muted mb-0">Identifying the emotional and financial concern helps clarify which trade-offs matter most.</p>
                        </div>
                    </div>

                    <div class="decision-option-grid mt-4">
                        @foreach (var concern in Concerns)
                        {
                            <button class="decision-option-card @(selectedConcern == concern.Key ? "is-selected" : "")"
                                    @onclick="() => SelectConcern(concern.Key)">
                                <span class="decision-option-icon @concern.Tone"><i class="@concern.Icon"></i></span>
                                <span class="text-start">
                                    <strong>@concern.Title</strong>
                                    <small>@concern.Description</small>
                                </span>
                                <i class="ti ti-arrow-up-right decision-option-arrow"></i>
                            </button>
                        }
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(1)"><i class="ti ti-arrow-left me-1"></i>Back</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(3)">Continue to Scope <i class="ti ti-arrow-right ms-1"></i></button>
                    </div>
                }
                else if (screen == 3)
                {
                    <!-- SCREEN 3: SCOPE -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">03</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 3 · Decision Scope</p>
                            <h2>At what level does this decision operate?</h2>
                            <p class="text-muted mb-0">Decide whether this applies to an isolated company, an entire sector, or your whole portfolio.</p>
                        </div>
                    </div>

                    <div class="decision-scope-grid mt-4">
                        @foreach (var scopeOpt in Scopes)
                        {
                            <button class="decision-scope-card @(selectedScope == scopeOpt.Key ? "is-selected" : "")"
                                    @onclick="() => SelectScope(scopeOpt.Key)">
                                <span class="decision-option-icon tone-blue"><i class="@scopeOpt.Icon"></i></span>
                                <span class="text-start">
                                    <strong>@scopeOpt.Title</strong>
                                    <small>@scopeOpt.Description</small>
                                </span>
                                <i class="ti ti-arrow-up-right decision-option-arrow"></i>
                            </button>
                        }
                    </div>

                    <!-- Target entity contextual editor -->
                    <div class="decision-context-callout mt-4">
                        <div class="omm-form-section p-0">
                            <div class="row g-3">
                                <div class="col-md-6 omm-form-field">
                                    <label class="omm-form-label" for="target-security">Target Security / Company</label>
                                    <input id="target-security" class="form-control omm-input" @bind="targetSecurity" placeholder="e.g. Maybank (1155)" />
                                    <p class="omm-form-help">Applies if evaluating a single stock or primary exposure.</p>
                                </div>
                                <div class="col-md-6 omm-form-field">
                                    <label class="omm-form-label" for="target-sector">Sector / Industry</label>
                                    <input id="target-sector" class="form-control omm-input" @bind="targetSector" placeholder="e.g. Financial Services" />
                                    <p class="omm-form-help">Industry category for transmission mapping.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(2)"><i class="ti ti-arrow-left me-1"></i>Back</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(4)">Continue to Objective <i class="ti ti-arrow-right ms-1"></i></button>
                    </div>
                }
                else if (screen == 4)
                {
                    <!-- SCREEN 4: OBJECTIVE -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">04</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 4 · Primary Objective</p>
                            <h2>What outcome is most important to you?</h2>
                            <p class="text-muted mb-0">Different objectives dictate fundamentally different action priorities.</p>
                        </div>
                    </div>

                    <div class="decision-option-grid mt-4">
                        @foreach (var obj in Objectives)
                        {
                            <button class="decision-option-card @(selectedObjective == obj.Key ? "is-selected" : "")"
                                    @onclick="() => SelectObjective(obj.Key)">
                                <span class="decision-option-icon tone-gold"><i class="@obj.Icon"></i></span>
                                <span class="text-start flex-grow-1">
                                    <strong>@obj.Title</strong>
                                    <small>@obj.Description</small>
                                </span>
                                <span class="decision-action-tag tag-gold ms-2">@obj.PrimaryBenefit</span>
                            </button>
                        }
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(3)"><i class="ti ti-arrow-left me-1"></i>Back</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(5)">Build Impact Map <i class="ti ti-arrow-right ms-1"></i></button>
                    </div>
                }
                else if (screen == 5)
                {
                    <!-- SCREEN 5: IMPACT MAP -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">05</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 5 · Transmission Impact Map</p>
                            <h2>How does this signal transmit to your capital?</h2>
                            <p class="text-muted mb-0">Tracing the transmission chain separates temporary sentiment noise from structural cash-flow impairment.</p>
                        </div>
                    </div>

                    <div class="decision-signal-summary mt-4">
                        <div class="decision-signal-chip">
                            <i class="ti ti-info-circle"></i> @impactMap.Summary
                        </div>
                    </div>

                    <!-- 4-Stage Transmission Nodes -->
                    <div class="decision-impact-map mt-4">
                        @foreach (var node in impactMap.Nodes)
                        {
                            <div class="decision-impact-card @node.Tone">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="decision-eyebrow">@node.Stage</span>
                                    <span class="decision-action-tag @(node.Severity == "high" ? "tag-red" : "tag-gold")">@node.Severity impact</span>
                                </div>
                                <h3 class="h6 mb-1">@node.Title</h3>
                                <p class="mb-0">@node.Description</p>
                            </div>
                        }
                    </div>

                    <!-- Vulnerabilities vs Resilience -->
                    <div class="row g-3 mt-3">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <h4 class="h6 text-danger d-flex align-items-center gap-1 mb-2">
                                    <i class="ti ti-alert-triangle"></i> Key Vulnerabilities
                                </h4>
                                <ul class="small mb-0 ps-3 text-muted">
                                    @foreach (var vuln in impactMap.KeyVulnerabilities)
                                    {
                                        <li class="mb-1">@vuln</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <h4 class="h6 text-success d-flex align-items-center gap-1 mb-2">
                                    <i class="ti ti-shield-check"></i> Resilience Factors
                                </h4>
                                <ul class="small mb-0 ps-3 text-muted">
                                    @foreach (var res in impactMap.KeyResilienceFactors)
                                    {
                                        <li class="mb-1">@res</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(4)"><i class="ti ti-arrow-left me-1"></i>Back</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(6)">Compare Options <i class="ti ti-arrow-right ms-1"></i></button>
                    </div>
                }
                else if (screen == 6)
                {
                    <!-- SCREEN 6: OPTIONS -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">06</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 6 · Action Comparison</p>
                            <h2>Which action best matches your risk budget?</h2>
                            <p class="text-muted mb-0">Every choice has trade-offs. Select an action to test against deterministic scenario models.</p>
                        </div>
                    </div>

                    <div class="decision-action-list mt-4">
                        @foreach (var act in evaluatedOptions)
                        {
                            <div class="p-3 border rounded-3 bg-white mb-2 @(selectedAction == act.Key ? "border-dark shadow-sm" : "")"
                                 role="button"
                                 @onclick="() => SelectAction(act.Key)">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="radio" name="action-choice" checked="@(selectedAction == act.Key)" class="form-check-input mt-0" />
                                        <h3 class="h6 mb-0">@act.Title</h3>
                                    </div>
                                    <span class="decision-action-tag @act.Tone">@act.Tag</span>
                                </div>
                                <p class="small text-muted mb-2">@act.Description</p>
                                <div class="row g-2 small pt-2 border-top">
                                    <div class="col-md-6">
                                        <strong class="text-success"><i class="ti ti-check me-1"></i>Advantages:</strong>
                                        <ul class="ps-3 mb-0 text-muted">
                                            @foreach (var adv in act.Advantages)
                                            {
                                                <li>@adv</li>
                                            }
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-secondary"><i class="ti ti-scale me-1"></i>Trade-offs:</strong>
                                        <ul class="ps-3 mb-0 text-muted">
                                            @foreach (var trade in act.TradeOffs)
                                            {
                                                <li>@trade</li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="mt-2 pt-2 border-top small text-muted">
                                    <em>Suitability: @act.SuitabilityRationale</em>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(5)"><i class="ti ti-arrow-left me-1"></i>Back</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(7)">Calculate Scenarios <i class="ti ti-arrow-right ms-1"></i></button>
                    </div>
                }
                else if (screen == 7)
                {
                    <!-- SCREEN 7: SCENARIOS -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">07</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 7 · Scenario Branches</p>
                            <h2>Deterministic financial branches for @ActiveTargetLabel</h2>
                            <p class="text-muted mb-0">Inspect how your selected action performs across recovery, steady, and stress branches.</p>
                        </div>
                    </div>

                    <!-- Interactive Parameter Inputs -->
                    <div class="p-3 border rounded-3 bg-white mt-4">
                        <h3 class="h6 mb-3"><i class="ti ti-adjustments me-1"></i>Model Assumptions</h3>
                        <div class="row g-3">
                            <div class="col-md-4 omm-form-field">
                                <label class="omm-form-label" for="calc-price">Sample Share Price (RM)</label>
                                <input id="calc-price" type="number" step="0.01" class="form-control omm-input" @bind="calcPrice" @bind:after="RecalculateScenarios" />
                                <p class="omm-form-help">Current reference share price.</p>
                            </div>
                            <div class="col-md-4 omm-form-field">
                                <label class="omm-form-label" for="calc-dividend">Annual Dividend / Share (RM)</label>
                                <input id="calc-dividend" type="number" step="0.01" class="form-control omm-input" @bind="calcDividend" @bind:after="RecalculateScenarios" />
                                <p class="omm-form-help">Expected annual distribution.</p>
                            </div>
                            <div class="col-md-4 omm-form-field">
                                <label class="omm-form-label" for="calc-stress">Stress Test Severity</label>
                                <select id="calc-stress" class="form-select omm-input" @bind="stressAdjustment" @bind:after="RecalculateScenarios">
                                    <option value="0">Standard Historical Stress (-12%)</option>
                                    <option value="5">Moderate Stress (-17%)</option>
                                    <option value="10">Severe Stress (-22%)</option>
                                </select>
                                <p class="omm-form-help">Simulate deeper market downside.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Scenario Outcome Cards -->
                    <div class="decision-outcome-grid mt-4">
                        @foreach (var branch in scenarios)
                        {
                            <article class="decision-outcome-card @branch.Tone">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                    <span class="decision-outcome-label"><i class="@branch.Icon me-1"></i>@branch.Title</span>
                                    <span class="decision-probability">@branch.Label</span>
                                </div>
                                <div class="d-flex align-items-baseline gap-2 mb-2">
                                    <h3 class="mb-0">RM@branch.TargetSharePrice.ToString("F2")</h3>
                                    <span class="fw-bold @(branch.EstimatedTotalReturnPercent >= 0 ? "text-success" : "text-danger")">
                                        @(branch.EstimatedTotalReturnPercent >= 0 ? "+" : "")@branch.EstimatedTotalReturnPercent.ToString("F1")% total return
                                    </span>
                                </div>
                                <p class="mb-2">@branch.Description</p>
                                <div class="small text-muted mb-2">
                                    <strong>Dividend buffer:</strong> RM@branch.DividendForecastPerShare.ToString("F2") / share
                                </div>
                                <div class="decision-outcome-footer">
                                    <span>Monitor:</span>
                                    <strong>@branch.WhatToMonitor</strong>
                                </div>
                            </article>
                        }
                    </div>

                    <!-- Fork What-If Scenario -->
                    <div class="decision-fork-card mt-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="decision-fork-icon"><i class="ti ti-git-branch"></i></span>
                            <div class="flex-grow-1">
                                <h3 class="h6 mb-1">Create a "What If" branch</h3>
                                <p class="small text-muted mb-3">Simulate an alternative assumption without losing your base calculation.</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-sm btn-outline-dark rounded-3" @onclick="() => ForkWithAdjustment(5)">
                                        What if price drops an extra 5%?
                                    </button>
                                    <button class="btn btn-sm btn-outline-dark rounded-3" @onclick="() => ForkWithDividend(0.20m)">
                                        What if dividend is cut to RM0.20?
                                    </button>
                                    <button class="btn btn-sm btn-outline-dark rounded-3" @onclick="() => ForkWithDividend(0.40m)">
                                        What if dividend increases to RM0.40?
                                    </button>
                                </div>
                                @if (branchCreated)
                                {
                                    <p class="small text-success mb-0 mt-3"><i class="ti ti-check me-1"></i>Custom branch recalculation updated above.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(6)"><i class="ti ti-arrow-left me-1"></i>Back</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="() => GoToScreen(8)">Establish Checkpoint <i class="ti ti-arrow-right ms-1"></i></button>
                    </div>
                }
                else
                {
                    <!-- SCREEN 8: MONITORING CHECKPOINT -->
                    <div class="decision-screen-heading">
                        <span class="decision-screen-number">08</span>
                        <div>
                            <p class="decision-panel-kicker mb-1">Step 8 · Monitoring Checkpoint</p>
                            <h2>Lock in your review triggers and remove anxiety.</h2>
                            <p class="text-muted mb-0">A disciplined investor sets rules in advance so market fluctuations do not provoke emotional mistakes.</p>
                        </div>
                    </div>

                    <div class="decision-path-banner mt-4">
                        <div class="d-flex align-items-start gap-3">
                            <span class="decision-option-icon tone-gold"><i class="ti ti-calendar-event"></i></span>
                            <div class="flex-grow-1">
                                <p class="decision-panel-kicker mb-1">Monitoring Protocol</p>
                                <h3 class="h5 mb-1">@checkpoint.Title</h3>
                                <p class="small text-muted mb-0">Review horizon: @checkpoint.ReviewHorizon</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 border rounded-3 bg-white mt-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h4 class="h6 mb-2 text-muted text-uppercase tracking-wider">Trigger Condition</h4>
                                <div class="p-3 bg-light rounded-3">
                                    <p class="mb-0 fw-semibold"><i class="ti ti-bell me-2 text-warning"></i>@checkpoint.TriggerCondition</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h4 class="h6 mb-2 text-muted text-uppercase tracking-wider">Key Metric to Track</h4>
                                <div class="p-3 bg-light rounded-3">
                                    <p class="mb-0 fw-semibold"><i class="ti ti-activity me-2 text-primary"></i>@checkpoint.MetricToTrack</p>
                                </div>
                            </div>
                            <div class="col-12">
                                <h4 class="h6 mb-2 text-muted text-uppercase tracking-wider">Action Rule If Triggered</h4>
                                <div class="p-3 bg-light rounded-3 border-start border-4 border-success">
                                    <p class="mb-0"><i class="ti ti-player-play me-2 text-success"></i>@checkpoint.ActionIfTriggered</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <button class="btn btn-outline-dark rounded-3 px-4" @onclick="() => GoToScreen(7)"><i class="ti ti-arrow-left me-1"></i>Back to Scenarios</button>
                        <button class="btn btn-dark rounded-3 px-4" @onclick="SavePlanAsync" disabled="@(planSaved || isSaving)">
                            <i class="ti ti-bookmark me-1"></i>@(isSaving ? "Saving…" : planSaved ? "Checkpoint Recorded" : "Save Decision Plan")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(saveError))
                    {
                        <div class="alert alert-danger mt-3 mb-0 small" role="alert">@saveError</div>
                    }

                    @if (planSaved)
                    {
                        <div class="alert alert-success mt-3 mb-0 small animate-fade-in">
                            <i class="ti ti-circle-check me-2 fs-5 align-middle"></i>
                            <strong>Decision pathway saved.</strong> Your disciplined monitoring checkpoint has been recorded. Review this position when the trigger condition is met or at the horizon review date.
                        </div>
                    }
                }
            </section>
        </div>
    </div>
</PublicPageShell>

@code {
    private int screen = 1;
    private string memberQuestion = string.Empty;
    private bool isInterpreting;
    private InquiryIntentResult? intentResult;

    private SignalTemplate? selectedSignal;
    private SignalCategory? activeCategoryFilter;
    private string selectedConcern = "price_drop";
    private string selectedScope = "individual_stock";
    private string selectedObjective = "income";
    private string selectedAction = "hold";
    private string targetSecurity = "Maybank (1155)";
    private string targetSector = "Financial Services";

    // Scenario inputs
    private decimal calcPrice = 9.87m;
    private decimal calcDividend = 0.31m;
    private int stressAdjustment = 0;
    private bool branchCreated;
    private bool planSaved;
    private bool isSaving;
    private string? saveError;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    // Computed domain models
    private IReadOnlyList<SignalTemplate> allSignals = [];
    private IReadOnlyList<MemberConcernOption> Concerns = [];
    private IReadOnlyList<ScopeOption> Scopes = [];
    private IReadOnlyList<ObjectiveOption> Objectives = [];
    private ImpactMapResult impactMap = null!;
    private IReadOnlyList<ActionOption> evaluatedOptions = [];
    private IReadOnlyList<ScenarioBranch> scenarios = [];
    private MonitoringCheckpoint checkpoint = null!;

    protected override void OnInitialized()
    {
        allSignals = DecisionEngine.GetCuratedSignals();
        Concerns = DecisionEngine.GetConcerns();
        Scopes = DecisionEngine.GetScopes();
        Objectives = DecisionEngine.GetObjectives();

        selectedSignal = allSignals[0];
        targetSecurity = selectedSignal.DefaultSecurity;
        targetSector = selectedSignal.DefaultSector;
        selectedConcern = selectedSignal.DefaultConcern;
        selectedScope = selectedSignal.DefaultScope;
        selectedObjective = selectedSignal.DefaultObjective;

        RefreshCalculations();
    }

    private IEnumerable<SignalTemplate> FilteredSignals =>
        activeCategoryFilter.HasValue
            ? allSignals.Where(s => s.Category == activeCategoryFilter.Value)
            : allSignals;

    private string ActiveTargetLabel =>
        !string.IsNullOrWhiteSpace(targetSecurity) ? targetSecurity : (!string.IsNullOrWhiteSpace(targetSector) ? targetSector : "Portfolio");

    private string SignalShortLabel => selectedSignal?.Category.ToString() ?? "Input";
    private string ConcernShortLabel => Concerns.FirstOrDefault(c => c.Key == selectedConcern)?.Title ?? "Concern";
    private string ScopeShortLabel => Scopes.FirstOrDefault(s => s.Key == selectedScope)?.Title ?? "Scope";
    private string ObjectiveShortLabel => Objectives.FirstOrDefault(o => o.Key == selectedObjective)?.Title ?? "Objective";
    private string ActionShortLabel => evaluatedOptions.FirstOrDefault(a => a.Key == selectedAction)?.Title ?? "Hold";
    private string ScenarioShortLabel => branchCreated ? "Customized" : "3 Branches";

    private async Task InterpretQuestionAsync()
    {
        if (string.IsNullOrWhiteSpace(memberQuestion)) return;

        isInterpreting = true;
        try
        {
            intentResult = await IntentInterpreter.InterpretAsync(memberQuestion);
            if (intentResult.IsAvailable)
            {
                // Match to curated template and pre-populate parameters
                var matched = DecisionEngine.MatchSignalFromAi(intentResult);
                selectedSignal = matched;

                if (!string.IsNullOrWhiteSpace(intentResult.MentionedSecurity))
                    targetSecurity = intentResult.MentionedSecurity;
                else
                    targetSecurity = matched.DefaultSecurity;

                if (!string.IsNullOrWhiteSpace(intentResult.MentionedSector))
                    targetSector = intentResult.MentionedSector;
                else
                    targetSector = matched.DefaultSector;

                selectedConcern = matched.DefaultConcern;
                selectedScope = matched.DefaultScope;
                selectedObjective = matched.DefaultObjective;

                RefreshCalculations();
            }
        }
        finally
        {
            isInterpreting = false;
        }
    }

    private void SelectSignalTemplate(SignalTemplate sig)
    {
        selectedSignal = sig;
        memberQuestion = sig.SampleQuery;
        targetSecurity = sig.DefaultSecurity;
        targetSector = sig.DefaultSector;
        selectedConcern = sig.DefaultConcern;
        selectedScope = sig.DefaultScope;
        selectedObjective = sig.DefaultObjective;
        RefreshCalculations();
    }

    private void FilterCategory(SignalCategory? cat) => activeCategoryFilter = cat;

    private void SelectConcern(string key)
    {
        selectedConcern = key;
        RefreshCalculations();
    }

    private void SelectConcernAndProceed(string key)
    {
        selectedConcern = key;
        RefreshCalculations();
        GoToScreen(3);
    }

    private void SelectScope(string key)
    {
        selectedScope = key;
        RefreshCalculations();
    }

    private void SelectObjective(string key)
    {
        selectedObjective = key;
        RefreshCalculations();
    }

    private void SelectAction(string key)
    {
        selectedAction = key;
        RefreshCalculations();
    }

    private void GoToScreen(int nextScreen)
    {
        screen = Math.Clamp(nextScreen, 1, 8);
    }

    private void RecalculateScenarios()
    {
        RefreshCalculations();
    }

    private void ForkWithAdjustment(int extraStress)
    {
        stressAdjustment = extraStress;
        branchCreated = true;
        RefreshCalculations();
    }

    private void ForkWithDividend(decimal newDividend)
    {
        calcDividend = newDividend;
        branchCreated = true;
        RefreshCalculations();
    }

    private async Task SavePlanAsync()
    {
        if (planSaved || isSaving)
        {
            return;
        }

        var signal = selectedSignal;
        if (signal is null)
        {
            saveError = "Select a signal before saving this decision pathway.";
            return;
        }

        var user = (await AuthenticationStateTask).User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            saveError = "Sign in to save this decision pathway.";
            return;
        }

        isSaving = true;
        saveError = null;
        try
        {
            await DecisionPathwayService.SavePathwayAsync(new DecisionPathwayRecord
            {
                UserId = userId,
                CreatedAt = DateTimeOffset.UtcNow,
                SignalId = signal.Id,
                SignalTitle = signal.Title,
                ConcernKey = selectedConcern,
                ScopeKey = selectedScope,
                ObjectiveKey = selectedObjective,
                SelectedActionKey = selectedAction,
                CurrentSharePrice = calcPrice,
                AnnualDividendPerShare = calcDividend,
                HorizonLabel = checkpoint.ReviewHorizon,
                CheckpointTitle = checkpoint.Title,
                CheckpointTriggerCondition = checkpoint.TriggerCondition,
                Notes = string.IsNullOrWhiteSpace(memberQuestion) ? null : memberQuestion
            });

            planSaved = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save a Decision Pathway record.");
            saveError = "We could not save this decision pathway. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetPathway()
    {
        screen = 1;
        memberQuestion = string.Empty;
        intentResult = null;
        branchCreated = false;
        planSaved = false;
        isSaving = false;
        saveError = null;
        stressAdjustment = 0;
        calcPrice = 9.87m;
        calcDividend = 0.31m;
        selectedSignal = allSignals.FirstOrDefault();
        if (selectedSignal != null)
        {
            targetSecurity = selectedSignal.DefaultSecurity;
            targetSector = selectedSignal.DefaultSector;
            selectedConcern = selectedSignal.DefaultConcern;
            selectedScope = selectedSignal.DefaultScope;
            selectedObjective = selectedSignal.DefaultObjective;
        }
        RefreshCalculations();
    }

    private void RefreshCalculations()
    {
        var category = selectedSignal?.Category ?? SignalCategory.IndividualStock;
        impactMap = DecisionEngine.BuildImpactMap(category, selectedConcern, selectedScope, targetSecurity, targetSector);
        evaluatedOptions = DecisionEngine.EvaluateActionOptions(selectedObjective, selectedConcern);

        var calcInput = new ScenarioCalculationInput(calcPrice, calcDividend, null, "Several months", stressAdjustment);
        scenarios = DecisionEngine.CalculateScenarios(calcInput, selectedAction);
        checkpoint = DecisionEngine.GenerateCheckpoint(targetSecurity, selectedAction, "Several months");
    }

    private static string GetCategoryTone(SignalCategory cat) => cat switch
    {
        SignalCategory.IndividualStock => "tone-blue",
        SignalCategory.Sector => "tone-gold",
        SignalCategory.MalaysianMarket => "tone-green",
        SignalCategory.GlobalEconomy => "tone-red",
        SignalCategory.PortfolioDecision => "tone-purple",
        SignalCategory.Opportunity => "tone-green",
        _ => "tone-blue"
    };

    private static string GetCategoryIcon(SignalCategory cat) => cat switch
    {
        SignalCategory.IndividualStock => "ti ti-building-bank",
        SignalCategory.Sector => "ti ti-category",
        SignalCategory.MalaysianMarket => "ti ti-flag",
        SignalCategory.GlobalEconomy => "ti ti-world",
        SignalCategory.PortfolioDecision => "ti ti-chart-pie",
        SignalCategory.Opportunity => "ti ti-bulb",
        _ => "ti ti-sparkles"
    };
}
