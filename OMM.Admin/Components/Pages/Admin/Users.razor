@page "/admin/users"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using OMM.Admin.Services.Admin
@attribute [Authorize(Policy = "RequireAdminRole")]

@inject IUserManagementService UserManagementService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>User Management - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 font-display">User Management</h1>
            <p class="text-muted mb-0">Administrative accounts, roles, permission assignments, and audit logs.</p>
        </div>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
            <i class="ti ti-shield-lock me-1"></i> SuperAdmin Restricted
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-@_statusClass alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 mb-4" role="alert">
            <i class="ti @(_statusClass == "success" ? "ti-circle-check" : "ti-alert-circle") fs-5"></i>
            <div>@_statusMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => _statusMessage = null" aria-label="Close"></button>
        </div>
    }

    <AdminDataGrid TItem="UserListDto" Items="@_users" TotalCount="@_users.Count" IsLoading="@_isLoading" SearchPlaceholder="Search username, email or name..." OnSearchChanged="LoadUsersAsync">
        <ToolbarTemplate><AdminInviteModal /></ToolbarTemplate>
        <Columns>
            <GridColumn TItem="UserListDto" Field="@(user => user.UserName)" Title="Username" Sortable="true">
                <Template Context="user">
                    <div class="d-flex flex-column">
                        <span class="fw-bold text-dark font-monospace">@user.UserName</span>
                        @if (!string.IsNullOrWhiteSpace(user.DisplayName))
                        {
                            <span class="text-muted small">@user.DisplayName</span>
                        }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn TItem="UserListDto" Field="@(user => user.Email)" Title="Email" Sortable="true" />
            <GridColumn TItem="UserListDto" Field="@(user => user.Roles)" Title="Role(s)">
                <Template Context="user">
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge @(role == "SuperAdmin" ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                @role
                            </span>
                        }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn TItem="UserListDto" Field="@(user => user.EmailConfirmed)" Title="Email Confirmed">
                <Template Context="user">
                    @if (user.EmailConfirmed)
                    {
                        <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                            <i class="ti ti-check"></i> Confirmed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning d-inline-flex align-items-center gap-1">
                            <i class="ti ti-clock"></i> Pending
                        </span>
                    }
                </Template>
            </GridColumn>
            <GridColumn TItem="UserListDto" Field="@(user => user.MustChangePassword)" Title="Password Status">
                <Template Context="user">
                    @if (user.MustChangePassword)
                    {
                        <span class="badge bg-warning-subtle text-warning">Reset Required</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success">Active</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn TItem="UserListDto" Field="@(user => user.LockoutEnd)" Title="Account Status">
                <Template Context="user">
                    @if (user.LockoutEnd is not null)
                    {
                        <span class="badge bg-danger-subtle text-danger d-inline-flex align-items-center gap-1">
                            <i class="ti ti-lock"></i> Locked
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                            <i class="ti ti-lock-open"></i> Active
                        </span>
                    }
                </Template>
            </GridColumn>
        </Columns>
        <ActionColumn Context="user">
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-primary" title="Edit User" @onclick="@(() => OpenEditModal(user))">
                    <i class="ti ti-edit"></i>
                </button>
                <button class="btn btn-outline-secondary" title="Resend invite" @onclick="@(() => ResendInviteAsync(user.Id))">
                    <i class="ti ti-mail"></i>
                </button>
                <button class="btn btn-outline-warning" title="Force password reset" @onclick="@(() => ForceResetAsync(user.Id))">
                    <i class="ti ti-key"></i>
                </button>
                <button class="btn @(user.LockoutEnd is null ? "btn-outline-danger" : "btn-outline-success")"
                        title="@(user.Id == _currentUserId ? "Cannot lock your own active account" : (user.LockoutEnd is null ? "Lock account" : "Unlock account"))"
                        disabled="@(user.Id == _currentUserId)"
                        @onclick="@(() => ToggleLockAsync(user))">
                    <i class="ti @(user.LockoutEnd is null ? "ti-lock" : "ti-lock-open")"></i>
                </button>
            </div>
        </ActionColumn>
    </AdminDataGrid>
</div>

<UserEditModal IsOpen="@_isEditModalOpen"
               User="@_selectedUser"
               CurrentUserId="@_currentUserId"
               OnSave="HandleSaveUserAsync"
               OnClose="CloseEditModal" />

@code {
    private List<UserListDto> _users = [];
    private bool _isLoading;
    private string? _statusMessage;
    private string _statusClass = "success";
    private string _currentUserId = string.Empty;

    private bool _isEditModalOpen;
    private UserListDto? _selectedUser;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync(string? searchTerm = null)
    {
        _isLoading = true;
        _users = (await UserManagementService.ListAsync(searchTerm)).ToList();
        _isLoading = false;
    }

    private void OpenEditModal(UserListDto user)
    {
        _selectedUser = user;
        _isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        _isEditModalOpen = false;
        _selectedUser = null;
    }

    private async Task HandleSaveUserAsync(UserUpdateDto dto)
    {
        await ExecuteAsync(() => UserManagementService.UpdateUserAsync(_currentUserId, dto), "User updated successfully.");
        CloseEditModal();
    }

    private Task ResendInviteAsync(string userId) => ExecuteAsync(() => UserManagementService.ResendInviteAsync(userId, _currentUserId), "Invitation sent.");

    private Task ForceResetAsync(string userId) => ExecuteAsync(() => UserManagementService.ForcePasswordResetAsync(userId, _currentUserId), "Password reset required.");

    private Task ToggleLockAsync(UserListDto user) => ExecuteAsync(
        () => UserManagementService.SetLockoutAsync(_currentUserId, user.Id, user.LockoutEnd is null),
        user.LockoutEnd is null ? "Account locked." : "Account unlocked.");

    private async Task ExecuteAsync(Func<Task<Microsoft.AspNetCore.Identity.IdentityResult>> operation, string successMessage)
    {
        var result = await operation();
        _statusClass = result.Succeeded ? "success" : "danger";
        _statusMessage = result.Succeeded ? successMessage : string.Join(" ", result.Errors.Select(error => error.Description));
        if (result.Succeeded)
            await LoadUsersAsync();
    }
}
