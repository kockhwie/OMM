                        </div>

                        <div class="card border-0 rounded-4">
                        <!-- Growth section -->
                        <div class="card-header bg-dark">  
                            <div class="dc-section-title text-gold"><i class="ti ti-pig-money text-gold"></i> Growth &amp; Horizon</div>
                        </div>
                        <div class="card-body">
                            <div class="dc-section">
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label" for="sim-price-growth">Price Growth (% p.a.)</label>
                                        <div class="dc-currency-group">
                                            <input id="sim-price-growth" type="number" class="form-control" step="0.5"
                                                   placeholder="0" @bind="simPriceGrowth" @bind:event="oninput" />
