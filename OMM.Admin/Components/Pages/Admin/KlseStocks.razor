@page "/admin/klse-stocks"

<PageTitle>KLSE Stocks - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">KLSE Stocks</h1>
            <p class="text-muted mb-0">Manage Malaysian equity securities, tickers, and financial ratios.</p>
        </div>
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
            <i class="ti ti-clock me-1"></i> Coming in Phase 5
        </span>
    </div>

    <div class="omm-card p-5 text-center">
        <div class="stat-icon-wrapper bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem; border-radius: 16px;">
            <i class="ti ti-chart-candle"></i>
        </div>
        <h2 class="h4 fw-bold mb-2">KLSE Stocks Management</h2>
        <p class="text-muted max-w-md mx-auto mb-4" style="max-width: 480px;">
            Stock master CRUD, scrapers, search, sorting, pagination, and ratio calculations via <code>AdminDataGrid</code> will be available in Phase 5.
        </p>
        <div>
            <a href="admin" class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
