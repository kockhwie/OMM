@page "/settings"
@layout DashboardLayout
@attribute [Authorize]
@using OMM.Public.Services
@inject IMinerProfileService ProfileService

<PageTitle>Settings & Preferences — OhMyMine</PageTitle>

<div class="mb-4 animate-fade-up">
    <h1 class="h3 fw-bold text-dark font-display mb-1">Account & Preferences</h1>
    <p class="text-muted small mb-0">Manage your miner profile, localization parameters, and data settings</p>
</div>

@if (loading)
{
    <div class="alert alert-info">Loading your profile settings…</div>
}
else if (savedNotification)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4 animate-fade-up" role="alert">
        <i class="ti ti-circle-check fs-4"></i>
        <span>Settings have been updated successfully!</span>
        <button type="button" class="btn-close" @onclick="() => savedNotification = false"></button>
    </div>
}

@if (!string.IsNullOrEmpty(inputError))
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="ti ti-alert-circle fs-4"></i>
        <span>@inputError</span>
        <button type="button" class="btn-close" @onclick="() => inputError = null"></button>
    </div>
}

<div class="row g-4 mb-4">
    <!-- 1. Profile Details -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 animate-fade-up">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-3 bg-dark text-warning p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="ti ti-user fs-4"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-dark font-display mb-0">Miner Identity</h3>
                    <small class="text-muted">Account owner and contact info</small>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label text-dark">Miner Name</label>
                    <input type="text" class="form-control rounded-3" @bind="displayName" maxlength="200" />
                </div>
                <div>
                    <label class="form-label text-dark">Email Address</label>
                    <input type="email" class="form-control rounded-3 bg-light" value="@profile?.Email" readonly />
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label text-dark">Country</label>
                        <select class="form-select rounded-3" @bind="countryId">
                            <option value="">Choose country</option>
                            @foreach (var country in countries)
                            {
                                <option value="@country.Id">@country.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-dark">Member Since</label>
                        <input type="text" class="form-control rounded-3 bg-light" value="@profile?.CreatedAt.ToString("yyyy-MM-dd")" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Regional & Currency -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 animate-fade-up">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-3 bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="ti ti-world fs-4"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-dark font-display mb-0">Regional Calibration</h3>
                    <small class="text-muted">Currency, language, and market standards</small>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label text-dark">Primary Base Currency</label>
                    <select class="form-select rounded-3" @bind="currencyId">
                        <option value="">Choose currency</option>
                        @foreach (var currency in currencies)
                        {
                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label text-dark">Display Language</label>
                    <select class="form-select rounded-3" @bind="language">
                        <option value="">Choose language</option>
                        <option value="English">English</option>
                        <option value="Bahasa Malaysia">Bahasa Malaysia</option>
                        <option value="Chinese">中文 (简体)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Smart Notifications & Reminders -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 animate-fade-up">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-3 bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="ti ti-bell fs-4"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-dark font-display mb-0">Smart Mining Alerts</h3>
                    <small class="text-muted">Proactive notifications for your portfolio</small>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light-subtle">
                    <div>
                        <div class="fw-semibold text-dark small">FD Maturity Alerts (14 Days)</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Receive notice prior to fixed deposit maturity dates</div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light-subtle">
                    <div>
                        <div class="fw-semibold text-dark small">Goal Milestone Notifications</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Alert when crossing 25%, 50%, 75%, and 100% of goals</div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between py-2">
                    <div>
                        <div class="fw-semibold text-dark small">Data Freshness Reminders</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Nudge if stock and gold values are older than 30 days</div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Privacy & Data Architecture -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 animate-fade-up">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-3 bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="ti ti-shield-lock fs-4"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-dark font-display mb-0">Privacy & Sovereignty</h3>
                    <small class="text-muted">Data custody and storage boundaries</small>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 rounded-4 bg-light border border-light-subtle">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="ti ti-database text-success fs-5"></i>
                        <strong class="text-dark small">Local Architecture Ready</strong>
                    </div>
                    <p class="text-muted small mb-0" style="line-height: 1.5;">
                        Your financial portfolio logic runs via <code>IMineService</code> on your local server. No third-party ad networks or trackers are loaded.
                    </p>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button class="btn btn-outline-dark btn-sm rounded-3 px-3 fw-medium d-inline-flex align-items-center gap-2" @onclick="ExportData">
                        <i class="ti ti-download"></i>
                        <span>Export Data (JSON)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Save Button Bar -->
<div class="d-flex justify-content-end mb-5 animate-fade-up">
    <button class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm" @onclick="SavePreferences" disabled="@loading">
        Save All Changes
    </button>
</div>

<!-- Danger Zone -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
    <h3 class="h6 fw-bold text-danger font-display mb-1">Account & Session Actions</h3>
    <p class="text-muted small mb-4">Sign out of your active session</p>
    <div class="d-flex flex-wrap gap-2">
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="/" />
            <button type="submit" class="btn btn-outline-danger rounded-3 px-3 fw-medium d-inline-flex align-items-center gap-2">
                <i class="ti ti-logout"></i>
                <span>Sign Out</span>
            </button>
        </form>
    </div>
</div>

@code {
    private MinerProfileView? profile;
    private IReadOnlyList<ProfileCurrencyOption> currencies = [];
    private IReadOnlyList<ProfileCountryOption> countries = [];
    private string? displayName;
    private int? countryId;
    private int? currencyId;
    private string? language;
    private bool loading = true;
    private bool savedNotification = false;
    private string? inputError;

    protected override async Task OnInitializedAsync()
    {
        profile = await ProfileService.GetCurrentAsync() ?? await ProfileService.CreateIfMissingAsync();
        currencies = await ProfileService.GetCurrencyOptionsAsync();
        countries = await ProfileService.GetCountryOptionsAsync();
        LoadForm();
        loading = false;
    }

    private async Task SavePreferences()
    {
        inputError = PublicInputValidator.GetDisplayTextError("Miner name", displayName ?? string.Empty);
        if (inputError is not null)
        {
            savedNotification = false;
            return;
        }

        try
        {
            profile = await ProfileService.UpdateCurrentAsync(
                new MinerProfileUpdate(displayName, countryId, currencyId, language));
            LoadForm();
        }
        catch (ArgumentException exception)
        {
            inputError = exception.Message;
            savedNotification = false;
            return;
        }

        savedNotification = true;
    }

    private void LoadForm()
    {
        displayName = profile?.DisplayName;
        countryId = profile?.CountryId;
        currencyId = profile?.CurrencyId;
        language = profile?.Language;
    }

    private void ExportData()
    {
        savedNotification = true;
    }
}
