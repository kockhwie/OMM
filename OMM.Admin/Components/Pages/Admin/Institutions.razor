@page "/admin/institutions"

<PageTitle>Financial Institutions - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Financial Institutions</h1>
            <p class="text-muted mb-0">Configure banking partners, brokers, EPF/KWSP, and gold providers.</p>
        </div>
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
            <i class="ti ti-clock me-1"></i> Coming in Phase 6
        </span>
    </div>

    <div class="omm-card p-5 text-center">
        <div class="stat-icon-wrapper bg-success-subtle text-success mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem; border-radius: 16px;">
            <i class="ti ti-building-bank"></i>
        </div>
        <h2 class="h4 fw-bold mb-2">Institutions Master</h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
            Financial institution catalog, category management (Banks, Brokers, EPF/KWSP, Insurance), and institution-specific settings will be available in Phase 6.
        </p>
        <div>
            <a href="admin" class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
