@namespace OMM.Public.Components.Shared

<a href="@Href" class="omm-logo d-inline-flex align-items-center gap-2 text-decoration-none group">
    <div class="omm-logo-mark d-flex align-items-center justify-content-center @IconSizeClass @IconBgClass">
        <i class="ti ti-yarn @IconFontSizeClass"></i>
    </div>
    <div class="omm-logo-copy d-flex flex-column">
        <span class="omm-logo-title @TextSizeClass @TextClass font-display fw-bold">
            OhMyMine
        </span>
        <span class="omm-logo-tagline text-uppercase @(TaglineTwoLines ? "omm-logo-tagline-two-line" : string.Empty)">
            @if (TaglineTwoLines)
            {
                <span>Personal Wealth</span>
                <span>Planning</span>
            }
            else
            {
                @:Personal Wealth Planning
            }
        </span>
    </div>
</a>

@code {
    [Parameter] public string Variant { get; set; } = "dark"; // "dark" | "light"
    [Parameter] public string Size { get; set; } = "md"; // "sm" | "md" | "lg"
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public bool TaglineTwoLines { get; set; }

    private string TextClass => Variant == "dark" ? "text-dark" : "text-white";
    private string SubTextClass => Variant == "dark" ? "text-muted" : "text-light-50 text-white-50";
    private string IconBgClass => Variant == "dark" ? "bg-dark text-warning" : "bg-warning text-dark";

    private string IconSizeClass => Size switch
    {
        "sm" => "p-1",
        "lg" => "p-2",
        _ => "p-2"
    };

    private string IconFontSizeClass => Size switch
    {
        "sm" => "fs-6",
        "lg" => "fs-4",
        _ => "fs-5"
    };

    private string TextSizeClass => Size switch
    {
        "sm" => "fs-6",
        "lg" => "fs-4",
        _ => "fs-5"
    };
}
