@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex min-vh-100">
    <!-- Desktop Sidebar -->
    <aside class="d-none d-lg-flex flex-column position-fixed top-0 bottom-0 start-0 admin-sidebar @(isDesktopSidebarCollapsed ? "is-collapsed" : string.Empty)">
        <div class="admin-brand">
            <div class="d-flex align-items-center gap-2">
                <span class="font-display fw-bold text-white fs-5 tracking-tight">OMM</span>
                <span class="admin-badge sidebar-label">Admin</span>
            </div>
        </div>
        <button type="button" class="sidebar-collapse-toggle" @onclick="ToggleDesktopSidebar" aria-label="@(isDesktopSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" title="@(isDesktopSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" data-bs-toggle="tooltip" data-bs-placement="right">
            <i class="ti @(isDesktopSidebarCollapsed ? "ti-chevron-right" : "ti-chevron-left")"></i>
        </button>

        <nav class="flex-grow-1 px-3 py-3 overflow-y-auto d-flex flex-column gap-1">
            <NavLink class="sidebar-link" href="admin" Match="NavLinkMatch.All" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                <i class="ti ti-layout-dashboard"></i>
                <span class="sidebar-label">Dashboard</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/klse-stocks" data-bs-toggle="tooltip" data-bs-placement="right" title="KLSE Stocks">
                <i class="ti ti-chart-candle"></i>
                <span class="sidebar-label">KLSE Stocks</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/institutions" data-bs-toggle="tooltip" data-bs-placement="right" title="Institutions">
                <i class="ti ti-building-bank"></i>
                <span class="sidebar-label">Institutions</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/markets-sectors" data-bs-toggle="tooltip" data-bs-placement="right" title="Markets & Sectors">
                <i class="ti ti-database"></i>
                <span class="sidebar-label">Markets & Sectors</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/users" data-bs-toggle="tooltip" data-bs-placement="right" title="Users">
                <i class="ti ti-users"></i>
                <span class="sidebar-label">Users</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/members" data-bs-toggle="tooltip" data-bs-placement="right" title="Members">
                <i class="ti ti-user-check"></i>
                <span class="sidebar-label">Members</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/audit-log" data-bs-toggle="tooltip" data-bs-placement="right" title="Audit Log">
                <i class="ti ti-history"></i>
                <span class="sidebar-label">Audit Log</span>
            </NavLink>
            <NavLink class="sidebar-link" href="admin/email-test" data-bs-toggle="tooltip" data-bs-placement="right" title="Test Email">
                <i class="ti ti-mail-check"></i>
                <span class="sidebar-label">Test Email</span>
            </NavLink>
        </nav>

        <div class="admin-sidebar-footer p-3 border-top">
            <form action="Account/Logout" method="post" class="w-100">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="/login" />
                <button type="submit" class="sidebar-link sidebar-signout w-100 border-0 bg-transparent text-start text-danger" data-bs-toggle="tooltip" data-bs-placement="right" title="Sign Out" aria-label="Sign Out">
                    <i class="ti ti-logout"></i>
                    <span class="sidebar-label">Sign Out</span>
                </button>
            </form>
        </div>
        <div class="admin-sidebar-footer p-3 border-top">
            <div class="d-flex align-items-center justify-content-between small px-2 mb-2">
                <span class="badge admin-sidebar-meta bg-secondary-subtle text-secondary sidebar-label">OMM Admin v2.0</span>
            </div>
        </div>
        <div class="admin-sidebar-footer p-3 border-top">
            <div class="d-flex align-items-center justify-content-between small px-2 mb-2">
                <span class="badge admin-sidebar-meta bg-secondary-subtle text-secondary sidebar-label">Neon PG</span>
            </div>

        </div>
    </aside>

    <!-- Mobile Sidebar Offcanvas -->
    @if (isMobileNavOpen)
    {
        <div class="admin-mobile-overlay position-fixed top-0 bottom-0 start-0 end-0 d-lg-none">
            <div class="position-absolute top-0 bottom-0 start-0 end-0 bg-dark opacity-50" @onclick="ToggleMobileNav"></div>
            <div class="admin-mobile-sidebar position-relative admin-sidebar h-100 d-flex flex-column">
                <div class="admin-brand">
                    <div class="d-flex align-items-center gap-2">
                        <span class="font-display fw-bold text-white fs-5 tracking-tight">OMM</span>
                        <span class="admin-badge">Admin</span>
                    </div>
                    <button class="btn btn-sm text-white" @onclick="ToggleMobileNav" aria-label="Close menu">
                        <i class="ti ti-x fs-4"></i>
                    </button>
                </div>
                <nav class="flex-grow-1 px-3 py-3 overflow-y-auto d-flex flex-column gap-1">
                    <NavLink class="sidebar-link" href="admin" Match="NavLinkMatch.All" @onclick="ToggleMobileNav">
                        <i class="ti ti-layout-dashboard"></i>
                        <span>Dashboard</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/klse-stocks" @onclick="ToggleMobileNav">
                        <i class="ti ti-chart-candle"></i>
                        <span>KLSE Stocks</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/institutions" @onclick="ToggleMobileNav">
                        <i class="ti ti-building-bank"></i>
                        <span>Institutions</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/markets-sectors" @onclick="ToggleMobileNav">
                        <i class="ti ti-database"></i>
                        <span>Markets & Sectors</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/users" @onclick="ToggleMobileNav">
                        <i class="ti ti-users"></i>
                        <span>Users</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/members" @onclick="ToggleMobileNav">
                        <i class="ti ti-user-check"></i>
                        <span>Members</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/audit-log" @onclick="ToggleMobileNav">
                        <i class="ti ti-history"></i>
                        <span>Audit Log</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/email-test" @onclick="ToggleMobileNav">
                        <i class="ti ti-mail-check"></i>
                        <span>Test Email</span>
                    </NavLink>
                </nav>
                <div class="admin-sidebar-footer p-3 border-top">
                    <form action="Account/Logout" method="post" class="w-100">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/login" />
                        <button type="submit" class="sidebar-link sidebar-signout w-100 border-0 bg-transparent text-start text-danger">
                            <i class="ti ti-logout"></i>
                            <span>Sign Out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Area -->
    <div class="flex-grow-1 d-flex flex-column admin-content-shell @(isDesktopSidebarCollapsed ? "sidebar-collapsed" : string.Empty)">
        <!-- Top Bar -->
        <header class="sticky-top admin-topbar admin-mobile-topbar px-4 px-lg-5 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm d-lg-none p-1 text-dark border-0" @onclick="ToggleMobileNav" aria-label="Toggle navigation">
                    <i class="ti ti-menu-2 fs-4"></i>
                </button>
            </div>

            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-user-summary text-end d-none d-sm-block">
                                <div class="admin-user-name fw-semibold text-dark">@context.User.Identity?.Name</div>
                                <div class="admin-user-role text-muted">Administrator</div>
                            </div>
                            <form action="Account/Logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="/login" />
                                <button type="submit" class="btn btn-sm btn-outline-danger admin-mobile-signout d-flex align-items-center gap-1 px-3 py-1 rounded-2 shadow-none" title="Sign Out" aria-label="Sign Out">
                                    <i class="ti ti-logout"></i>
                                    <span class="admin-mobile-signout-label">Sign Out</span>
                                </button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-sm btn-danger">Log In</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Main Body -->
        <main class="admin-main flex-grow-1 px-4 px-lg-5 py-4 w-100">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isMobileNavOpen = false;
    private bool isDesktopSidebarCollapsed = false;

    private void ToggleMobileNav() => isMobileNavOpen = !isMobileNavOpen;

    private void ToggleDesktopSidebar() => isDesktopSidebarCollapsed = !isDesktopSidebarCollapsed;
}
