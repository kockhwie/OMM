        }
    }

    private void RecalculateSavings()
    {
        workingMine.PurchaseCost = workingMine.CurrentValue;
        workingMine.Growth = 0;
        workingMine.GrowthPct = 0;

        if (metadata.InterestRatePct.HasValue && metadata.InterestRatePct > 0)
        {
            var annual = workingMine.CurrentValue * (metadata.InterestRatePct.Value / 100m);
            workingMine.MonthlyIncome = Math.Round(annual / 12m, 2);
        }
        workingMine.Holdings = $"{metadata.InterestRatePct ?? 0:0.00}% p.a. - {savingsClassTemp}";
    }

    private void RecalculateCash()
    {
        workingMine.PurchaseCost = workingMine.CurrentValue;
        workingMine.MonthlyIncome = 0;
        workingMine.Growth = 0;
        workingMine.GrowthPct = 0;
        workingMine.Holdings = "Physical cash";
    }

    private void ComputeGrowth()
    {
        if (workingMine.PurchaseCost > 0)
        {
            workingMine.Growth = workingMine.CurrentValue - workingMine.PurchaseCost;
            workingMine.GrowthPct = Math.Round((workingMine.Growth / workingMine.PurchaseCost) * 100m, 1);
        }
        else
        {
            workingMine.Growth = 0;
            workingMine.GrowthPct = 0;
        }
    }

