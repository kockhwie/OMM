@namespace OMM.Public.Components.Shared

<div class="w-100">
    @if (ShowLabel)
    {
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted" style="font-size: 0.8rem; font-weight: 500;">@Label</span>
            <span class="text-dark fw-bold" style="font-size: 0.8rem;">@((int)EffectivePercentage)%</span>
        </div>
    }
    <div class="progress" style="height: @Height; border-radius: 9999px; background-color: var(--omm-ink-200);">
        <div class="progress-bar @BarColorClass" role="progressbar" 
             style="width: @(Math.Clamp(EffectivePercentage, 0, 100))%; border-radius: 9999px;" 
             aria-valuenow="@EffectivePercentage" aria-valuemin="0" aria-valuemax="100">
        </div>
    </div>
</div>

@code {

    [Parameter] public decimal Percentage { get; set; }
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public string Height { get; set; } = "8px";
    [Parameter] public string Variant { get; set; } = "primary"; // primary, mine, burden, warning, clay, success, danger
    [Parameter] public string? ColorClass { get; set; }
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public string? Label { get; set; }

    private decimal EffectivePercentage => Value ?? Percentage;

    private string BarColorClass => !string.IsNullOrEmpty(ColorClass) ? ColorClass : Variant switch
    {
        "mine" or "success" => "bg-success",
        "burden" or "danger" => "bg-danger",
        "warning" => "bg-warning",
        "clay" => "bg-warning",
        _ => "bg-dark"
    };
}
