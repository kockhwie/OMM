    private void GoNext()
    {
        ClearValidation();

        if (step == 1)
        {
            var nameError = PublicInputValidator.GetDisplayTextError("Mine name", workingMine.Name);
            if (nameError != null)
            {
                SetValidationError("mine-name", nameError);
                _ = FocusInvalidFieldAsync();
                return;
            }
            step = 2;
        }
        else if (step == 2)
        {
            if (!ValidateStepTwo())
            {
                _ = FocusInvalidFieldAsync();
                return;
            }
            if (workingMine.PurchaseCost < 0 || workingMine.MonthlyIncome < 0)
            {
                SetFieldError(null, "Purchase cost and monthly income cannot be negative.");
                _ = FocusInvalidFieldAsync();
                return;
            }

            var holdingsError = PublicInputValidator.GetDisplayTextError("Holdings / details", workingMine.Holdings, optional: true);
            if (holdingsError is not null)
            {
                SetValidationError("mine-holdings-text", "The 'Holdings / Notes' field contains unsupported characters. Use standard letters, numbers, spaces, and basic punctuation.");
                _ = FocusInvalidFieldAsync();
                return;
            }

            ComputeGrowth();
            step = 3;
        }
    }

    private bool ValidateStepTwo()
    {
        switch (workingMine.Type)
        {
            case MineType.EpfKwsp when workingMine.CurrentValue <= 0:
                return SetValidationError("epf-akaun1", "Enter a value greater than zero.");
            case MineType.SavingsAccount when workingMine.CurrentValue <= 0:
                return SetValidationError("savings-balance", "Enter a value greater than zero.");
            case MineType.CashInHand when workingMine.CurrentValue <= 0:
                return SetValidationError("cash-balance", "Enter a value greater than zero.");
            case MineType.FixedDeposit when (metadata.Principal ?? 0) <= 0:
                return SetValidationError("fd-principal", "Enter a principal amount greater than zero.");
            case MineType.FixedDeposit when (metadata.InterestRatePct ?? 0) <= 0:
                return SetValidationError("fd-rate", "Enter an interest rate greater than zero.");
            case MineType.FixedDeposit when (metadata.TenureMonths ?? 0) <= 0:
                return SetValidationError("fd-tenure", "Select a tenure greater than zero.");
            case MineType.FixedDeposit when !metadata.PlacementDate.HasValue:
                return SetValidationError("fd-placement", "Enter the placement date.");
            case MineType.ForeignCurrency when string.IsNullOrWhiteSpace(metadata.ForeignCurrencyCode):
                return SetValidationError("fx-code", "Enter a foreign currency code.");
            case MineType.ForeignCurrency when string.IsNullOrWhiteSpace(metadata.CurrencyCustodyType):
                return SetValidationError("fx-custody", "Select where the currency is held.");
            case MineType.ForeignCurrency when foreignInitialAmount <= 0:
                return SetValidationError("fx-amount", "Enter the foreign currency amount received.");
            case MineType.ForeignCurrency when foreignInitialMyrAmount <= 0:
                return SetValidationError("fx-myr", "Enter the MYR amount paid.");
            case MineType.ForeignCurrency when foreignInitialRate <= 0:
                return SetValidationError("fx-rate", "Enter a valid exchange rate.");
            case MineType.UnitTrustAsb when string.IsNullOrWhiteSpace(metadata.FundCode):
                return SetValidationError("asb-fund", "Select an ASB or ASM fund.");
            case MineType.UnitTrustAsb when (metadata.UnitsHeld ?? 0) <= 0:
                return SetValidationError("asb-units", "Enter units held greater than zero.");
            case MineType.UnitTrustGeneral when string.IsNullOrWhiteSpace(metadata.FundCode):
                return SetValidationError("fund-name", "Enter the fund name or code.");
            case MineType.UnitTrustGeneral when (metadata.UnitsHeld ?? 0) <= 0:
                return SetValidationError("fund-units", "Enter units held greater than zero.");
            case MineType.Stocks or MineType.StocksUs or MineType.Reit or MineType.Etf when string.IsNullOrWhiteSpace(metadata.StockCode):
                return SetValidationError(workingMine.Type == MineType.StocksUs ? "us-symbol" : "stock-code", "Enter a stock or fund code.");
            case MineType.Stocks or MineType.StocksUs or MineType.Reit or MineType.Etf when (metadata.SharesOwned ?? 0) <= 0:
                return SetValidationError(workingMine.Type == MineType.StocksUs ? "us-shares" : "stock-shares", "Enter shares owned greater than zero.");
            case MineType.PropertyResidential or MineType.PropertyCommercial when string.IsNullOrWhiteSpace(metadata.Address):
                return SetValidationError("prop-address", "Enter the property address or unit.");
            case MineType.PropertyResidential or MineType.PropertyCommercial when string.IsNullOrWhiteSpace(metadata.PropertyType):
                return SetValidationError("prop-type", "Select a property type.");
            case MineType.Gold or MineType.Silver when string.IsNullOrWhiteSpace(metadata.GoldForm):
                return SetValidationError("metal-form", "Select a holding type.");
            case MineType.Gold or MineType.Silver when (metadata.WeightGrams ?? 0) <= 0:
                return SetValidationError("metal-weight", "Enter weight greater than zero.");
            case MineType.Gold or MineType.Silver when workingMine.PurchaseCost <= 0:
                return SetValidationError("metal-cost", "Enter the total purchase cost greater than zero.");
            case MineType.Cryptocurrency when string.IsNullOrWhiteSpace(metadata.CoinSymbol):
                return SetValidationError("crypto-symbol", "Enter a coin symbol.");
            case MineType.Cryptocurrency when (metadata.CoinsHeld ?? 0) <= 0:
                return SetValidationError("crypto-qty", "Enter coins held greater than zero.");
            case MineType.Others when workingMine.CurrentValue <= 0:
                return SetValidationError("mine-current-val", "Enter a value greater than zero.");
        }

        return true;
    }

