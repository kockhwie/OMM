    protected override void OnParametersSet()
    {
        if (!IsOpen) return;

        inputError = null;
        step = 1;
        archiveYieldHistory = false;

        if (ExistingMine != null)
        {
            workingMine = new Mine
            {
                Id = ExistingMine.Id,
                Name = ExistingMine.Name,
                Category = ExistingMine.Category,
                Type = ExistingMine.Type,
                Institution = ExistingMine.Institution,
                Currency = ExistingMine.Currency,
                CurrentValue = ExistingMine.CurrentValue,
                PurchaseCost = ExistingMine.PurchaseCost,
                Growth = ExistingMine.Growth,
                GrowthPct = ExistingMine.GrowthPct,
                MonthlyIncome = ExistingMine.MonthlyIncome,
                Holdings = ExistingMine.Holdings,
                 ForeignCurrencyTransactions = ExistingMine.ForeignCurrencyTransactions?.ToList() ?? [],
                LinkedBurdenId = ExistingMine.LinkedBurdenId,
                Status = ExistingMine.Status,
                UpdatedAt = ExistingMine.UpdatedAt,
                Metadata = ExistingMine.Metadata
            };

            metadata = ExistingMine.Metadata != null
                ? System.Text.Json.JsonSerializer.Deserialize<MineMetadata>(
                    System.Text.Json.JsonSerializer.Serialize(ExistingMine.Metadata)) ?? new MineMetadata()
                : new MineMetadata();

            currentNavTemp = metadata.NavPerUnit;
        }
        else
        {
            var defaultCategory = MineCategory.Investments;
            workingMine = new Mine
            {
                Category = defaultCategory,
                Type = FormatHelper.GetTypesForCategory(defaultCategory)[0],
                Currency = string.Empty,
                Status = "active"
            };
            metadata = new MineMetadata();
            currentNavTemp = null;
        }

        InitializeForeignCurrencyState();

        if (workingMine.Type == MineType.FixedDeposit)
        {
            metadata.PlacementDate ??= DateOnly.FromDateTime(DateTime.Today);
        }
    }

    private void InitializeForeignCurrencyState()
    {
        if (workingMine.Type != MineType.ForeignCurrency) return;

        var initialTransaction = workingMine.ForeignCurrencyTransactions?
            .Where(item => item.TransactionType == ForeignCurrencyTransactionType.Purchase)
            .OrderBy(item => item.TransactionDate)
            .FirstOrDefault();

        if (initialTransaction is not null)
        {
            foreignInitialDate = initialTransaction.TransactionDate;
            foreignInitialAmount = initialTransaction.ForeignAmount;
            foreignInitialAmountInput = foreignInitialAmount.ToString("0.00########", CultureInfo.InvariantCulture);
            foreignInitialMyrAmount = initialTransaction.MyrAmount;
            foreignInitialRate = initialTransaction.ExchangeRate;
            foreignInitialFees = initialTransaction.FeesMyr;
        }
        else
        {
            foreignInitialDate = DateOnly.FromDateTime(DateTime.Today);
            foreignInitialAmount = 0;
            foreignInitialAmountInput = string.Empty;
            foreignInitialMyrAmount = 0;
            foreignInitialRate = 0;
            foreignInitialFees = 0;
        }

        RecalculateForeignCurrency();
    }

    private void RecalculateForeignCurrency()
    {
        foreignInitialRate = foreignInitialMyrAmount > 0
            ? Math.Round(foreignInitialAmount / foreignInitialMyrAmount, 8)
            : 0;
        workingMine.PurchaseCost = foreignInitialMyrAmount + foreignInitialFees;
        workingMine.CurrentValue = metadata.CurrentSellRate is > 0 && foreignInitialAmount > 0
            ? Math.Round(foreignInitialAmount / metadata.CurrentSellRate.Value, 2)
            : 0;
        workingMine.MonthlyIncome = 0;
        workingMine.Growth = workingMine.CurrentValue > 0
            ? workingMine.CurrentValue - workingMine.PurchaseCost
            : 0;
        workingMine.GrowthPct = workingMine.PurchaseCost > 0 && workingMine.CurrentValue > 0
            ? Math.Round(workingMine.Growth / workingMine.PurchaseCost * 100m, 1)
            : 0;
        workingMine.Holdings = foreignInitialAmount > 0
            ? $"{foreignInitialAmount:N2} {metadata.ForeignCurrencyCode?.ToUpperInvariant()}"
            : null;
    }

    private void OnForeignInitialDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            foreignInitialDate = date;
        }
    }

    private void OnForeignAmountChanged(ChangeEventArgs e)
    {
        foreignInitialAmountInput = e.Value?.ToString() ?? string.Empty;
        if (decimal.TryParse(foreignInitialAmountInput, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount))
        {
            foreignInitialAmount = amount;
            RecalculateForeignCurrency();
        }
    }

