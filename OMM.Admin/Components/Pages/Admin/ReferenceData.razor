@page "/admin/reference-data"

<PageTitle>Markets & Sectors - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Markets & Sectors</h1>
            <p class="text-muted mb-0">Reference data taxonomy including countries, exchanges, markets, sectors, and sub-sectors.</p>
        </div>
        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
            <i class="ti ti-lock me-1"></i> Read-Only Reference Data
        </span>
    </div>

    <div class="omm-card p-5 text-center">
        <div class="stat-icon-wrapper bg-warning-subtle text-warning mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem; border-radius: 16px;">
            <i class="ti ti-world"></i>
        </div>
        <h2 class="h4 fw-bold mb-2">Reference Data Taxonomy</h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
            Countries, Exchanges, Markets, Sectors, and Sub-Sectors are seeded master taxonomy data. An interactive explorer will be delivered in a future update.
        </p>
        <div>
            <a href="admin" class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
