@page "/income"
@layout DashboardLayout
@attribute [Authorize]
@using OMM.Public.Services
@inject MemberRecordService RecordService
@inject DatabaseMineService MineService
@inject IMinerProfileService ProfileService
@inject NavigationManager Navigation

<PageTitle>Income Classification - OhMyMine</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 animate-fade-up">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">Income</h1>
        <p class="text-muted small mb-0">
            Classify every dollar by source to track your journey to recurring passive freedom
        </p>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="OpenAddModal">
        <i class="ti ti-plus fs-5"></i>
        <span>Add Income</span>
    </button>
</div>

<!-- 4 KPI Summary Cards -->
<div class="row g-3 mb-4 animate-fade-up">
    <!-- Active Income / mo -->
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted mb-2">
                <div class="rounded-circle bg-dark-subtle text-dark p-2 d-flex align-items-center justify-content-center omm-summary-icon">
                    <i class="ti ti-briefcase fs-5"></i>
                </div>
                <span class="text-uppercase fw-semibold omm-summary-label">Active / month</span>
            </div>
            <div class="fs-3 fw-bold text-dark font-display">
                @ActiveMonthlyDisplay
            </div>
            <small class="text-muted mt-1 d-block">Salaries, client retainers</small>
        </div>
    </div>

    <!-- Passive Income / mo -->
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted mb-2">
                <div class="rounded-circle bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center omm-summary-icon">
                    <i class="ti ti-bolt fs-5"></i>
                </div>
                <span class="text-uppercase fw-semibold omm-summary-label">Passive / month</span>
            </div>
            <div class="fs-3 fw-bold text-success font-display">
                @PassiveMonthlyDisplay
            </div>
            <small class="text-muted mt-1 d-block">Incl. annual yield ÷ 12</small>
        </div>
    </div>

    <!-- Non-recurring -->
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted mb-2">
                <div class="rounded-circle bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center omm-summary-icon">
                    <i class="ti ti-gift fs-5"></i>
                </div>
                <span class="text-uppercase fw-semibold omm-summary-label">Non-recurring</span>
            </div>
            <div class="fs-3 fw-bold text-dark font-display">
                @NonRecurringDisplay
            </div>
            <small class="text-muted mt-1 d-block">Bonuses, one-off windfalls</small>
        </div>
    </div>

    <!-- Total Annual Inflow -->
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted mb-2">
                <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center omm-summary-icon">
                    <i class="ti ti-calendar fs-5"></i>
                </div>
                <span class="text-uppercase fw-semibold omm-summary-label">Total Annual</span>
            </div>
            <div class="fs-3 fw-bold text-dark font-display">
                @TotalAnnualInflowDisplay
            </div>
            <small class="text-muted mt-1 d-block">All sources annualized</small>
        </div>
    </div>
</div>

<!-- Classification Filter Buttons -->
<div class="d-flex flex-wrap gap-1 align-items-center mb-4 animate-fade-up">
    <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(selectedClass == null ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
            @onclick="() => selectedClass = null">
        All 
    </button>
    @foreach (var cls in Enum.GetValues<IncomeClass>())
    {
        var isSelected = selectedClass == cls;
        <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(isSelected ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
                @onclick="() => selectedClass = cls">
            @FormatHelper.IncomeClassLabel(cls)
        </button>
    }
</div>

<div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-4">
    <label class="small text-muted fw-semibold mb-0" for="income-sort">Sort by</label>
    <select id="income-sort" class="form-select form-select-sm w-auto rounded-3" @bind="sortField">
        <option value="modified">Last modified</option>
        <option value="created">Date created</option>
        <option value="source">Source</option>
        <option value="classification">Classification</option>
        <option value="event-date">Event date</option>
    </select>
    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 d-inline-flex align-items-center gap-1" @onclick="ToggleSortDirection">
        <i class="ti @(sortDescending ? "ti-sort-descending" : "ti-sort-ascending")"></i>
        <span>@(sortDescending ? "Descending" : "Ascending")</span>
    </button>
</div>

<!-- Income Stream List -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white animate-fade-up">
    @if (FilteredRecords.Count > 0)
    {
        <div class="list-group list-group-flush">
            @foreach (var rec in FilteredRecords)
            {
                var iconClass = rec.Classification switch
                {
                    IncomeClass.Active => "ti-briefcase text-dark",
                    IncomeClass.PassiveMineGenerated => "ti-bolt text-success",
                    _ => "ti-trending-up text-warning"
                };

                var bgBadgeClass = rec.Classification switch
                {
                    IncomeClass.Active => "bg-light text-dark border",
                    IncomeClass.PassiveMineGenerated => "bg-success-subtle text-success border border-success-subtle",
                    _ => "bg-warning-subtle text-warning border border-warning-subtle"
                };

                <div class="list-group-item p-4 d-flex align-items-center justify-content-between gap-3 hover-bg-light transition-all border-light-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-light p-2 d-flex align-items-center justify-content-center omm-card-icon">
                            <i class="ti @iconClass fs-4"></i>
                        </div>
                        <div>
                            <h3 class="h6 fw-bold text-dark font-display mb-1">@rec.Source</h3>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="badge @bgBadgeClass">@FormatHelper.IncomeClassLabel(rec.Classification)</span>
                                <span class="text-muted small">@rec.Frequency</span>
                                @if (!string.IsNullOrEmpty(rec.MineName))
                                {
                                    <a href="/mines/@rec.MineId" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 hover-underline">
                                        <i class="ti ti-link text-primary fs-6"></i>
                                        <span>@rec.MineName</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end">
                            <div class="fs-5 fw-bold text-dark font-display">
                                @FormatHelper.FormatCurrency(rec.Amount, rec.Currency)
                            </div>
                            <small class="text-muted">@rec.Date</small>
                        </div>
                        <button class="btn btn-link text-danger p-0 text-decoration-none" @onclick="() => DeleteIncome(rec.Id)">
                            <i class="ti ti-trash fs-5"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 px-4">
            <i class="ti ti-receipt-off fs-2 text-muted mb-2"></i>
            <h3 class="h6 fw-bold text-dark mb-1">No income records in this classification</h3>
            <p class="text-muted small mb-0">Add an income source to start classifying your cash flows.</p>
        </div>
    }
</div>

<!-- Add Income Modal -->
@if (showAddModal)
{
    <div class="modal fade show d-block omm-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="add-income-title">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-cash text-success fs-4"></i>
                        <h2 id="add-income-title" class="h5 modal-title fw-bold font-display mb-0">Add Income Stream</h2>
                    </div>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    @if (!string.IsNullOrEmpty(inputError))
                    {
                        <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="ti ti-alert-triangle"></i>
                            <small>@inputError</small>
                        </div>
                    }
                    <div class="card border-0 rounded-4">
                        <div class="card-body">
                            <div class="omm-form-section">
                                <div class="omm-form-grid">
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="income-source">Income Source <span class="text-danger">*</span></label>
                                        <input id="income-source" type="text" class="form-control rounded-3" maxlength="200"
                                               placeholder="e.g. Monthly Salary, Rental Dividend" @bind="newRecord.Source" />
                                    </div>
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="income-classification">Classification <span class="text-danger">*</span></label>
                                        <select id="income-classification" class="form-select rounded-3" @bind="newRecord.Classification">
                                            @foreach (var cls in Enum.GetValues<IncomeClass>())
                                            {
                                                <option value="@cls">@FormatHelper.IncomeClassLabel(cls)</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="omm-form-grid">
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="income-amount">Amount <span class="text-danger">*</span></label>
                                        <div class="dc-currency-group">
                                            <span class="dc-currency-addon">@currencySymbol</span>
                                            <input id="income-amount" type="number" class="form-control" min="0" step="50" @bind="newRecord.Amount" />
                                        </div>
                                    </div>
                                    <div class="omm-form-field">
                                        <label class="omm-form-label" for="income-frequency">Frequency <span class="text-danger">*</span></label>
                                        <select id="income-frequency" class="form-select rounded-3" @bind="newRecord.Frequency">
                                            <option value="monthly">Monthly</option>
                                            <option value="annual">Annual</option>
                                            <option value="one-off">One-off / Non-recurring</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="omm-form-field">
                                    <label class="omm-form-label" for="income-associated-mine">Associated Mine</label>
                                    <select id="income-associated-mine" class="form-select rounded-3" @onchange="OnMineSelected">
                                        <option value="">— Standalone Income (e.g. Salary, Consulting) —</option>
                                        @foreach (var mine in allMines)
                                        {
                                            <option value="@mine.Id">@mine.Name (@FormatHelper.CategoryLabel(mine.Category))</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn-omm-secondary" @onclick="CloseAddModal">Cancel</button>
                    <button type="button" class="btn-omm-accent" @onclick="SaveIncome">
                        <i class="ti ti-device-floppy"></i> Save Income
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<IncomeRecord> allRecords = [];
    private List<Mine> allMines = [];
    private IncomeClass? selectedClass;
    private bool showAddModal = false;
    private IncomeRecord newRecord = new();
    private string? inputError;
    private string currencySymbol = string.Empty;
    private string sortField = "modified";
    private bool sortDescending = true;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetCurrentAsync();
        if (!string.IsNullOrWhiteSpace(profile?.CurrencyCode))
        {
            currencySymbol = FormatHelper.GetCurrencySymbol(profile.CurrencyCode);
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        allRecords = await RecordService.GetIncomeRecordsAsync();
        allMines = await MineService.GetMinesAsync();
    }

    private List<IncomeRecord> FilteredRecords
    {
        get
        {
            var filtered = allRecords
                .Where(r => selectedClass == null || r.Classification == selectedClass.Value)
                .ToList();

            IOrderedEnumerable<IncomeRecord> ordered = sortField switch
            {
                "created" => sortDescending ? filtered.OrderByDescending(GetCreatedSortValue).ThenBy(r => r.Source) : filtered.OrderBy(GetCreatedSortValue).ThenBy(r => r.Source),
                "source" => sortDescending ? filtered.OrderByDescending(r => r.Source, StringComparer.OrdinalIgnoreCase) : filtered.OrderBy(r => r.Source, StringComparer.OrdinalIgnoreCase),
                "classification" => sortDescending ? filtered.OrderByDescending(r => FormatHelper.IncomeClassLabel(r.Classification), StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Source) : filtered.OrderBy(r => FormatHelper.IncomeClassLabel(r.Classification), StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Source),
                "event-date" => sortDescending ? filtered.OrderByDescending(r => ParseDateSortValue(r.Date)).ThenBy(r => r.Source) : filtered.OrderBy(r => ParseDateSortValue(r.Date)).ThenBy(r => r.Source),
                _ => sortDescending ? filtered.OrderByDescending(GetModifiedSortValue).ThenBy(r => r.Source) : filtered.OrderBy(GetModifiedSortValue).ThenBy(r => r.Source)
            };

            return ordered.ToList();
        }
    }

    private static DateTimeOffset GetCreatedSortValue(IncomeRecord record) => ParseTimestamp(record.CreatedAt);
    private static DateTimeOffset GetModifiedSortValue(IncomeRecord record) => ParseTimestamp(record.ModifiedAt) > DateTimeOffset.MinValue ? ParseTimestamp(record.ModifiedAt) : ParseTimestamp(record.CreatedAt);
    private static DateTimeOffset ParseTimestamp(string? value) => DateTimeOffset.TryParse(value, out var timestamp) ? timestamp : DateTimeOffset.MinValue;
    private static DateOnly ParseDateSortValue(string? value) => DateOnly.TryParse(value, out var date) ? date : DateOnly.MinValue;
    private void ToggleSortDirection() => sortDescending = !sortDescending;

    private decimal ActiveMonthly => allRecords
        .Where(r => r.Classification == IncomeClass.Active && r.Frequency == "monthly")
        .Sum(r => r.Amount);

    private decimal PassiveMonthlyDirect => allRecords
        .Where(r => r.Classification == IncomeClass.PassiveMineGenerated && r.Frequency == "monthly")
        .Sum(r => r.Amount);

    private decimal PassiveAnnual => allRecords
        .Where(r => r.Classification == IncomeClass.PassiveMineGenerated && r.Frequency == "annual")
        .Sum(r => r.Amount);

    private decimal PassiveMonthlyEquivalent => PassiveMonthlyDirect + (PassiveAnnual / 12m);

    private decimal NonRecurringTotal => allRecords
        .Where(r => r.Classification == IncomeClass.NonRecurring)
        .Sum(r => r.Amount);

    private decimal TotalAnnualInflow => (ActiveMonthly * 12) + (PassiveMonthlyDirect * 12) + PassiveAnnual + NonRecurringTotal;

    private bool HasSingleCurrency => allRecords.Select(item => item.Currency).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1;
    private string ActiveMonthlyDisplay => AggregateDisplay(item => item.Classification == IncomeClass.Active && item.Frequency == "monthly" ? item.Amount : 0m);
    private string PassiveMonthlyDisplay => AggregateDisplay(item => item.Classification == IncomeClass.PassiveMineGenerated ? MemberRecordService.MonthlyEquivalent(item.Amount, item.Frequency switch { "monthly" => Data.Entities.RecordFrequency.Monthly, "annual" => Data.Entities.RecordFrequency.Annual, _ => Data.Entities.RecordFrequency.OneOff }) : 0m);
    private string NonRecurringDisplay => AggregateDisplay(item => item.Classification == IncomeClass.NonRecurring ? item.Amount : 0m);
    private string TotalAnnualInflowDisplay => HasSingleCurrency ? FormatHelper.FormatCurrency(TotalAnnualInflow, allRecords[0].Currency) : allRecords.Count == 0 ? FormatHelper.FormatCurrency(0) : "Multiple currencies";
    private string AggregateDisplay(Func<IncomeRecord, decimal> selector) => allRecords.Count == 0 ? FormatHelper.FormatCurrency(0) : HasSingleCurrency ? FormatHelper.FormatCurrency(allRecords.Sum(selector), allRecords[0].Currency) : "Multiple currencies";

    private void OpenAddModal()
    {
        inputError = null;
        newRecord = new IncomeRecord
        {
            Classification = IncomeClass.Active,
            Frequency = "monthly",
            Currency = string.Empty
        };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        inputError = null;
        showAddModal = false;
    }

    private void OnMineSelected(ChangeEventArgs e)
    {
        var mineId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(mineId))
        {
            var mine = allMines.FirstOrDefault(m => m.Id == mineId);
            if (mine != null)
            {
                newRecord.MineId = mine.Id;
                newRecord.MineName = mine.Name;
                newRecord.Classification = IncomeClass.PassiveMineGenerated;
            }
        }
        else
        {
            newRecord.MineId = null;
            newRecord.MineName = null;
        }
    }

    private async Task SaveIncome()
    {
        inputError = PublicInputValidator.GetDisplayTextError("Income source", newRecord.Source);
        if (inputError is not null)
            return;

        if (string.IsNullOrWhiteSpace(newRecord.Source) || newRecord.Amount <= 0)
            return;

        await RecordService.AddIncomeRecordAsync(newRecord);
        showAddModal = false;
        await LoadData();
    }

    private async Task DeleteIncome(string id)
    {
        await RecordService.DeleteIncomeRecordAsync(id);
        await LoadData();
    }
}
