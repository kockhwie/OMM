    private async Task HandleClose()
    {
        inputError = null;
        await OnClose.InvokeAsync();
    }

    private async Task SaveMineAsync()
    {
        if (isSaving) return;
        isSaving = true;
        inputError = null;

        RecalculateForSave();
        workingMine.Metadata = metadata;
        if (workingMine.Type == MineType.ForeignCurrency)
        {
            var purchase = workingMine.ForeignCurrencyTransactions?
                .Where(item => item.TransactionType == ForeignCurrencyTransactionType.Purchase)
                .OrderBy(item => item.TransactionDate)
                .FirstOrDefault();

            if (purchase is null)
            {
                purchase = new ForeignCurrencyTransaction
                {
                    TransactionType = ForeignCurrencyTransactionType.Purchase
                };
                workingMine.ForeignCurrencyTransactions ??= [];
                workingMine.ForeignCurrencyTransactions.Add(purchase);
            }

            purchase.TransactionDate = foreignInitialDate;
            purchase.ForeignAmount = foreignInitialAmount;
            purchase.MyrAmount = foreignInitialMyrAmount;
            purchase.ExchangeRate = foreignInitialRate;
            purchase.FeesMyr = foreignInitialFees;
        }

        try
        {
            if (IsEditMode)
            {
                await MineService.UpdateMineAsync(workingMine, archiveYieldHistory);
            }
            else
            {
                await MineService.AddMineAsync(workingMine);
            }

            await OnSaved.InvokeAsync();
            await HandleClose();
        }
        catch (Exception ex)
        {
            inputError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RecalculateForSave()
    {
        switch (workingMine.Type)
        {
            case MineType.EpfKwsp:
                RecalculateEpf();
                break;
            case MineType.UnitTrustAsb:
                RecalculateAsb();
                break;
            case MineType.FixedDeposit:
                RecalculateFd();
                break;
            case MineType.Stocks:
            case MineType.Reit:
            case MineType.Etf:
                RecalculateStock();
                break;
            case MineType.StocksUs:
                RecalculateUsStock();
                break;
            case MineType.UnitTrustGeneral:
                RecalculateFund();
                break;
            case MineType.PropertyResidential:
            case MineType.PropertyCommercial:
                RecalculateProperty();
                break;
            case MineType.Gold:
            case MineType.Silver:
                RecalculatePreciousMetals();
                break;
            case MineType.Cryptocurrency:
                RecalculateCrypto();
                break;
            case MineType.SavingsAccount:
                RecalculateSavings();
                break;
            case MineType.CashInHand:
                RecalculateCash();
                break;
            case MineType.ForeignCurrency:
                RecalculateForeignCurrency();
                break;
            default:
                ComputeGrowth();
                break;
        }
    }
}
