                        </div>

                        <div class="card border-0 rounded-4">
                        <!-- Reinvestment (DRIP) section -->
                            <div class="card-header bg-dark">  
                                <div class="dc-section-title text-gold"><i class="ti ti-pig-money text-gold"></i> Reinvestment (DRIP)</div>
                            </div>
                            <div class="dc-section">
                                <div class="card-body">
                                    <div class="dc-toggle-row">
                                 
                                        <div>
                                            <div class="dc-toggle-label">Reinvest dividends (DRIP)</div>
                                            <div class="dc-toggle-sub">Auto-compound dividend payouts into new shares</div>
