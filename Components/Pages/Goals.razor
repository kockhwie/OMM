@page "/goals"
@layout DashboardLayout
@inject IMineService MineService
@inject NavigationManager Navigation

<PageTitle>Goals - OhMyMine</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 animate-fade-up">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">Financial Goals</h1>
        <p class="text-muted small mb-0">
            Mining toward meaningful milestones - safety buffers, debt freedom, and early retirement
        </p>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="OpenAddModal">
        <i class="ti ti-plus fs-5"></i>
        <span>Add Goal</span>
    </button>
</div>

<!-- Goals Cards Grid -->
@if (allGoals.Count > 0)
{
    <div class="row g-4 mb-4">
        @foreach (var goal in allGoals)
        {
            var progress = FormatHelper.GoalProgress(goal.Current, goal.Target);
            var isFreedom = goal.Type == GoalType.Freedom;
            var isAchieved = goal.Status == "achieved" || progress >= 100;
            var isAttention = goal.Status == "needs-attention";

            var barColor = isAchieved || goal.Status == "on-track" ? "bg-success" : (isAttention ? "bg-warning" : "bg-secondary");
            var badgeClass = isAchieved || goal.Status == "on-track" ? "bg-success-subtle text-success border border-success-subtle" : (isAttention ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-light text-dark border");

            <div class="col-12 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover position-relative bg-white animate-fade-up">
                    
                    <!-- Header -->
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-dark-subtle text-dark p-2 d-flex align-items-center justify-content-center"
                                 style="width: 44px; height: 44px;">
                                <i class="ti @FormatHelper.GoalTypeToIcon(goal.Type) fs-4"></i>
                            </div>
                            <div>
                                <h3 class="h6 fw-bold text-dark font-display mb-0">@goal.Title</h3>
                                <small class="text-muted">@goal.Type</small>
                            </div>
                        </div>
                        <span class="badge @badgeClass">@FormatHelper.GoalStatusLabel(goal.Status)</span>
                    </div>

                    <!-- Progress Figures -->
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="small text-muted">
                            @(isFreedom ? $"{goal.Current}%" : FormatHelper.FormatCurrency(goal.Current))
                        </span>
                        <span class="fw-bold fs-6 text-dark font-display">@progress%</span>
                        <span class="small text-muted">
                            Target: @(isFreedom ? $"{goal.Target}%" : FormatHelper.FormatCurrency(goal.Target))
                        </span>
                    </div>

                    <!-- Visual Progress Bar -->
                    <ProgressBar Value="@progress" Height="8px" ColorClass="@barColor" />

                    <!-- Footer: Target Date & Actions -->
                    <div class="mt-4 pt-3 border-top border-light-subtle d-flex align-items-center justify-content-between small">
                        <span class="text-muted d-inline-flex align-items-center gap-1">
                            <i class="ti ti-calendar fs-6"></i>
                            Target: <strong class="text-dark">@goal.TargetDate</strong>
                        </span>
                        <button class="btn btn-link text-danger p-0 text-decoration-none" @onclick="() => DeleteGoal(goal.Id)">
                            <i class="ti ti-trash fs-6"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 my-4">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="ti ti-target fs-2 text-primary"></i>
        </div>
        <h3 class="h5 fw-bold text-dark mb-1">No goals set yet</h3>
        <p class="text-muted small mb-3">Define target milestones to guide your mining strategy.</p>
        <div>
            <button class="btn btn-primary btn-sm rounded-3 px-3" @onclick="OpenAddModal">Create Your First Goal</button>
        </div>
    </div>
}

<!-- Goal Types Legend -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white animate-fade-up">
    <h2 class="h6 fw-bold text-dark font-display mb-3">Milestone Framework</h2>
    <div class="row g-2">
        @foreach (var type in Enum.GetValues<GoalType>())
        {
            <div class="col-6 col-sm-4 col-md-3">
                <div class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border border-light-subtle">
                    <i class="ti @FormatHelper.GoalTypeToIcon(type) text-muted fs-5"></i>
                    <span class="small fw-medium text-dark">@type</span>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Goal Modal -->
@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-target text-warning fs-4"></i>
                        <h5 class="modal-title fw-bold font-display mb-0">Add Financial Milestone</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Goal Title *</label>
                            <input type="text" class="form-control rounded-3" placeholder="e.g. Emergency Fund (6 months)" @bind="newGoal.Title" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Goal Type *</label>
                            <select class="form-select rounded-3" @bind="newGoal.Type">
                                @foreach (var typ in Enum.GetValues<GoalType>())
                                {
                                    <option value="@typ">@typ</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Target Amount / Value *</label>
                            <input type="number" class="form-control rounded-3" step="100" @bind="newGoal.Target" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Current Saved / Accumulated</label>
                            <input type="number" class="form-control rounded-3" step="100" @bind="newGoal.Current" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Target Completion Date *</label>
                            <input type="date" class="form-control rounded-3" @bind="targetDateInput" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Status</label>
                            <select class="form-select rounded-3" @bind="newGoal.Status">
                                <option value="on-track">On Track</option>
                                <option value="needs-attention">Needs Attention</option>
                                <option value="not-started">Not Started</option>
                                <option value="achieved">Achieved</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" @onclick="CloseAddModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" @onclick="SaveGoal">Save Goal</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Goal> allGoals = [];
    private bool showAddModal = false;
    private Goal newGoal = new();
    private DateTime targetDateInput = DateTime.Today.AddYears(1);

    protected override async Task OnInitializedAsync()
    {
        await LoadGoals();
    }

    private async Task LoadGoals()
    {
        allGoals = await MineService.GetGoalsAsync();
    }

    private void OpenAddModal()
    {
        targetDateInput = DateTime.Today.AddYears(1);
        newGoal = new Goal
        {
            Type = GoalType.Safety,
            Status = "on-track"
        };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task SaveGoal()
    {
        if (string.IsNullOrWhiteSpace(newGoal.Title) || newGoal.Target <= 0)
            return;

        newGoal.TargetDate = targetDateInput.ToString("yyyy-MM-dd");
        await MineService.AddGoalAsync(newGoal);
        showAddModal = false;
        await LoadGoals();
    }

    private async Task DeleteGoal(string id)
    {
        await MineService.DeleteGoalAsync(id);
        await LoadGoals();
    }
}
