@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Hosting
@using OMM.Public.Data
@using OMM.Shared.Infrastructure.Settings

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ISystemSettingsService SystemSettingsService
@inject IHostEnvironment HostEnvironment

@if (externalLogins.Length == 0)
{
    @* Preserve scaffolded template note in Development, but avoid showing developer guidance to public users in Production *@
    @if (HostEnvironment.IsDevelopment())
    {
        <div>
            <p class="text-muted small">
                There are no external authentication services configured or enabled. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">article
                about setting up this ASP.NET application to support logging in via external services</a>.
            </p>
        </div>
    }
}
else
{
    <form class="omm-external-login form-horizontal" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <div class="omm-provider-actions d-flex flex-column gap-2">
                @foreach (var provider in externalLogins)
                {
                    @if (provider.Name == "Google")
                    {
                        <button type="submit" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            <i class="ti ti-brand-google fs-5"></i>
                            <span>Continue with Google</span>
                        </button>
                    }
                    else if (provider.Name == "Microsoft")
                    {
                        <button type="submit" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            <i class="ti ti-brand-windows fs-5"></i>
                            <span>Continue with Microsoft</span>
                        </button>
                    }
                    else if (provider.Name == "Facebook")
                    {
                        <button type="submit" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            <i class="ti ti-brand-facebook fs-5 text-primary"></i>
                            <span>Continue with Facebook</span>
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                    }
                }
            </div>
        </div>
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var isGoogleEnabled = await SystemSettingsService.IsGoogleAuthEnabledAsync();
        var schemes = await SignInManager.GetExternalAuthenticationSchemesAsync();
        externalLogins = schemes
            .Where(scheme => !string.Equals(scheme.Name, "Google", StringComparison.OrdinalIgnoreCase) || isGoogleEnabled)
            .ToArray();
    }
}
