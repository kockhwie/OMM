                    </div>

                    <div class="d-flex flex-wrap gap-4 text-muted justify-content-center justify-content-lg-start omm-hero-reveal animate-fade-up" style="font-size: 0.875rem; animation-delay: 0.32s;">
                        <span class="d-flex align-items-center gap-1">
                            <i class="ti ti-check text-success fs-5"></i> No sign-up to explore
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <i class="ti ti-check text-success fs-5"></i> MYR-native
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <i class="ti ti-check text-success fs-5"></i> Private by default
                        </span>
                    </div>
                </div>
            </div>

