@code {
    private bool animationsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Runs after the DOM for this render is in place. Guard with a flag
        // rather than only "firstRender" since Blazor Server can re-render
        // this page (e.g. reconnect) and the JS module tracks bound elements
        // itself (data-reveal-bound / data-counter-bound), so repeat calls
        // are safe and cheap either way.
        if (firstRender || !animationsInitialized)
        {
            animationsInitialized = true;
            try
            {
                await JS.InvokeVoidAsync("ommAnimations.init");
            }
            catch
            {
                // Non-fatal — page still works without the motion layer.
            }
        }
    }
}
