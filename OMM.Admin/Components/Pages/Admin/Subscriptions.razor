@page "/admin/subscriptions"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using OMM.Admin.Services.Admin
@using OMM.Shared.Models.Phase5
@using OMM.Shared.Subscription
@attribute [Authorize(Policy = "RequireAdminRole")]

@inject ISubscriptionLifecycleProcessor LifecycleProcessor
@inject ISubscriptionAdminService SubscriptionAdminService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditLogger AuditLogger

<PageTitle>Subscriptions & Lifecycle - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 font-display">Subscriptions & Lifecycle</h1>
            <p class="text-muted mb-0">Automated membership renewals, downgrades, and lifecycle processing history.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="RunLifecycleJobNowAsync" disabled="@_isRunningJob">
                @if (_isRunningJob)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <i class="ti ti-player-play"></i>
                    <span>Run Lifecycle Job Now</span>
                }
            </button>
            <button class="btn btn-outline-secondary d-flex align-items-center gap-1" @onclick="LoadDataAsync" disabled="@(_isLoading || _isRunningJob)">
                <i class="ti ti-refresh"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-@_statusClass alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="ti @(_statusClass == "success" ? "ti-circle-check" : "ti-alert-circle") fs-5 mt-1"></i>
                <div class="flex-grow-1">@_statusMessage</div>
                <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Last Run Status</span>
                        <h4 class="fw-bold mb-0 mt-1">
                            @if (_lastRun is null)
                            {
                                <span class="text-muted">None</span>
                            }
                            else if (_lastRun.Status == "Succeeded")
                            {
                                <span class="text-success"><i class="ti ti-check me-1"></i>Succeeded</span>
                            }
                            else if (_lastRun.Status == "Running")
                            {
                                <span class="text-warning"><i class="ti ti-loader me-1"></i>Running</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="ti ti-x me-1"></i>Failed</span>
                            }
                        </h4>
                    </div>
                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                        <i class="ti ti-activity fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    @(_lastRun?.CompletedAt?.ToString("g") ?? "No runs recorded")
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Last Scanned</span>
                        <h4 class="fw-bold mb-0 mt-1">@(_lastRun?.ScannedCount ?? 0)</h4>
                    </div>
                    <div class="p-2 bg-info-subtle text-info rounded-3">
                        <i class="ti ti-scan fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    Subscriptions examined
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Activated Renewals</span>
                        <h4 class="fw-bold mb-0 mt-1 text-success">@(_lastRun?.ActivatedCount ?? 0)</h4>
                    </div>
                    <div class="p-2 bg-success-subtle text-success rounded-3">
                        <i class="ti ti-arrow-up-circle fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    Scheduled terms promoted
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Downgraded / Notified</span>
                        <h4 class="fw-bold mb-0 mt-1 text-warning">
                            @(_lastRun?.DowngradedCount ?? 0) / @(_lastRun?.NotifiedCount ?? 0)
                        </h4>
                    </div>
                    <div class="p-2 bg-warning-subtle text-warning rounded-3">
                        <i class="ti ti-arrow-down-circle fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    Expirations & dispatched alerts
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-3 gap-2">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "runs" ? "active" : "") d-flex align-items-center gap-2"
                    @onclick='() => _activeTab = "runs"'>
                <i class="ti ti-history"></i>
                <span>Lifecycle Runs (@_runs.Count)</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "requests" ? "active" : "") d-flex align-items-center gap-2"
                    @onclick='() => _activeTab = "requests"'>
                <i class="ti ti-clock-check"></i>
                <span>Pending Upgrade Requests (@_pendingRequests.Count)</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "audit" ? "active" : "") d-flex align-items-center gap-2"
                    @onclick='() => _activeTab = "audit"'>
                <i class="ti ti-list-details"></i>
                <span>Subscription Audit Trail (@_recentAuditEvents.Count)</span>
            </button>
        </li>
    </ul>

    @if (_isLoading)
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
            <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
            <p class="text-muted mb-0">Loading subscription records...</p>
        </div>
    }
    else
    {
        @if (_activeTab == "runs")
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-0">Lifecycle Job Execution History</h5>
                        <span class="text-muted small">Single-run locked execution history with scanned, promoted, and downgraded telemetry.</span>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary">Last 30 runs</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Started (UTC)</th>
                                <th>Trigger Source</th>
                                <th>Status</th>
                                <th>Duration</th>
                                <th class="text-center">Scanned</th>
                                <th class="text-center">Activated</th>
                                <th class="text-center">Expired</th>
                                <th class="text-center">Downgraded</th>
                                <th class="text-center">Notified</th>
                                <th>Correlation ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_runs.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4 text-muted">
                                        <i class="ti ti-inbox fs-3 d-block mb-1"></i>
                                        No lifecycle job runs recorded yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var run in _runs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                            @if (run.CompletedAt.HasValue)
                                            {
                                                <div class="text-muted small">Done: @run.CompletedAt.Value.ToString("HH:mm:ss")</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(run.TriggerSource == "AdminManual" ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info")">
                                                <i class="ti @(run.TriggerSource == "AdminManual" ? "ti-user" : "ti-clock") me-1"></i>
                                                @run.TriggerSource
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(run.TriggeredByAdminId))
                                            {
                                                <div class="text-muted small font-monospace">@run.TriggeredByAdminId</div>
                                            }
                                        </td>
                                        <td>
                                            @if (run.Status == "Succeeded")
                                            {
                                                <span class="badge bg-success-subtle text-success"><i class="ti ti-check me-1"></i>Succeeded</span>
                                            }
                                            else if (run.Status == "Running")
                                            {
                                                <span class="badge bg-warning-subtle text-warning"><i class="ti ti-loader me-1"></i>Running</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger" title="@run.ErrorSummary">
                                                    <i class="ti ti-x me-1"></i>Failed
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (run.CompletedAt.HasValue)
                                            {
                                                var duration = run.CompletedAt.Value - run.StartedAt;
                                                <span>@($"{duration.TotalSeconds:F2}s")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-center font-monospace">@run.ScannedCount</td>
                                        <td class="text-center font-monospace text-success fw-bold">@run.ActivatedCount</td>
                                        <td class="text-center font-monospace">@run.ExpiredCount</td>
                                        <td class="text-center font-monospace text-warning fw-bold">@run.DowngradedCount</td>
                                        <td class="text-center font-monospace text-info fw-bold">@run.NotifiedCount</td>
                                        <td>
                                            <code class="small text-muted font-monospace">@run.CorrelationId</code>
                                            @if (!string.IsNullOrWhiteSpace(run.ErrorSummary))
                                            {
                                                <div class="text-danger small mt-1 font-monospace text-break" style="max-width: 300px;">
                                                    @run.ErrorSummary
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (_activeTab == "requests")
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold mb-0">Pending Upgrade Requests</h5>
                    <span class="text-muted small">Member requests awaiting manual payment verification or admin review.</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Member ID</th>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Requested At</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_pendingRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="ti ti-check-double fs-3 d-block mb-1 text-success"></i>
                                        No pending upgrade requests. All clear!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var req in _pendingRequests)
                                {
                                    <tr>
                                        <td><code class="font-monospace">@req.UserId</code></td>
                                        <td><span class="badge bg-primary-subtle text-primary">Plan #@req.SubscriptionPlanId</span></td>
                                        <td class="fw-semibold">@req.CurrencyCode @req.AmountDue.ToString("F2")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@(req.PaymentReference ?? "—")</span></td>
                                        <td>
                                            <span class="badge @(req.Status == "PaymentSubmitted" ? "bg-warning-subtle text-warning" : "bg-info-subtle text-info")">
                                                @req.Status
                                            </span>
                                        </td>
                                        <td class="text-muted small">@req.CreatedAt.ToString("g")</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-success" @onclick="() => ApproveRequestAsync(req.Id)" disabled="@_isProcessingAction">
                                                    <i class="ti ti-check me-1"></i>Approve
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => RejectRequestAsync(req.Id)" disabled="@_isProcessingAction">
                                                    <i class="ti ti-x me-1"></i>Reject
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (_activeTab == "audit")
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold mb-0">Subscription Change Audit Trail</h5>
                    <span class="text-muted small">Immutable log of subscription lifecycle transitions, approvals, terminations, and activations.</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Occurred At (UTC)</th>
                                <th>Member ID</th>
                                <th>Action</th>
                                <th>Actor</th>
                                <th>Reason</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_recentAuditEvents.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="ti ti-inbox fs-3 d-block mb-1"></i>
                                        No subscription audit events found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var audit in _recentAuditEvents)
                                {
                                    <tr>
                                        <td class="small">@audit.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td><code class="font-monospace small">@audit.UserId</code></td>
                                        <td>
                                            <span class="badge @GetActionBadgeClass(audit.Action)">
                                                @audit.Action
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary small">
                                                @audit.ActorType: @(audit.ActorId ?? "system")
                                            </span>
                                        </td>
                                        <td class="small">@(audit.Reason ?? "—")</td>
                                        <td class="small text-muted">@(audit.Notes ?? "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private string _activeTab = "runs";
    private bool _isLoading = true;
    private bool _isRunningJob;
    private bool _isProcessingAction;
    private string? _statusMessage;
    private string _statusClass = "success";
    private string _currentUserId = "Admin";
    private string _currentUserName = "Admin";

    private List<SubscriptionLifecycleJobRun> _runs = new();
    private SubscriptionLifecycleJobRun? _lastRun;
    private List<SubscriptionUpgradeRequest> _pendingRequests = new();
    private List<SubscriptionChangeEvent> _recentAuditEvents = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "Admin";
        _currentUserName = authState.User.Identity?.Name ?? "Admin";

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _statusMessage = null;

        try
        {
            var runsTask = LifecycleProcessor.GetRecentJobRunsAsync(30);
            var lastRunTask = LifecycleProcessor.GetLastSuccessfulRunAsync();
            var requestsTask = SubscriptionAdminService.GetPendingUpgradeRequestsAsync();
            var auditTask = SubscriptionAdminService.GetSubscriptionAuditTrailAsync();

            await Task.WhenAll(runsTask, lastRunTask, requestsTask, auditTask);

            _runs = (await runsTask).ToList();
            _lastRun = await lastRunTask;
            _pendingRequests = (await requestsTask).ToList();
            _recentAuditEvents = (await auditTask).Take(50).ToList();
        }
        catch (Exception ex)
        {
            _statusClass = "danger";
            _statusMessage = $"Failed to load subscription lifecycle data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunLifecycleJobNowAsync()
    {
        _isRunningJob = true;
        _statusMessage = null;

        try
        {
            var result = await LifecycleProcessor.ProcessLifecycleAsync("AdminManual", _currentUserId);

            await AuditLogger.LogAsync(
                _currentUserId,
                _currentUserName,
                "RunSubscriptionLifecycleJob",
                targetUserId: null,
                detail: $"Manual lifecycle execution completed. Scanned: {result.ScannedCount}, Activated: {result.ActivatedCount}, Expired: {result.ExpiredCount}, Downgraded: {result.DowngradedCount}, Notified: {result.NotifiedCount}.");

            _statusClass = "success";
            _statusMessage = $"Lifecycle job completed successfully! Scanned: {result.ScannedCount}, Activated: {result.ActivatedCount}, Expired: {result.ExpiredCount}, Downgraded: {result.DowngradedCount}, Notified: {result.NotifiedCount}.";

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _statusClass = "danger";
            _statusMessage = $"Lifecycle job failed: {ex.Message}";
            await LoadDataAsync();
        }
        finally
        {
            _isRunningJob = false;
        }
    }

    private async Task ApproveRequestAsync(long requestId)
    {
        _isProcessingAction = true;
        _statusMessage = null;

        try
        {
            await SubscriptionAdminService.ApproveUpgradeRequestAsync(
                requestId,
                _currentUserId,
                reviewNotes: "Approved via Admin Subscriptions panel.");

            await AuditLogger.LogAsync(
                _currentUserId,
                _currentUserName,
                "ApproveSubscriptionUpgrade",
                targetUserId: null,
                detail: $"Approved upgrade request {requestId}.");

            _statusClass = "success";
            _statusMessage = $"Upgrade request {requestId} successfully approved!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _statusClass = "danger";
            _statusMessage = $"Failed to approve upgrade request: {ex.Message}";
        }
        finally
        {
            _isProcessingAction = false;
        }
    }

    private async Task RejectRequestAsync(long requestId)
    {
        _isProcessingAction = true;
        _statusMessage = null;

        try
        {
            await SubscriptionAdminService.RejectUpgradeRequestAsync(
                requestId,
                _currentUserId,
                reason: "Rejected via Admin Subscriptions panel.");

            await AuditLogger.LogAsync(
                _currentUserId,
                _currentUserName,
                "RejectSubscriptionUpgrade",
                targetUserId: null,
                detail: $"Rejected upgrade request {requestId}.");

            _statusClass = "success";
            _statusMessage = $"Upgrade request {requestId} has been rejected.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _statusClass = "danger";
            _statusMessage = $"Failed to reject upgrade request: {ex.Message}";
        }
        finally
        {
            _isProcessingAction = false;
        }
    }

    private static string GetActionBadgeClass(string action) => action switch
    {
        "Provisioned" or "Activated" or "Resumed" => "bg-success-subtle text-success",
        "Expired" or "DowngradedToStandard" => "bg-warning-subtle text-warning",
        "Terminated" or "Cancelled" or "Suspended" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}
