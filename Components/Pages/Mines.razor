@page "/mines"
@layout DashboardLayout
@inject IMineService MineService
@inject NavigationManager Navigation

<PageTitle>My Mines — OhMyMine</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 animate-fade-up">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">My Mines</h1>
        <p class="text-muted small mb-0">
            @FilteredMines.Count mines · @FormatHelper.FormatCurrency(TotalFilteredValue) total value
        </p>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="OpenAddModal">
        <i class="ti ti-plus fs-5"></i>
        <span>Add Mine</span>
    </button>
</div>

<!-- Search & Category Filters -->
<div class="d-flex flex-column flex-md-row gap-3 mb-4 animate-fade-up">
    <div class="position-relative flex-grow-1" style="max-width: 340px;">
        <i class="ti ti-search position-absolute text-muted" style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none;"></i>
        <input type="text"
               class="form-control bg-white border-light-subtle rounded-3 py-2 shadow-xs"
               style="padding-left: 2.5rem; padding-right: 2.25rem;"
               placeholder="Search mines, types..."
               @bind="searchQuery"
               @bind:event="oninput" />
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <button class="btn btn-sm btn-link position-absolute text-muted p-0 text-decoration-none"
                    style="top: 50%; right: 10px; transform: translateY(-50%);"
                    @onclick="() => searchQuery = string.Empty">
                <i class="ti ti-x"></i>
            </button>
        }
    </div>

    <!-- Category Pill Filters -->
    <div class="d-flex flex-wrap gap-1 align-items-center">
        <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(selectedCategory == null ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
                @onclick="() => selectedCategory = null">
            All
        </button>
        @foreach (var cat in Enum.GetValues<MineCategory>())
        {
            var isSelected = selectedCategory == cat;
            <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(isSelected ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
                    @onclick="() => selectedCategory = cat">
                @FormatHelper.CategoryLabel(cat)
            </button>
        }
    </div>
</div>

<!-- Mines Grid -->
@if (FilteredMines.Count > 0)
{
    <div class="row g-3">
        @foreach (var mine in FilteredMines)
        {
            var growthPositive = mine.Growth >= 0;
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover cursor-pointer position-relative"
                     style="transition: all 0.2s ease-in-out;"
                     @onclick="() => NavigateToDetail(mine.Id)">

                    <!-- Status Badge — small, top of card -->
                    <div class="d-flex justify-content-end mb-2">
                        <StatusBadge Status="@mine.Status" Compact="true" />
                    </div>

                    <!-- Header: Icon, Name & Category (wraps, no truncation) -->
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="rounded-3 bg-dark-subtle text-dark d-flex align-items-center justify-content-center p-2 flex-shrink-0"
                             style="width: 40px; height: 40px;">
                            <i class="ti @FormatHelper.CategoryToIcon(mine.Category) fs-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="h6 fw-bold mb-0 text-dark font-display" style="font-size: 0.92rem; line-height: 1.3; word-break: break-word;">
                                @mine.Name
                            </h3>
                            <small class="text-muted d-block" style="font-size: 0.72rem; line-height: 1.35; word-break: break-word;">
                                @FormatHelper.CategoryLabel(mine.Category) · @FormatHelper.MineTypeLabel(mine.Type)
                            </small>
                        </div>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="row g-2 pt-2 border-top border-light-subtle text-center text-sm-start">
                        <div class="col-4 min-w-0">
                            <span class="text-uppercase text-muted fw-semibold d-block" style="font-size: 0.62rem; letter-spacing: 0.05em;">Current</span>
                            <div class="fw-bold text-dark" style="font-size: 0.85rem;" title="@FormatHelper.FormatCurrency(mine.CurrentValue)">
                                @FormatHelper.FormatCurrencyCompact(mine.CurrentValue)
                            </div>
                        </div>
                        <div class="col-4 min-w-0">
                            <span class="text-uppercase text-muted fw-semibold d-block" style="font-size: 0.62rem; letter-spacing: 0.05em;">Growth</span>
                            <div class="fw-bold d-flex align-items-center justify-content-center justify-content-sm-start gap-1 @(growthPositive ? "text-success" : "text-danger")" style="font-size: 0.85rem;">
                                <i class="ti @(growthPositive ? "ti-trending-up" : "ti-trending-down")" style="font-size: 0.9rem;"></i>
                                <span>@FormatHelper.FormatPercent(mine.GrowthPct)</span>
                            </div>
                        </div>
                        <div class="col-4 min-w-0">
                            <span class="text-uppercase text-muted fw-semibold d-block" style="font-size: 0.62rem; letter-spacing: 0.05em;">Income/mo</span>
                            <div class="fw-bold text-dark" style="font-size: 0.85rem;" title="@(mine.MonthlyIncome > 0 ? FormatHelper.FormatCurrency(mine.MonthlyIncome) : "—")">
                                @(mine.MonthlyIncome > 0 ? FormatHelper.FormatCurrencyCompact(mine.MonthlyIncome) : "—")
                            </div>
                        </div>
                    </div>

                    <!-- Sub-mines Footer if any -->
                    @if (mine.SubMines != null && mine.SubMines.Count > 0)
                    {
                        <div class="mt-3 pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted small">
                            <span class="d-inline-flex align-items-center gap-1">
                                <i class="ti ti-layers-intersect fs-6"></i>
                                @mine.SubMines.Count sub-placements
                            </span>
                            <i class="ti ti-chevron-right fs-6"></i>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 my-4">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="ti ti-pick fs-2 text-muted"></i>
        </div>
        <h3 class="h5 fw-bold text-dark mb-1">No mines found</h3>
        <p class="text-muted small mb-3">No mines match your filter criteria or search query.</p>
        <div>
            <button class="btn btn-outline-dark btn-sm rounded-3 px-3" @onclick="ResetFilters">Clear Filters</button>
        </div>
    </div>
}

<!-- Add Mine Modal -->
@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-pick text-warning fs-4"></i>
                        <h5 class="modal-title fw-bold font-display mb-0">Add New Mine</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Mine Name *</label>
                            <input type="text" class="form-control rounded-3" placeholder="e.g. EPF / KWSP, Maybank Shares" @bind="newMine.Name" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Institution / Issuer</label>
                            <input type="text" class="form-control rounded-3" placeholder="e.g. KWSP, Bursa Malaysia, CIMB" @bind="newMine.Institution" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Category *</label>
                            <select class="form-select rounded-3" @bind="newMine.Category">
                                @foreach (var cat in Enum.GetValues<MineCategory>())
                                {
                                    <option value="@cat">@FormatHelper.CategoryLabel(cat)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Asset Type *</label>
                            <select class="form-select rounded-3" @bind="newMine.Type">
                                @foreach (var typ in Enum.GetValues<MineType>())
                                {
                                    <option value="@typ">@FormatHelper.MineTypeLabel(typ)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Current Market Value (RM) *</label>
                            <input type="number" class="form-control rounded-3" step="100" @bind="newMine.CurrentValue" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Purchase Cost (RM)</label>
                            <input type="number" class="form-control rounded-3" step="100" @bind="newMine.PurchaseCost" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Est. Monthly Passive Income (RM)</label>
                            <input type="number" class="form-control rounded-3" step="50" @bind="newMine.MonthlyIncome" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Holdings / Details</label>
                            <input type="text" class="form-control rounded-3" placeholder="e.g. 1,000 shares, 50 grams" @bind="newMine.Holdings" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" @onclick="CloseAddModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" @onclick="SaveMine">Save Mine</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Mine> allMines = [];
    private string searchQuery = string.Empty;
    private MineCategory? selectedCategory;
    private bool showAddModal = false;
    private Mine newMine = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMines();
    }

    private async Task LoadMines()
    {
        allMines = await MineService.GetMinesAsync();
    }

    private List<Mine> FilteredMines => allMines
        .Where(m => selectedCategory == null || m.Category == selectedCategory.Value)
        .Where(m => string.IsNullOrWhiteSpace(searchQuery) ||
                    m.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (m.Institution != null && m.Institution.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    FormatHelper.MineTypeLabel(m.Type).Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private decimal TotalFilteredValue => FilteredMines.Sum(m => m.CurrentValue);

    private void NavigateToDetail(string mineId)
    {
        Navigation.NavigateTo($"/mines/{mineId}");
    }

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedCategory = null;
    }

    private void OpenAddModal()
    {
        newMine = new Mine
        {
            Category = MineCategory.Investments,
            Type = MineType.Stocks,
            Currency = "MYR",
            Status = "active"
        };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task SaveMine()
    {
        if (string.IsNullOrWhiteSpace(newMine.Name))
            return;

        if (newMine.PurchaseCost > 0)
        {
            newMine.Growth = newMine.CurrentValue - newMine.PurchaseCost;
            newMine.GrowthPct = Math.Round((newMine.Growth / newMine.PurchaseCost) * 100m, 1);
        }
        else
        {
            newMine.PurchaseCost = newMine.CurrentValue;
            newMine.Growth = 0;
            newMine.GrowthPct = 0;
        }

        await MineService.AddMineAsync(newMine);
        showAddModal = false;
        await LoadMines();
    }
}