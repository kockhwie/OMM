@page "/admin/audit-log"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using OMM.Admin.Data
@using OMM.Admin.Services.Admin
@attribute [Authorize(Policy = "RequireAdminRole")]

@inject IAuditLogger AuditLogger

<PageTitle>Audit Log - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 font-display">Audit Log</h1>
            <p class="text-muted mb-0">Persistent audit trail of administrative mutations, security events, and user management changes.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAuditLogsAsync" disabled="@_isLoading">
                <i class="ti ti-refresh @(_isLoading ? "ti-spin" : "")"></i> Refresh
            </button>
        </div>
    </div>

    <AdminDataGrid TItem="AdminAuditLog"
                   Items="@_logs"
                   TotalCount="@_logs.Count"
                   IsLoading="@_isLoading"
                   SearchPlaceholder="Search actor, action, target, or details..."
                   OnSearchChanged="HandleSearchChanged">
        <Columns>
            <GridColumn TItem="AdminAuditLog" Field="@(log => log.OccurredAt)" Title="Timestamp (UTC)" Sortable="true">
                <Template Context="log">
                    <span class="font-monospace text-muted small">
                        @log.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")
                    </span>
                </Template>
            </GridColumn>
            <GridColumn TItem="AdminAuditLog" Field="@(log => log.ActorUserName)" Title="Actor" Sortable="true">
                <Template Context="log">
                    <div class="d-flex flex-column">
                        <span class="fw-bold text-dark">@log.ActorUserName</span>
                        <span class="text-muted font-monospace" style="font-size: 0.75rem;">@log.ActorUserId</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn TItem="AdminAuditLog" Field="@(log => log.Action)" Title="Action" Sortable="true">
                <Template Context="log">
                    <span class="badge @GetActionBadgeClass(log.Action)">
                        @log.Action
                    </span>
                </Template>
            </GridColumn>
            <GridColumn TItem="AdminAuditLog" Field="@(log => log.TargetUserId)" Title="Target User">
                <Template Context="log">
                    <span class="text-muted font-monospace small">@(log.TargetUserId ?? "-")</span>
                </Template>
            </GridColumn>
            <GridColumn TItem="AdminAuditLog" Field="@(log => log.Detail)" Title="Details">
                <Template Context="log">
                    <span class="text-dark small">@(log.Detail ?? "-")</span>
                </Template>
            </GridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-5">
                <i class="ti ti-history-off fs-1 text-muted"></i>
                <h5 class="fw-bold mb-1 mt-2">No audit log entries found</h5>
                <p class="text-muted small mb-0">No actions recorded matching the current filter criteria.</p>
            </div>
        </EmptyTemplate>
    </AdminDataGrid>
</div>

@code {
    private List<AdminAuditLog> _logs = [];
    private bool _isLoading = true;
    private string? _searchTerm;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditLogsAsync();
    }

    private async Task LoadAuditLogsAsync()
    {
        _isLoading = true;
        try
        {
            var results = await AuditLogger.ListRecentAsync(_searchTerm, 200);
            _logs = results.ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAuditLogsAsync();
    }

    private static string GetActionBadgeClass(string action) => action switch
    {
        "Invite" => "bg-primary-subtle text-primary border border-primary-subtle",
        "ResendInvite" => "bg-info-subtle text-info border border-info-subtle",
        "UpdateRole" => "bg-purple-subtle text-purple border border-purple-subtle",
        "UpdateProfile" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        "LockAccount" or "DeactivateAccount" => "bg-danger-subtle text-danger border border-danger-subtle",
        "UnlockAccount" or "ReactivateAccount" => "bg-success-subtle text-success border border-success-subtle",
        "ForcePasswordReset" => "bg-warning-subtle text-warning border border-warning-subtle",
        _ => "bg-secondary-subtle text-secondary"
    };
}
