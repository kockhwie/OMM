@page "/admin/klse-stocks"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OMM.Admin.Data
@using OMM.Shared.Models.MasterData
@inject IDbContextFactory<MasterDataDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>KLSE Stocks - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 font-display">KLSE Stocks</h1>
            <p class="text-muted mb-0">Manage Malaysian equity securities, tickers, classification taxonomies, and fundamentals.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="RefreshData" disabled="@_isLoading">
                <i class="ti ti-refresh @(_isLoading ? "ti-spin" : "")"></i>
                <span>Refresh</span>
            </button>
            <button class="btn btn-sm btn-danger d-flex align-items-center gap-1 fw-semibold shadow-xs" @onclick="OpenAddModal">
                <i class="ti ti-plus"></i>
                <span>Add Stock</span>
            </button>
        </div>
    </div>

    <!-- Alert / Toast Banner -->
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-@_statusMessageClass alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 mb-4 shadow-xs" role="alert">
            <i class="ti @(_statusMessageClass == "success" ? "ti-circle-check" : "ti-alert-circle") fs-5"></i>
            <div>@_statusMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="@(() => _statusMessage = null)" aria-label="Close"></button>
        </div>
    }

    <!-- Active Filters / Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary p-2 rounded-3" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                        <i class="ti ti-chart-candle fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Securities</div>
                        <div class="h5 fw-bold mb-0 text-dark">@_totalCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success p-2 rounded-3" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                        <i class="ti ti-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Active Listings</div>
                        <div class="h5 fw-bold mb-0 text-dark">@_activeCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning p-2 rounded-3" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                        <i class="ti ti-moon fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Shariah Compliant</div>
                        <div class="h5 fw-bold mb-0 text-dark">@_shariahCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 bg-white shadow-sm p-3 rounded-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-danger-subtle text-danger p-2 rounded-3" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                        <i class="ti ti-building-bank fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Markets</div>
                        <div class="h5 fw-bold mb-0 text-dark">MAIN / ACE / LEAP</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="card border-0 bg-white shadow-sm rounded-4 p-3 mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-lg-3 col-md-4 col-sm-6">
                <label class="form-label small fw-semibold text-muted mb-1">Market Board</label>
                <select class="form-select form-select-sm rounded-3" value="@_filterMarketId" @onchange="HandleMarketFilterChange">
                    <option value="0">All Markets</option>
                    @foreach (var m in _filterMarkets)
                    {
                        <option value="@m.Id">@m.MarketCode (@m.MarketName_EN)</option>
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-4 col-sm-6">
                <label class="form-label small fw-semibold text-muted mb-1">Sector</label>
                <select class="form-select form-select-sm rounded-3" value="@_filterSectorId" @onchange="HandleSectorFilterChange">
                    <option value="0">All Sectors</option>
                    @foreach (var s in _filterSectors)
                    {
                        <option value="@s.Id">@s.SectorName_EN</option>
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="form-label small fw-semibold text-muted mb-1">Shariah Status</label>
                <select class="form-select form-select-sm rounded-3" value="@_filterShariah" @onchange="HandleShariahFilterChange">
                    <option value="">All Securities</option>
                    <option value="yes">Shariah Compliant</option>
                    <option value="no">Non-Shariah</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="form-label small fw-semibold text-muted mb-1">Listing Status</label>
                <select class="form-select form-select-sm rounded-3" value="@_filterActive" @onchange="HandleActiveFilterChange">
                    <option value="">All Statuses</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive Only</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-12 d-flex align-items-end">
                @if (HasActiveFilters)
                {
                    <button class="btn btn-sm btn-outline-secondary w-100 rounded-3 mt-md-4" @onclick="ClearFilters">
                        <i class="ti ti-filter-off me-1"></i> Clear Filters
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- DataGrid -->
    <AdminDataGrid TItem="Stock"
                   Items="@_stocks"
                   TotalCount="@_totalCount"
                   @bind-PageSize="@_pageSize"
                   @bind-CurrentPage="@_currentPage"
                   IsLoading="@_isLoading"
                   ServerSide="true"
                   SearchPlaceholder="Search code, name, ticker, RIC..."
                   OnSearchChanged="HandleSearchChanged"
                   OnSortChanged="HandleSortChanged"
                   OnPageChanged="HandlePageChanged"
                   OnPageSizeChanged="HandlePageSizeChanged">

        <Columns>
            <GridColumn TItem="Stock" Field="@(s => s.StockCode)" Title="Code" Sortable="true">
                <Template Context="stock">
                    <span class="badge bg-light text-dark font-monospace fw-bold border px-2 py-1">
                        @stock.StockCode
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.ShortName_EN)" Title="Security Name" Sortable="true">
                <Template Context="stock">
                    <div class="d-flex flex-column">
                        <span class="fw-bold text-dark">@stock.ShortName_EN</span>
                        @if (!string.IsNullOrEmpty(stock.RicCode) || !string.IsNullOrEmpty(stock.LegalName_EN))
                        {
                            <span class="text-muted small font-monospace">
                                @(stock.RicCode ?? stock.LegalName_EN)
                            </span>
                        }
                    </div>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Title="Market" SortKey="Market" Sortable="true">
                <Template Context="stock">
                    <span class="badge @(stock.Market?.MarketCode == "MAIN" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                        @(stock.Market?.MarketCode ?? "-")
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Title="Sector" SortKey="Sector" Sortable="true">
                <Template Context="stock">
                    <span class="text-muted small">
                        @(stock.Sector?.SectorName_EN ?? "Unclassified")
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.CurrentPrice)" Title="Price (MYR)" Sortable="true">
                <Template Context="stock">
                    <span class="font-monospace fw-semibold text-dark">
                        @(stock.CurrentPrice.HasValue ? stock.CurrentPrice.Value.ToString("N3") : "-")
                    </span>
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.ShariahCompliant)" Title="Shariah" Sortable="true">
                <Template Context="stock">
                    @if (stock.ShariahCompliant)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="ti ti-check me-1"></i> Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border">No</span>
                    }
                </Template>
            </GridColumn>

            <GridColumn TItem="Stock" Field="@(s => s.IsActive)" Title="Status" Sortable="true">
                <Template Context="stock">
                    @if (stock.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success cursor-pointer" @onclick="@(() => ToggleActiveStatus(stock))" title="Click to deactivate">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary cursor-pointer" @onclick="@(() => ToggleActiveStatus(stock))" title="Click to activate">
                            Inactive
                        </span>
                    }
                </Template>
            </GridColumn>
        </Columns>

        <ActionColumn Context="stock">
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" title="Edit Stock" @onclick="@(() => OpenEditModal(stock))">
                    <i class="ti ti-edit"></i>
                </button>
                <button class="btn btn-outline-danger" title="Soft Delete Stock" @onclick="@(() => OpenDeleteModal(stock))">
                    <i class="ti ti-trash"></i>
                </button>
            </div>
        </ActionColumn>

        <EmptyTemplate>
            <div class="text-center py-5">
                <div class="stat-icon-wrapper bg-light text-muted mx-auto mb-3" style="width: 54px; height: 54px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="ti ti-search-off"></i>
                </div>
                <h5 class="fw-bold mb-1">No matching stocks found</h5>
                <p class="text-muted small mb-0">Try refining your search query or reset the filters to view all securities.</p>
            </div>
        </EmptyTemplate>
    </AdminDataGrid>
</div>

<!-- Stock Create / Edit Modal -->
<StockEditModal IsOpen="@_isEditModalOpen"
                OriginalStock="@_selectedStock"
                OnSave="HandleSaveStockAsync"
                OnClose="CloseEditModal" />

<!-- Stock Soft Delete Confirmation Modal -->
<DeleteStockModal IsOpen="@_isDeleteModalOpen"
                  Stock="@_selectedStock"
                  OnConfirm="HandleDeleteStockAsync"
                  OnClose="CloseDeleteModal" />

@code {
    private List<Stock> _stocks = [];
    private List<Market> _filterMarkets = [];
    private List<Sector> _filterSectors = [];

    private int _totalCount;
    private int _activeCount;
    private int _shariahCount;
    private int _pageSize = 20;
    private int _currentPage = 1;
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _sortColumn = "StockCode";
    private SortDirection _sortDirection = SortDirection.Ascending;

    // Filters
    private int _filterMarketId = 0;
    private int _filterSectorId = 0;
    private string _filterShariah = string.Empty;
    private string _filterActive = string.Empty;

    // Modals
    private bool _isEditModalOpen = false;
    private bool _isDeleteModalOpen = false;
    private Stock? _selectedStock;

    // Feedback
    private string? _statusMessage;
    private string _statusMessageClass = "success";

    private bool HasActiveFilters => _filterMarketId > 0 || _filterSectorId > 0 || !string.IsNullOrEmpty(_filterShariah) || !string.IsNullOrEmpty(_filterActive);

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
        await LoadSummaryCounts();
        await LoadData();
    }

    private async Task LoadFilterOptions()
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            _filterMarkets = await db.Markets.AsNoTracking().Where(m => !m.IsDeleted).OrderBy(m => m.MarketCode).ToListAsync();
            _filterSectors = await db.Sectors.AsNoTracking().Where(s => !s.IsDeleted).OrderBy(s => s.SectorName_EN).ToListAsync();
        }
        catch
        {
            // Ignore if reference lists fail to load initially
        }
    }

    private async Task LoadSummaryCounts()
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            _activeCount = await db.Stocks.CountAsync(s => s.IsActive && !s.IsDeleted);
            _shariahCount = await db.Stocks.CountAsync(s => s.ShariahCompliant && !s.IsDeleted);
        }
        catch
        {
            // Ignore if metrics calculation fails
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var query = db.Stocks
                .AsNoTracking()
                .Include(s => s.Market)
                .Include(s => s.Sector)
                .AsQueryable();

            // Search Filter
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                query = query.Where(s =>
                    s.StockCode.ToLower().Contains(term) ||
                    s.ShortName_EN.ToLower().Contains(term) ||
                    (s.RicCode != null && s.RicCode.ToLower().Contains(term)) ||
                    (s.LegalName_EN != null && s.LegalName_EN.ToLower().Contains(term)) ||
                    (s.YahooSymbol != null && s.YahooSymbol.ToLower().Contains(term)));
            }

            // Dropdown Filters
            if (_filterMarketId > 0)
            {
                query = query.Where(s => s.MarketId == _filterMarketId);
            }

            if (_filterSectorId > 0)
            {
                query = query.Where(s => s.SectorId == _filterSectorId);
            }

            if (_filterShariah == "yes")
            {
                query = query.Where(s => s.ShariahCompliant);
            }
            else if (_filterShariah == "no")
            {
                query = query.Where(s => !s.ShariahCompliant);
            }

            if (_filterActive == "active")
            {
                query = query.Where(s => s.IsActive);
            }
            else if (_filterActive == "inactive")
            {
                query = query.Where(s => !s.IsActive);
            }

            _totalCount = await query.CountAsync();

            // Sorting
            query = (_sortColumn, _sortDirection) switch
            {
                ("StockCode", SortDirection.Ascending) => query.OrderBy(s => s.StockCode),
                ("StockCode", SortDirection.Descending) => query.OrderByDescending(s => s.StockCode),
                ("ShortName_EN", SortDirection.Ascending) => query.OrderBy(s => s.ShortName_EN),
                ("ShortName_EN", SortDirection.Descending) => query.OrderByDescending(s => s.ShortName_EN),
                ("Market", SortDirection.Ascending) => query.OrderBy(s => s.Market.MarketCode),
                ("Market", SortDirection.Descending) => query.OrderByDescending(s => s.Market.MarketCode),
                ("Sector", SortDirection.Ascending) => query.OrderBy(s => s.Sector != null ? s.Sector.SectorName_EN : string.Empty),
                ("Sector", SortDirection.Descending) => query.OrderByDescending(s => s.Sector != null ? s.Sector.SectorName_EN : string.Empty),
                ("CurrentPrice", SortDirection.Ascending) => query.OrderBy(s => s.CurrentPrice),
                ("CurrentPrice", SortDirection.Descending) => query.OrderByDescending(s => s.CurrentPrice),
                ("ShariahCompliant", SortDirection.Ascending) => query.OrderBy(s => s.ShariahCompliant),
                ("ShariahCompliant", SortDirection.Descending) => query.OrderByDescending(s => s.ShariahCompliant),
                ("IsActive", SortDirection.Ascending) => query.OrderBy(s => s.IsActive),
                ("IsActive", SortDirection.Descending) => query.OrderByDescending(s => s.IsActive),
                _ => query.OrderBy(s => s.StockCode)
            };

            // Paging
            _stocks = await query
                .Skip((_currentPage - 1) * _pageSize)
                .Take(_pageSize)
                .ToListAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadSummaryCounts();
        await LoadData();
    }

    private async Task HandleSearchChanged(string term)
    {
        _searchTerm = term;
        _currentPage = 1;
        await LoadData();
    }

    private async Task HandleSortChanged(SortChangedArgs args)
    {
        _sortColumn = string.IsNullOrEmpty(args.ColumnKey) ? "StockCode" : args.ColumnKey;
        _sortDirection = args.Direction;
        _currentPage = 1;
        await LoadData();
    }

    private async Task HandlePageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _currentPage = 1;
        await LoadData();
    }

    private async Task HandleMarketFilterChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var marketId))
        {
            _filterMarketId = marketId;
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task HandleSectorFilterChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sectorId))
        {
            _filterSectorId = sectorId;
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task HandleShariahFilterChange(ChangeEventArgs e)
    {
        _filterShariah = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
        await LoadData();
    }

    private async Task HandleActiveFilterChange(ChangeEventArgs e)
    {
        _filterActive = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _filterMarketId = 0;
        _filterSectorId = 0;
        _filterShariah = string.Empty;
        _filterActive = string.Empty;
        _currentPage = 1;
        await LoadData();
    }

    private void OpenAddModal()
    {
        _selectedStock = new Stock
        {
            StockCode = string.Empty,
            ShortName_EN = string.Empty,
            Currency = "MYR",
            IsActive = true,
            ShariahCompliant = false
        };
        _isEditModalOpen = true;
    }

    private async Task OpenEditModal(Stock stock)
    {
        // Load fresh untracked copy with all relations via a dedicated context
        await using var db = await DbContextFactory.CreateDbContextAsync();
        _selectedStock = await db.Stocks
            .AsNoTracking()
            .Include(s => s.Market)
            .Include(s => s.Sector)
            .Include(s => s.SubSector)
            .FirstOrDefaultAsync(s => s.Id == stock.Id);

        _isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        _isEditModalOpen = false;
        _selectedStock = null;
    }

    private void OpenDeleteModal(Stock stock)
    {
        _selectedStock = stock;
        _isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        _isDeleteModalOpen = false;
        _selectedStock = null;
    }

    private async Task HandleSaveStockAsync(StockEditModal.StockFormModel model)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        var cleanCode = model.StockCode.Trim();

        await using var db = await DbContextFactory.CreateDbContextAsync();

        // Check for duplicate stock code
        var duplicateExists = await db.Stocks
            .AnyAsync(s => s.StockCode.ToLower() == cleanCode.ToLower() && s.Id != model.Id);

        if (duplicateExists)
        {
            throw new InvalidOperationException($"A security with code '{cleanCode}' already exists in the master database.");
        }

        if (model.Id == 0)
        {
            // Create
            var newStock = new Stock
            {
                StockCode = cleanCode,
                ShortName_EN = model.ShortName_EN.Trim(),
                ShortName_ZH_TW = model.ShortName_ZH_TW?.Trim(),
                ShortName_ZH_CN = model.ShortName_ZH_CN?.Trim(),
                LegalName_EN = model.LegalName_EN?.Trim(),
                LegalName_ZH_TW = model.LegalName_ZH_TW?.Trim(),
                LegalName_ZH_CN = model.LegalName_ZH_CN?.Trim(),
                RicCode = model.RicCode?.Trim(),
                YahooSymbol = model.YahooSymbol?.Trim(),
                IsinCode = model.IsinCode?.Trim(),
                MarketId = model.MarketId,
                SectorId = model.SectorId > 0 ? model.SectorId : null,
                SubSectorId = model.SubSectorId > 0 ? model.SubSectorId : null,
                ShariahCompliant = model.ShariahCompliant,
                Currency = model.Currency.Trim(),
                IsActive = model.IsActive,
                CreatedAt = DateTimeOffset.UtcNow,
                CreatedByUserId = currentUserId,
                IsDeleted = false
            };

            db.Stocks.Add(newStock);
            await db.SaveChangesAsync();

            _statusMessage = $"Successfully created new security: {newStock.StockCode} - {newStock.ShortName_EN}.";
            _statusMessageClass = "success";
        }
        else
        {
            // Update
            var stockToUpdate = await db.Stocks.FindAsync(model.Id);
            if (stockToUpdate == null)
            {
                throw new InvalidOperationException("The security you are trying to edit could not be found.");
            }

            stockToUpdate.StockCode = cleanCode;
            stockToUpdate.ShortName_EN = model.ShortName_EN.Trim();
            stockToUpdate.ShortName_ZH_TW = model.ShortName_ZH_TW?.Trim();
            stockToUpdate.ShortName_ZH_CN = model.ShortName_ZH_CN?.Trim();
            stockToUpdate.LegalName_EN = model.LegalName_EN?.Trim();
            stockToUpdate.LegalName_ZH_TW = model.LegalName_ZH_TW?.Trim();
            stockToUpdate.LegalName_ZH_CN = model.LegalName_ZH_CN?.Trim();
            stockToUpdate.RicCode = model.RicCode?.Trim();
            stockToUpdate.YahooSymbol = model.YahooSymbol?.Trim();
            stockToUpdate.IsinCode = model.IsinCode?.Trim();
            stockToUpdate.MarketId = model.MarketId;
            stockToUpdate.SectorId = model.SectorId > 0 ? model.SectorId : null;
            stockToUpdate.SubSectorId = model.SubSectorId > 0 ? model.SubSectorId : null;
            stockToUpdate.ShariahCompliant = model.ShariahCompliant;
            stockToUpdate.Currency = model.Currency.Trim();
            stockToUpdate.IsActive = model.IsActive;
            stockToUpdate.ModifiedAt = DateTimeOffset.UtcNow;
            stockToUpdate.ModifiedByUserId = currentUserId;

            await db.SaveChangesAsync();

            _statusMessage = $"Successfully updated security: {stockToUpdate.StockCode} - {stockToUpdate.ShortName_EN}.";
            _statusMessageClass = "success";
        }

        CloseEditModal();
        await LoadSummaryCounts();
        await LoadData();
    }

    private async Task HandleDeleteStockAsync(Stock stock)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var entity = await db.Stocks.FindAsync(stock.Id);
        if (entity != null)
        {
            entity.IsDeleted = true;
            entity.DeletedAt = DateTimeOffset.UtcNow;
            entity.DeletedByUserId = currentUserId;
            entity.IsActive = false;

            await db.SaveChangesAsync();

            _statusMessage = $"Security '{stock.StockCode} - {stock.ShortName_EN}' has been soft-deleted.";
            _statusMessageClass = "warning";
        }

        CloseDeleteModal();
        await LoadSummaryCounts();
        await LoadData();
    }

    private async Task ToggleActiveStatus(Stock stock)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var entity = await db.Stocks.FindAsync(stock.Id);
        if (entity != null)
        {
            entity.IsActive = !entity.IsActive;
            entity.ModifiedAt = DateTimeOffset.UtcNow;
            entity.ModifiedByUserId = currentUserId;

            await db.SaveChangesAsync();

            _statusMessage = $"Listing status for '{stock.StockCode}' changed to {(entity.IsActive ? "Active" : "Inactive")}.";
            _statusMessageClass = "info";

            await LoadSummaryCounts();
            await LoadData();
        }
    }
}
