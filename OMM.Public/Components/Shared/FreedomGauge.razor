@namespace OMM.Public.Components.Shared
@using OMM.Public.Services

<div class="omm-card freedom-gauge-card p-4 h-100 d-flex flex-column position-relative overflow-hidden">
    <div class="freedom-gauge-header">
        <div class="freedom-gauge-heading">
            <h3 class="freedom-gauge-title font-display">Freedom score</h3>
            <p class="freedom-gauge-description">Passive income / recurring expenses</p>
        </div>
        <div class="freedom-gauge-status @StageStatusClass" aria-live="polite" title="Passive income coverage stage">
            <span class="freedom-gauge-status-dot"></span>
            <span>Current stage: @StageName</span>
        </div>
    </div>

    <!-- SVG Gauge Visual -->
    <div class="freedom-gauge-container">
        <svg class="freedom-gauge-svg" viewBox="0 0 260 145" preserveAspectRatio="xMidYMid meet">
            <defs>
                <!-- Gradient for active gauge arc -->
                <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#c5843a" />
                    <stop offset="40%" stop-color="#f59e0b" />
                    <stop offset="80%" stop-color="#10b981" />
                    <stop offset="100%" stop-color="#059669" />
                </linearGradient>

                <!-- Soft glow filter -->
                <filter id="gaugeGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
            </defs>

            <!-- Background Track -->
            <path class="gauge-track"
                  d="M 30 135 A 100 100 0 0 1 230 135"
                  fill="none"
                  stroke-width="18" />

            <!-- Milestone tick markers at 25%, 50%, 75% -->
            <!-- 25% tick (approx 45 deg from left): x=59, y=64 -->
            <circle cx="59" cy="64" r="2.5" fill="#9ca3af" opacity="0.6" />
            <!-- 50% tick (top center): x=130, y=35 -->
            <circle cx="130" cy="35" r="2.5" fill="#9ca3af" opacity="0.6" />
            <!-- 75% tick (approx 45 deg from right): x=201, y=64 -->
            <circle cx="201" cy="64" r="2.5" fill="#9ca3af" opacity="0.6" />

            <!-- Animated Filled Arc -->
            <path class="gauge-fill"
                  d="M 30 135 A 100 100 0 0 1 230 135"
                  fill="none"
                  stroke="url(#gaugeGradient)"
                  stroke-width="18"
                  filter="url(#gaugeGlow)"
                  stroke-dasharray="314.16"
                  stroke-dashoffset="@DashOffset" />

            <!-- Center readout inside arc -->
            <text x="130" y="110" text-anchor="middle" class="freedom-gauge-value font-display fw-bold metric-card-value">
                @(HasTarget ? $"{ClampedPercentage:F0}%" : "—")
            </text>
            <text x="130" y="130" text-anchor="middle" class="freedom-gauge-caption">
                OF LIVING EXPENSES
            </text>
        </svg>
    </div>

    <!-- Milestone Roadmap Stages -->
    <div class="mt-2 pt-2 border-top border-light-subtle">
        <div class="freedom-gauge-summary d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Current: <strong class="text-dark metric-card-value">@FormatHelper.FormatCurrency(PassiveMonthly)/mo</strong></span>
            <span class="text-muted">Target: <strong class="text-dark metric-card-value">@FormatHelper.FormatCurrency(RecurringMonthly)/mo</strong></span>
        </div>

        <!-- 4-step Milestone Breadcrumb -->
        <div class="freedom-stage-scale">
                <div class="freedom-stage-step freedom-stage-step-1 @(ClampedPercentage >= 0 ? "is-reached" : "")" aria-label="0 to 25 percent covered: starting coverage">
                    <strong>0~25%</strong>
                    <span>Starting</span>
                </div>
            <div class="freedom-stage-step freedom-stage-step-2 @(ClampedPercentage >= 25 ? "is-reached" : "")" aria-label="25 to 50 percent covered: building runway">
                    <strong>25~50%</strong>
                    <span>Runway</span>
                </div>
            <div class="freedom-stage-step freedom-stage-step-3 @(ClampedPercentage >= 50 ? "is-reached" : "")" aria-label="50 to 75 percent covered: coast FIRE">
                    <strong>50~75%</strong>
                    <span>Coast FIRE</span>
                </div>
            <div class="freedom-stage-step freedom-stage-step-4 @(ClampedPercentage >= 75 ? "is-reached" : "")" aria-label="75 to 100 percent covered: nearly covered">
                    <strong>75~100%</strong>
                    <span>Nearly covered</span>
                </div>
        </div>

        @if (!string.IsNullOrEmpty(NextTierMessage))
        {
            <div class="freedom-gauge-next text-center text-muted mt-2 small">
                <i class="ti ti-sparkles text-warning me-1"></i>
                @NextTierMessage
            </div>
        }
        else if (!HasTarget)
        {
            <div class="text-center mt-2">
                <a href="/expenses" class="btn btn-sm btn-outline-dark rounded-3 px-3">
                    <i class="ti ti-target-arrow me-1"></i>Set monthly target
                </a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public decimal Percentage { get; set; } = 0;
    [Parameter] public decimal PassiveMonthly { get; set; } = 0;
    [Parameter] public decimal RecurringMonthly { get; set; } = 0;

    private decimal ClampedPercentage => Math.Min(150, Math.Max(0, Percentage));

    // Semi-circle perimeter for radius 100 = pi * 100 = 314.16
    private double DashOffset
    {
        get
        {
            var p = (double)Math.Min(100, Math.Max(0, ClampedPercentage));
            return 314.16 * (1.0 - (p / 100.0));
        }
    }

    private bool HasTarget => RecurringMonthly > 0;

    private string StageName => !HasTarget ? "No target set" : Percentage switch
    {
        < 25 => "Starting",
        < 50 => "Runway",
        < 75 => "Coast FIRE",
        < 100 => "Nearly covered",
        _ => "Fully covered"
    };

    private string StageStatusClass => ClampedPercentage switch
    {
        < 25 => "freedom-stage-status-1",
        < 50 => "freedom-stage-status-2",
        < 75 => "freedom-stage-status-3",
        < 100 => "freedom-stage-status-4",
        _ => "freedom-stage-status-complete"
    };

    private string NextTierMessage
    {
        get
        {
            if (RecurringMonthly <= 0) return string.Empty;

            if (Percentage < 25)
            {
                var target = RecurringMonthly * 0.25m;
                var gap = Math.Max(0, target - PassiveMonthly);
                return $"Add {FormatHelper.FormatCurrency(gap)}/mo passive to cover 25% of recurring expenses";
            }
            if (Percentage < 50)
            {
                var target = RecurringMonthly * 0.50m;
                var gap = Math.Max(0, target - PassiveMonthly);
                return $"Add {FormatHelper.FormatCurrency(gap)}/mo passive to cover 50% of recurring expenses";
            }
            if (Percentage < 100)
            {
                var gap = Math.Max(0, RecurringMonthly - PassiveMonthly);
                return $"{FormatHelper.FormatCurrency(gap)}/mo more to cover all recurring expenses";
            }
            return "Congratulations! Your mines completely fund your recurring living expenses.";
        }
    }
}
