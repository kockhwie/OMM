@page "/admin/users"

<PageTitle>User Management - OMM Admin</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">User Management</h1>
            <p class="text-muted mb-0">Administrative accounts, roles, permission assignments, and audit logs.</p>
        </div>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
            <i class="ti ti-shield-lock me-1"></i> SuperAdmin Restricted
        </span>
    </div>

    <div class="omm-card p-5 text-center">
        <div class="stat-icon-wrapper bg-danger-subtle text-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem; border-radius: 16px;">
            <i class="ti ti-users"></i>
        </div>
        <h2 class="h4 fw-bold mb-2">Administrative User Management</h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
            Admin account invitation, role management (SuperAdmin vs Admin), temporary passwords, and account security controls will be available in Phase 7.
        </p>
        <div>
            <a href="admin" class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
