@page "/burdens"
@layout DashboardLayout
@attribute [Authorize]
@inject IMineService MineService
@inject NavigationManager Navigation

<PageTitle>Burdens - OhMyMine</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 animate-fade-up">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">Burdens</h1>
        <p class="text-muted small mb-0">
            @allBurdens.Count active burdens weighing on your cash flow and net worth
        </p>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="OpenAddModal">
        <i class="ti ti-plus fs-5"></i>
        <span>Add Burden</span>
    </button>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4 animate-fade-up">
    <!-- Total Balance -->
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted mb-2">
                <div class="rounded-circle bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="ti ti-weight fs-5"></i>
                </div>
                <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Burden Balance</span>
            </div>
            <div class="fs-3 fw-bold text-dark font-display">
                @FormatHelper.FormatCurrency(TotalBalance)
            </div>
            <small class="text-muted mt-1 d-block">
                Down from @FormatHelper.FormatCurrency(TotalOriginal) original principal
            </small>
        </div>
    </div>

    <!-- Monthly Debt Service -->
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted mb-2">
                <div class="rounded-circle bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="ti ti-calendar-dollar fs-5"></i>
                </div>
                <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Monthly Debt Service</span>
            </div>
            <div class="fs-3 fw-bold text-dark font-display">
                @FormatHelper.FormatCurrency(TotalMonthlyPayment)
            </div>
            <small class="text-muted mt-1 d-block">
                Required monthly repayments across all loans
            </small>
        </div>
    </div>

    <!-- Overall Debt Amortization Progress -->
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center justify-content-between text-muted mb-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="ti ti-shield-check fs-5"></i>
                    </div>
                    <span class="text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Paid Off</span>
                </div>
                <span class="fs-4 fw-bold text-success font-display">@OverallProgress%</span>
            </div>
            <ProgressBar Value="@OverallProgress" Height="8px" ColorClass="bg-success" />
            <small class="text-muted mt-2 d-block">
                @FormatHelper.FormatCurrency(TotalOriginal - TotalBalance) repaid to date
            </small>
        </div>
    </div>
</div>

<!-- Type Filter Buttons -->
<div class="d-flex flex-wrap gap-1 align-items-center mb-4 animate-fade-up">
    <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(selectedType == null ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
            @onclick="() => selectedType = null">
        All
    </button>
    @foreach (var typ in Enum.GetValues<BurdenType>())
    {
        var isSelected = selectedType == typ;
        <button class="btn btn-sm rounded-3 fw-medium px-3 py-2 @(isSelected ? "btn-dark text-white" : "btn-outline-secondary bg-white text-dark border-light-subtle")"
                @onclick="() => selectedType = typ">
            @FormatHelper.BurdenTypeLabel(typ)
        </button>
    }
</div>

<!-- Burden Cards Grid -->
@if (FilteredBurdens.Count > 0)
{
    <div class="row g-3">
        @foreach (var burden in FilteredBurdens)
        {
            var linkedMine = allMines.FirstOrDefault(m => m.Id.Equals(burden.LinkedMineId, StringComparison.OrdinalIgnoreCase));
            var progress = burden.OriginalAmount > 0
                ? Math.Clamp((int)Math.Round(((burden.OriginalAmount - burden.Balance) / burden.OriginalAmount) * 100m), 0, 100)
                : 0;
            var isHighInterest = burden.InterestRate >= 10m;

            <div class="col-12 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover position-relative">
                    
                    <!-- Header -->
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center p-2"
                                 style="width: 44px; height: 44px;">
                                <i class="ti @FormatHelper.BurdenTypeToIcon(burden.Type) fs-4"></i>
                            </div>
                            <div>
                                <h3 class="h6 fw-bold mb-0 text-dark font-display">@burden.Name</h3>
                                <span class="badge bg-light text-dark border mt-1">@FormatHelper.BurdenTypeLabel(burden.Type)</span>
                            </div>
                        </div>
                        
                        @if (isHighInterest)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                                <i class="ti ti-alert-triangle fs-6"></i> High Interest
                            </span>
                        }
                    </div>

                    <!-- Metrics Grid -->
                    <div class="row g-2 mb-3 text-center text-sm-start">
                        <div class="col-4">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Balance</span>
                            <div class="fw-bold text-dark fs-6">
                                @FormatHelper.FormatCurrency(burden.Balance)
                            </div>
                        </div>
                        <div class="col-4">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Monthly</span>
                            <div class="fw-bold text-dark fs-6">
                                @FormatHelper.FormatCurrency(burden.MonthlyPayment)
                            </div>
                        </div>
                        <div class="col-4">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Interest</span>
                            <div class="fw-bold @(isHighInterest ? "text-danger" : "text-dark") fs-6">
                                @burden.InterestRate% p.a.
                            </div>
                        </div>
                    </div>

                    <!-- Amortization Progress Bar -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Paid off</span>
                            <span class="fw-semibold text-dark">@progress%</span>
                        </div>
                        <ProgressBar Value="@progress" Height="6px" ColorClass="bg-danger" />
                    </div>

                    <!-- Linked Mine Footer -->
                    <div class="pt-3 border-top border-light-subtle d-flex align-items-center justify-content-between">
                        @if (linkedMine != null)
                        {
                            <a href="/mines/@linkedMine.Id" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 hover-underline">
                                <i class="ti ti-link fs-6 text-primary"></i>
                                <span>Linked to <strong>@linkedMine.Name</strong></span>
                                <i class="ti ti-chevron-right fs-6"></i>
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">Standalone Burden</span>
                        }

                        <button class="btn btn-link text-danger p-0 text-decoration-none small" @onclick="() => DeleteBurden(burden.Id)">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 my-4">
        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="ti ti-check fs-2 text-success"></i>
        </div>
        <h3 class="h5 fw-bold text-dark mb-1">No burdens in this category</h3>
        <p class="text-muted small mb-0">You're clear of liabilities matching this filter.</p>
    </div>
}

<!-- Add Burden Modal -->
@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-weight text-danger fs-4"></i>
                        <h5 class="modal-title fw-bold font-display mb-0">Add New Burden</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Burden Name *</label>
                            <input type="text" class="form-control rounded-3" placeholder="e.g. Condo Mortgage, PTPTN Loan" @bind="newBurden.Name" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Burden Type *</label>
                            <select class="form-select rounded-3" @bind="newBurden.Type">
                                @foreach (var typ in Enum.GetValues<BurdenType>())
                                {
                                    <option value="@typ">@FormatHelper.BurdenTypeLabel(typ)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Remaining Principal Balance (RM) *</label>
                            <input type="number" class="form-control rounded-3" step="100" @bind="newBurden.Balance" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Original Principal Amount (RM) *</label>
                            <input type="number" class="form-control rounded-3" step="100" @bind="newBurden.OriginalAmount" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Interest Rate (% p.a.) *</label>
                            <input type="number" class="form-control rounded-3" step="0.1" @bind="newBurden.InterestRate" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Monthly Repayment (RM) *</label>
                            <input type="number" class="form-control rounded-3" step="50" @bind="newBurden.MonthlyPayment" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Linked Collateral / Mine (Optional)</label>
                            <select class="form-select rounded-3" @bind="newBurden.LinkedMineId">
                                <option value="">— No linked mine (Standalone loan) —</option>
                                @foreach (var mine in allMines)
                                {
                                    <option value="@mine.Id">@mine.Name (@FormatHelper.CategoryLabel(mine.Category))</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" @onclick="CloseAddModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" @onclick="SaveBurden">Save Burden</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Burden> allBurdens = [];
    private List<Mine> allMines = [];
    private BurdenType? selectedType;
    private bool showAddModal = false;
    private Burden newBurden = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        allBurdens = await MineService.GetBurdensAsync();
        allMines = await MineService.GetMinesAsync();
    }

    private List<Burden> FilteredBurdens => allBurdens
        .Where(b => selectedType == null || b.Type == selectedType.Value)
        .ToList();

    private decimal TotalBalance => allBurdens.Sum(b => b.Balance);
    private decimal TotalOriginal => allBurdens.Sum(b => b.OriginalAmount);
    private decimal TotalMonthlyPayment => allBurdens.Sum(b => b.MonthlyPayment);
    private int OverallProgress => TotalOriginal > 0 ? (int)Math.Round(((TotalOriginal - TotalBalance) / TotalOriginal) * 100m) : 0;

    private void OpenAddModal()
    {
        newBurden = new Burden
        {
            Type = BurdenType.PersonalLoan,
            Currency = "MYR",
            InterestRate = 4.5m
        };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task SaveBurden()
    {
        if (string.IsNullOrWhiteSpace(newBurden.Name))
            return;

        if (newBurden.OriginalAmount <= 0)
            newBurden.OriginalAmount = newBurden.Balance;

        await MineService.AddBurdenAsync(newBurden);
        showAddModal = false;
        await LoadData();
    }

    private async Task DeleteBurden(string id)
    {
        await MineService.DeleteBurdenAsync(id);
        await LoadData();
    }
}
